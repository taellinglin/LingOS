// lsh -- LingOS's default shell. `use`-shared into both the Live
// (kernel/x86_64/main.ling) and Installer (kernel/x86_64-installer/main.ling)
// kernel targets, which each keep their own boot-specific prelude (banner,
// mount, first-run wizard) and just call `run_shell()` once they're ready
// to hand off to an interactive prompt.
//
// sudo here is a *shell-level* gate (wheel-group membership + a fresh
// password re-entry before useradd/passwd/groupmod/pkginstall), not a
// kernel security boundary -- this kernel has no ring-3/per-process
// isolation at all, so any code already running could call any
// `ling_kernel_*` intrinsic directly regardless of this check. It stops an
// operator from running a sensitive command by accident; it does not
// defend against malicious code. See `fs/users.rs`'s module doc in
// ling-kernel for the same disclosure at the intrinsic layer.

fn is_wheel() -> u64 {
    return ling_kernel_user_is_wheel()
}

fn print_help() {
    ling_kernel_vga_write_str("Available commands:\n")
    ling_kernel_vga_write_str("  help                    clear                   ls\n")
    ling_kernel_vga_write_str("  cat <name>              write <name> <text>     hostname\n")
    ling_kernel_vga_write_str("  cd <dir>                pwd                     echo <text>\n")
    ling_kernel_vga_write_str("  whoami                  groups                  about\n")
    ling_kernel_vga_write_str("  login                   su <user>               passwd\n")
    ling_kernel_vga_write_str("  useradd*                groupmod <user> <grp>*  pkginstall <blob>*\n")
    ling_kernel_vga_write_str("  lingfu list|search|install*                    sudo <cmd...>\n")
    ling_kernel_vga_write_str("  selftest proctest ps    theme dark|light         nettest\n")
    ling_kernel_vga_write_str("  ling-life               play (tape player: space/s/q)\n")
    ling_kernel_vga_write_str("  curl <url> [file]       bring <url> (browser in ling; --out saves)\n")
    ling_kernel_vga_write_str("  (* needs the wheel group -- run directly if you're in it, or via sudo)\n")
}

// The full command dispatch, shared between the main loop and `sudo`'s
// re-authenticated delegation -- both end up here so a command behaves
// identically either way once the (identical) wheel check passes.
fn run_command(cmd, arg) {
    if cmd == "help" {
        print_help()
    } else if cmd == "clear" {
        ling_kernel_vga_clear()
    } else if cmd == "ls" {
        ling_kernel_fs_ls(arg)
    } else if cmd == "cat" {
        bind content = ling_kernel_fs_read(arg)
        ling_kernel_print_lstr(content)
        ling_kernel_vga_write_str("\n")
    } else if cmd == "write" {
        bind wname = ling_kernel_str_cmd(arg)
        bind wcontent = ling_kernel_str_arg(arg)
        ling_kernel_fs_write(wname, wcontent)
        ling_kernel_vga_write_str("ok\n")
    } else if cmd == "hostname" {
        bind hn2 = ling_kernel_fs_read("/hostname")
        if len(hn2) == 0 {
            ling_kernel_vga_write_str("lingos\n")
        } else {
            ling_kernel_print_lstr(hn2)
            ling_kernel_vga_write_str("\n")
        }
    } else if cmd == "cd" {
        bind cd_ok = ling_kernel_cd(arg)
        if cd_ok == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("cd: no such directory\n")
            ling_kernel_vga_set_color(7, 0)
        }
    } else if cmd == "pwd" {
        ling_kernel_vga_write_str("/")
        bind cwd2 = ling_kernel_cwd()
        ling_kernel_print_lstr(cwd2)
        ling_kernel_vga_write_str("\n")
    } else if cmd == "echo" {
        ling_kernel_print_lstr(arg)
        ling_kernel_vga_write_str("\n")
    } else if cmd == "whoami" {
        bind who2 = ling_kernel_whoami()
        ling_kernel_print_lstr(who2)
        ling_kernel_vga_write_str("\n")
    } else if cmd == "groups" {
        bind grp = ling_kernel_user_group()
        if len(grp) == 0 {
            ling_kernel_vga_write_str("(none)\n")
        } else {
            ling_kernel_print_lstr(grp)
            ling_kernel_vga_write_str("\n")
        }
    } else if cmd == "useradd" {
        if is_wheel() == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("useradd: permission denied (needs the wheel group -- try 'sudo useradd')\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_write_str("Username: ")
            bind u_username = ling_kernel_read_line()
            ling_kernel_vga_write_str("Password: ")
            bind u_password = ling_kernel_read_line_masked()
            ling_kernel_vga_write_str("First name: ")
            bind u_first = ling_kernel_read_line()
            ling_kernel_vga_write_str("Last name: ")
            bind u_last = ling_kernel_read_line()
            ling_kernel_vga_write_str("Phone: ")
            bind u_phone = ling_kernel_read_line()
            ling_kernel_vga_write_str("Email: ")
            bind u_email = ling_kernel_read_line()
            ling_kernel_vga_write_str("Group [users]: ")
            bind u_group = ling_kernel_read_line()
            bind u_ok = ling_kernel_user_create(u_username, u_password, u_first, u_last, u_phone, u_email, u_group)
            if u_ok == 1 {
                ling_kernel_vga_set_color(10, 0)
                ling_kernel_vga_write_str("user created\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("useradd failed\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "login" {
        ling_kernel_vga_write_str("Username: ")
        bind l_username = ling_kernel_read_line()
        ling_kernel_vga_write_str("Password: ")
        bind l_password = ling_kernel_read_line_masked()
        bind l_ok = ling_kernel_user_login(l_username, l_password)
        if l_ok == 1 {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("login ok\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("login failed\n")
            ling_kernel_vga_set_color(7, 0)
        }
    } else if cmd == "su" {
        if len(arg) == 0 {
            ling_kernel_vga_write_str("usage: su <user>\n")
        } else {
            ling_kernel_vga_write_str("Password: ")
            bind s_password = ling_kernel_read_line_masked()
            bind s_ok = ling_kernel_user_login(arg, s_password)
            if s_ok == 1 {
                ling_kernel_vga_set_color(10, 0)
                ling_kernel_vga_write_str("switched user\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("su: authentication failed\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "passwd" {
        ling_kernel_vga_write_str("Username: ")
        bind p_username = ling_kernel_read_line()
        ling_kernel_vga_write_str("New password: ")
        bind p_password = ling_kernel_read_line_masked()
        bind p_ok = ling_kernel_user_set_password(p_username, p_password)
        if p_ok == 1 {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("password changed\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("passwd failed (no such user?)\n")
            ling_kernel_vga_set_color(7, 0)
        }
    } else if cmd == "groupmod" {
        if is_wheel() == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("groupmod: permission denied (needs the wheel group -- try 'sudo groupmod ...')\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            bind gm_username = ling_kernel_str_cmd(arg)
            bind gm_group = ling_kernel_str_arg(arg)
            bind gm_ok = ling_kernel_user_set_group(gm_username, gm_group)
            if gm_ok == 1 {
                ling_kernel_vga_set_color(10, 0)
                ling_kernel_vga_write_str("group changed\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("groupmod failed (no such user?)\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "pkginstall" {
        if is_wheel() == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("pkginstall: permission denied (needs the wheel group -- try 'sudo pkginstall ...')\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            bind pkg_ok = ling_kernel_pkg_install(arg)
            if pkg_ok == 1 {
                ling_kernel_vga_set_color(10, 0)
                ling_kernel_vga_write_str("installed (see: ls packages)\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("pkginstall failed (bad/missing .lpkg blob)\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "lingfu" {
        bind lf_cmd = ling_kernel_str_cmd(arg)
        bind lf_arg = ling_kernel_str_arg(arg)
        // The network registry client is REAL now (drivers::{netstack,
        // lingfu}: genuine TCP/HTTP over the fixed e1000): `sync` pulls
        // /catalog.txt from the repo (lingfs /repo, default 10.0.2.2:8000
        // -- QEMU's host alias), `search` greps the synced catalog,
        // `install <name>` downloads the .lpkg and unpacks it. `install`
        // falls back to the old local-blob path when the name matches
        // nothing in the catalog, so media-shipped packages still work.
        if lf_cmd == "sync" {
            bind n = ling_kernel_lingfu_sync()
            if n > 0 {
                ling_kernel_lingfu_query("")
            }
        } else if lf_cmd == "list" {
            ling_kernel_vga_write_str("installed:\n")
            ling_kernel_fs_ls("packages")
            ling_kernel_vga_write_str("catalog (lingfu sync to refresh):\n")
            ling_kernel_lingfu_query("")
        } else if lf_cmd == "search" {
            ling_kernel_lingfu_query(lf_arg)
        } else if lf_cmd == "install" {
            if len(lf_arg) == 0 {
                ling_kernel_vga_write_str("usage: lingfu install <name-or-blob>\n")
            } else if is_wheel() == 0 {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("lingfu install: permission denied (needs the wheel group -- try 'sudo lingfu install ...')\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                bind net_ok = ling_kernel_lingfu_fetch_install(lf_arg)
                if net_ok == 1 {
                    ling_kernel_vga_set_color(10, 0)
                    ling_kernel_vga_write_str("installed from the network repo (see: lingfu list)\n")
                    ling_kernel_vga_set_color(7, 0)
                } else {
                    bind lf_ok = ling_kernel_pkg_install(lf_arg)
                    if lf_ok == 1 {
                        ling_kernel_vga_set_color(10, 0)
                        ling_kernel_vga_write_str("installed from a local blob (see: lingfu list)\n")
                        ling_kernel_vga_set_color(7, 0)
                    } else {
                        ling_kernel_vga_set_color(12, 0)
                        ling_kernel_vga_write_str("lingfu install failed (not in the catalog, and no such local blob)\n")
                        ling_kernel_vga_set_color(7, 0)
                    }
                }
            }
        } else {
            ling_kernel_vga_write_str("usage: lingfu sync | list | search <term> | install <name>\n")
        }
    } else if cmd == "sudo" {
        bind sub_cmd = ling_kernel_str_cmd(arg)
        bind sub_arg = ling_kernel_str_arg(arg)
        if len(sub_cmd) == 0 {
            ling_kernel_vga_write_str("usage: sudo <command> [args]\n")
        } else if is_wheel() == 0 {
            ling_kernel_vga_set_color(12, 0)
            bind who4 = ling_kernel_whoami()
            ling_kernel_print_lstr(who4)
            ling_kernel_vga_write_str(" is not in the wheel group\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_write_str("[sudo] password: ")
            bind sudo_pw = ling_kernel_read_line_masked()
            bind who5 = ling_kernel_whoami()
            bind sudo_ok = ling_kernel_user_login(who5, sudo_pw)
            if sudo_ok == 1 {
                run_command(sub_cmd, sub_arg)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("sudo: authentication failed\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "ling-life" {
        ling_kernel_life_run()
    } else if cmd == "about" {
        ling_kernel_vga_write_str("LingOS -- a basic OS, made in Ling\n")
    } else if cmd == "selftest" {
        bind ok = ling_kernel_fs_selftest()
        if ok == 1 {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("selftest: PASS\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("selftest: FAIL\n")
            ling_kernel_vga_set_color(7, 0)
        }
    } else if cmd == "proctest" {
        bind pok = ling_kernel_proc_selftest()
        if pok == 1 {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("proctest: PASS (cooperative task spawned, ran, yielded back)\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("proctest: FAIL\n")
            ling_kernel_vga_set_color(7, 0)
        }
    } else if cmd == "ps" {
        ling_kernel_proc_ps()
    } else if cmd == "nettest" {
        // Detailed MAC/link output goes to the serial log (no easy
        // hex/decimal-byte formatting on this shell's side) -- this just
        // reports pass/fail. See ling-kernel's drivers::net_e1000 module
        // doc: no interrupts, no DHCP, static-IP/self-test phase only.
        bind net_ok = ling_kernel_net_init()
        if net_ok == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("nettest: no NIC found\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("nettest: NIC initialized (see serial log for MAC/link)\n")
            ling_kernel_vga_set_color(7, 0)
            ling_kernel_vga_write_str("sending ARP request for the gateway...\n")
            bind arp_ok = ling_kernel_net_arp_selftest()
            if arp_ok == 1 {
                ling_kernel_vga_set_color(10, 0)
                ling_kernel_vga_write_str("nettest: ARP PASS -- gateway replied (driver TX/RX confirmed working)\n")
                ling_kernel_vga_set_color(7, 0)
            } else {
                ling_kernel_vga_set_color(12, 0)
                ling_kernel_vga_write_str("nettest: ARP FAIL -- no reply within timeout\n")
                ling_kernel_vga_set_color(7, 0)
            }
        }
    } else if cmd == "theme" {
        if arg == "light" {
            ling_kernel_theme_light()
        } else {
            ling_kernel_theme_dark()
        }
    } else if cmd == "play" {
        // Tape player: a real generative pentatonic track through the
        // AC'97 mixer (same synth + tuning as the desktop's jingles), with
        // an in-place ASCII transport. Space pauses/resumes, s or q stops.
        // The transport string itself is built kernel-side
        // (ling_kernel_player_line) -- variable-length bars need loops
        // this shell's language can't hold. `\r` redraw, no scroll.
        bind audio_ok = ling_kernel_audio_init()
        if audio_ok == 0 {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("play: no AC'97 audio device found\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_write_str("tape: space = play/pause, s or q = stop & eject\n")
            ling_kernel_player_load(42, 60000)
            ling_kernel_player_play()
            while ling_kernel_player_state() > 0 {
                ling_kernel_audio_pump()
                ling_kernel_vga_write_str("\r")
                ling_kernel_print_lstr(ling_kernel_player_line())
                bind k = ling_kernel_kbd_poll_char()
                if k == 32 {
                    ling_kernel_player_pause()
                } else if k == 115 {
                    ling_kernel_player_stop()
                } else if k == 113 {
                    ling_kernel_player_stop()
                }
            }
            ling_kernel_vga_write_str("\r")
            ling_kernel_print_lstr(ling_kernel_player_line())
            ling_kernel_vga_write_str("\ntape: ejected\n")
        }
    } else if cmd == "curl" {
        // Fetch a URL over the real TCP/HTTP stack. `curl <url>` prints the
        // body; `curl <url> <file>` saves it to a lingfs file (multi-block,
        // so big downloads work now). http:// only -- https is refused
        // out loud (no TLS stack yet), never silently downgraded.
        bind url = ling_kernel_str_cmd(arg)
        bind dest = ling_kernel_str_arg(arg)
        if len(url) == 0 {
            ling_kernel_vga_write_str("usage: curl <url> [outfile]\n")
        } else if len(dest) == 0 {
            bind r = ling_kernel_http_print(url)
            if r == 2 {
                ling_kernel_vga_write_str("curl: https needs a TLS stack LingOS doesn't have yet -- try http://\n")
            } else if r == 3 {
                ling_kernel_vga_write_str("curl: could not resolve host\n")
            } else if r == 0 {
                ling_kernel_vga_write_str("curl: fetch failed\n")
            }
        } else {
            bind r = ling_kernel_http_download(url, dest)
            if r == 1 {
                ling_kernel_vga_write_str("curl: saved to ")
                ling_kernel_print_lstr(dest)
                ling_kernel_vga_write_str("\n")
            } else if r == 2 {
                ling_kernel_vga_write_str("curl: https not supported yet (http:// only)\n")
            } else if r == 3 {
                ling_kernel_vga_write_str("curl: could not resolve host\n")
            } else if r == 4 {
                ling_kernel_vga_write_str("curl: fetched but couldn't write the file (too big, or fs error)\n")
            } else {
                ling_kernel_vga_write_str("curl: fetch failed\n")
            }
        }
    } else if cmd == "bring" {
        // bring: browser in ling. `bring <url>` fetches and renders the
        // page lynx-style to the console (headings, links numbered);
        // `bring --out <url> <file>` is curl-with-a-nicer-name; the desktop
        // has the interactive Browser window (dock W). One engine
        // (bring-browser) behind all three.
        bind sub = ling_kernel_str_cmd(arg)
        if len(sub) == 0 {
            ling_kernel_vga_write_str("usage: bring <url>   |   bring --out <url> <file>\n")
        } else if sub == "--out" {
            bind rest = ling_kernel_str_arg(arg)
            bind url = ling_kernel_str_cmd(rest)
            bind dest = ling_kernel_str_arg(rest)
            if len(url) == 0 {
                ling_kernel_vga_write_str("usage: bring --out <url> <file>\n")
            } else {
                bind r = ling_kernel_http_download(url, dest)
                if r == 1 {
                    ling_kernel_vga_write_str("bring: saved ")
                    ling_kernel_print_lstr(url)
                    ling_kernel_vga_write_str(" -> ")
                    ling_kernel_print_lstr(dest)
                    ling_kernel_vga_write_str("\n")
                } else {
                    ling_kernel_vga_write_str("bring: download failed (http:// only; check the host)\n")
                }
            }
        } else {
            bind ok = ling_kernel_browser_go(sub, 76)
            if ok == 1 {
                ling_kernel_browser_dump()
            } else {
                ling_kernel_vga_write_str("bring: ")
                ling_kernel_print_lstr(ling_kernel_browser_status())
                ling_kernel_vga_write_str("\n")
            }
        }
    } else if cmd == "" {
        ling_kernel_vga_write_str("")
    } else {
        ling_kernel_vga_set_color(12, 0)
        ling_kernel_vga_write_str("unknown command: ")
        ling_kernel_print_lstr(cmd)
        ling_kernel_vga_write_str(" (try 'help')\n")
        ling_kernel_vga_set_color(7, 0)
    }
}

// zsh-style two-line prompt: path in red, user in light blue, hostname in
// light green, punctuation in light grey, and a wheel-colored `#`/`$` that
// reflects group membership at a glance (bright red `#` for wheel, plain
// grey `$` otherwise) -- not an elevation indicator (nothing here holds a
// persistent elevated session, see `sudo`'s doc comment above), just group
// membership.
fn print_prompt() {
    ling_kernel_vga_set_color(4, 0)
    ling_kernel_vga_write_str("/")
    bind cwd = ling_kernel_cwd()
    ling_kernel_print_lstr(cwd)
    ling_kernel_vga_write_str("\n")
    ling_kernel_vga_set_color(9, 0)
    bind who = ling_kernel_whoami()
    ling_kernel_print_lstr(who)
    ling_kernel_vga_set_color(7, 0)
    ling_kernel_vga_write_str("@")
    ling_kernel_vga_set_color(10, 0)
    bind hn = ling_kernel_fs_read("/hostname")
    if len(hn) == 0 {
        ling_kernel_vga_write_str("lingos")
    } else {
        ling_kernel_print_lstr(hn)
    }
    if is_wheel() == 1 {
        ling_kernel_vga_set_color(12, 0)
        ling_kernel_vga_write_str(" # ")
    } else {
        ling_kernel_vga_set_color(8, 0)
        ling_kernel_vga_write_str(" $ ")
    }
    ling_kernel_vga_set_color(7, 0)
}

// The shared shell loop -- called once the caller (Live's boot sequence, or
// the Installer's after its own first-run wizard) is ready to hand off to
// an interactive prompt.
fn run_shell() {
    while 1 == 1 {
        print_prompt()
        bind line = ling_kernel_read_line()
        bind cmd = ling_kernel_str_cmd(line)
        bind arg = ling_kernel_str_arg(line)
        run_command(cmd, arg)
    }
}
