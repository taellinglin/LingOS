# LingOS desktop for the Raspberry Pi, in the look of the x86-64 LingOS
# desktop (kernel/x86_64-wm + drivers::wm): the Ling Country wallpaper, a top
# bar ("= LingOS" brand / Applications menu, locale, clock), a centred glass
# dock with letter tiles, windows with the Dusk theme's titlebar and traffic
# lights, the 8x8 pixel UI font and the ringed-dot cursor.
#
# It runs on the kernel's app runtime (the px_*/mouse_*/key_* builtins
# LingStationX uses, plus px_text8/os_wallpaper/os_cursor), so the apps it
# launches are full-screen compiled .ling programs linked into the same image
# (`bundle_app` in the kernel's Ling.toml); Ctrl+Q in an app comes back here.
# Keyboard: Super or Esc opens Applications, arrows + Enter pick; with the
# menu closed, Left/Right walk the dock and Enter launches. Alt+Tab cycles
# the open windows (most recent first, Shift+Tab back), like Windows. The look
# is LingStationX / LingDev's (their theme palette) with a ROYGBIV accent from
# Settings; the dock hides until the pointer reaches the bottom edge.

# Palette: the LingStationX / LingDev look (their theme.ling), over the Ling
# Country wallpaper. The accent is one of ROYGBIV, picked in Settings.
bind C_PANEL = 1776411.0       # 27,27,27   panels, top bar
bind C_BORDER = 2763826.0      # 42,44,50   lines
bind C_TEXT = 13488344.0       # 205,208,216
bind C_STRONG = 16119285.0     # 245,245,245
bind C_DIM = 9212056.0         # 140,144,152
bind C_TITLE = 2503756.0       # 38,52,76   focused titlebar, hover rows
bind C_TITLE_IDLE = 1447706.0  # 22,23,26
bind C_DOCK = 657930.0         # 10,10,10   deep background
bind ACCENTS = [15551031.0, 16225310.0, 16242758.0, 4573296.0, 3910379.0, 4875480.0, 10114006.0]
bind ACCENT_NAMES = ["Red", "Orange", "Yellow", "Green", "Blue", "Indigo", "Violet"]
bind SET_W = 560.0
bind SET_H = 400.0

fn accent() {
    return list_get(ACCENTS, st_get("accent", 4.0))
}

bind TOP_H = 30.0
bind TB = 28.0                 # TITLEBAR_H

# Apps: dock letter, label, action ("app:<name>" = built-in app).
bind APP_GLYPH = ["L", "D", "F", ">", "W", "A", "S", "i", "M", "P", "H", "@"]
bind APP_LABEL = ["LingStationX (music studio)", "LingDev (game editor)", "Files", "Console", "Wi-Fi networks", "HDMI audio test", "Settings", "About LingOS", "LingModeler (3D, vector, rigging)", "Packages (lingfu)", "Horizon (web browser)", "Messenger (LAN chat)"]
bind APP_KIND = ["app:lingstation", "app:lingdev", "files", "console", "wifi", "console:hdmiaudio", "settings", "about", "app:lingmodeler", "packages", "app:horizon", "app:messenger"]

# Applications menu rows: "#header" or an app index. Installed lingfu
# packages follow as "#Installed" + indices past the built-ins (menu_rows()).
bind MENU_ROWS = ["#Sound & Video", "0", "5", "#Development", "1", "8", "#Internet", "10", "11", "4", "#Accessories", "2", "3", "#System", "9", "6", "7"]
bind PK_W = 660.0
bind PK_H = 440.0
bind PK_ROW = 30.0
bind PK_F = 7.0
bind WIFI_W = 600.0
bind WIFI_H = 470.0
bind WIFI_ROW = 36.0
bind C_GOOD = 6279050.0        # 0x5FD38A
bind C_WARN = 14725194.0       # 0xE0B04A
bind C_BAD = 14707274.0        # 0xE06A4A

bind FILES_W = 600.0
bind FILES_H = 420.0
bind ROW_H = 24.0
bind VIEW_W = 640.0
bind VIEW_H = 480.0
bind MENU_W = 260.0
bind MENU_ROW_H = 22.0

bind ABOUT_W = 520.0
bind ABOUT_H = 300.0

fn sel(cond, a, b) {
    if cond { return a }
    return b
}

fn inside(mx, my, x, y, w, h) {
    return mx >= x && mx < x + w && my >= y && my < y + h
}

# ── Windows: stacking order and focus ────────────────────────────────────────
# "zorder" lists the open windows bottom to top; the top one has the focus.
# A click or Alt+Tab raises a window (win_raise); closed ones fall out.
bind WIN_NAMES = ["about", "files", "packages", "wifi", "viewer", "settings"]

fn list_has(l, v) {
    bind i = 0.0
    while i < len(l) {
        if list_get(l, i) == v { return true }
        bind i = i + 1.0
    }
    return false
}

fn win_open(name) {
    if name == "about" { return st_get("about", 0.0) > 0.5 }
    if name == "files" { return st_get("files", 0.0) > 0.5 }
    if name == "packages" { return st_get("pkgs_win", 0.0) > 0.5 }
    if name == "wifi" { return st_get("wifi_win", 0.0) > 0.5 }
    if name == "viewer" { return st_get("viewer", "") != "" }
    if name == "settings" { return st_get("set_win", 0.0) > 0.5 }
    return false
}

fn win_title(name) {
    if name == "about" { return "About LingOS" }
    if name == "files" { return "Files" }
    if name == "packages" { return "Packages" }
    if name == "wifi" { return "Wi-Fi networks" }
    if name == "settings" { return "Settings" }
    if name == "viewer" {
        bind parts = str_split(st_get("viewer", ""), "/")
        return list_get(parts, len(parts) - 1.0)
    }
    return name
}

fn win_glyph(name) {
    if name == "about" { return "i" }
    if name == "files" { return "F" }
    if name == "packages" { return "P" }
    if name == "wifi" { return "W" }
    if name == "settings" { return "S" }
    return "V"
}

fn win_rect(name) {
    if name == "about" { return [st_get("about_x", 0.0), st_get("about_y", 0.0), ABOUT_W, ABOUT_H] }
    if name == "files" { return [st_get("files_x", 0.0), st_get("files_y", 0.0), FILES_W, FILES_H] }
    if name == "packages" { return [st_get("pk_x", 0.0), st_get("pk_y", 0.0), PK_W, PK_H] }
    if name == "wifi" { return [st_get("wifi_x", 0.0), st_get("wifi_y", 0.0), WIFI_W, WIFI_H] }
    if name == "settings" { return [st_get("set_x", 0.0), st_get("set_y", 0.0), SET_W, SET_H] }
    return [st_get("view_x", 0.0), st_get("view_y", 0.0), VIEW_W, VIEW_H]
}

# Apps suspended with Alt+Tab, as switcher entries "app:<name>".
fn running_entries() {
    bind out = []
    bind r = os_apps_running()
    bind i = 0.0
    while i < len(r) {
        bind out = list_push(out, "app:" + list_get(r, i))
        bind i = i + 1.0
    }
    return out
}

# What Alt+Tab cycles: the windows (top first comes from the caller), then running apps.
fn switch_entries() {
    # Suspended apps sit under the windows: the top stays the current window
    # and the first Alt+Tab lands on the previous window, or on the app.
    bind out = running_entries()
    bind z = zorder()
    bind i = 0.0
    while i < len(z) {
        bind out = list_push(out, list_get(z, i))
        bind i = i + 1.0
    }
    return out
}

# Switch to an entry: a window is raised, a suspended app resumed.
fn switch_to(entry) {
    if str_starts_with(entry, "app:") {
        bind k = 0.0
        while k < len(APP_KIND) {
            if list_get(APP_KIND, k) == entry { run_app(k, get_width(), get_height()) }
            bind k = k + 1.0
        }
        return 0.0
    }
    win_raise(entry)
    return 0.0
}

fn entry_title(entry) {
    if str_starts_with(entry, "app:") {
        bind k = 0.0
        while k < len(APP_KIND) {
            if list_get(APP_KIND, k) == entry { return list_get(APP_LABEL, k) }
            bind k = k + 1.0
        }
        return entry
    }
    return win_title(entry)
}

fn entry_glyph(entry) {
    if str_starts_with(entry, "app:") {
        bind k = 0.0
        while k < len(APP_KIND) {
            if list_get(APP_KIND, k) == entry { return list_get(APP_GLYPH, k) }
            bind k = k + 1.0
        }
        return "A"
    }
    return win_glyph(entry)
}

# The open windows bottom to top: the remembered order minus what closed,
# plus whatever opened since (on top).
fn zorder() {
    bind z = st_get("zorder", [])
    bind out = []
    bind i = 0.0
    while i < len(z) {
        bind n = list_get(z, i)
        if win_open(n) && !list_has(out, n) { bind out = list_push(out, n) }
        bind i = i + 1.0
    }
    bind i = 0.0
    while i < len(WIN_NAMES) {
        bind n = list_get(WIN_NAMES, i)
        if win_open(n) && !list_has(out, n) { bind out = list_push(out, n) }
        bind i = i + 1.0
    }
    return out
}

# Bring a window to the top and give it the focus.
fn win_raise(name) {
    bind z = st_get("zorder", [])
    bind out = []
    bind i = 0.0
    while i < len(z) {
        bind n = list_get(z, i)
        if n != name && !list_has(out, n) { bind out = list_push(out, n) }
        bind i = i + 1.0
    }
    st_set("zorder", list_push(out, name))
    st_set("focus", name)
    return 0.0
}

# The top-most open window under the pointer, or "".
fn win_at(mx, my) {
    bind z = zorder()
    bind i = len(z) - 1.0
    while i >= 0.0 {
        bind n = list_get(z, i)
        bind r = win_rect(n)
        if inside(mx, my, list_get(r, 0.0), list_get(r, 1.0), list_get(r, 2.0), list_get(r, 3.0)) { return n }
        bind i = i - 1.0
    }
    return ""
}

# Alt+Tab: the open windows as tiles, most recent first, the pick highlighted.
fn switcher(w, h) {
    bind z = switch_entries()
    bind n = len(z)
    if n < 0.5 { return 0.0 }
    bind tw = 150.0
    bind th = 112.0
    bind gap = 14.0
    bind pw = n * tw + (n + 1.0) * gap
    bind ph = th + 2.0 * gap + 28.0
    bind x = floor((w - pw) / 2.0)
    bind y = floor((h - ph) / 2.0) - 20.0
    px_rrect(x + 6.0, y + 8.0, pw, ph, 12.0, 0.0, 0.35)
    px_rrect(x, y, pw, ph, 12.0, C_BORDER)
    px_rrect(x + 1.0, y + 1.0, pw - 2.0, ph - 2.0, 11.0, C_PANEL)
    bind cur = st_get("switch_i", 0.0)
    bind k = 0.0
    while k < n {
        bind name = list_get(z, n - 1.0 - k)
        bind tx = x + gap + k * (tw + gap)
        bind ty = y + gap
        bind hot = k == cur
        px_rrect(tx - 3.0, ty - 3.0, tw + 6.0, th + 6.0, 9.0, sel(hot, accent(), C_PANEL))
        px_rrect(tx, ty, tw, th, 7.0, sel(hot, C_TITLE, C_DOCK))
        # a little window: frame, titlebar, body, the app's letter
        px_rrect(tx + 20.0, ty + 12.0, tw - 40.0, th - 42.0, 5.0, C_BORDER)
        px_rrect(tx + 21.0, ty + 13.0, tw - 42.0, 10.0, 4.0, sel(hot, accent(), C_TITLE))
        px_rect(tx + 21.0, ty + 23.0, tw - 42.0, th - 53.0, C_PANEL)
        px_disc(tx + 27.0, ty + 18.0, 2.0, 14704730.0)
        px_disc(tx + 34.0, ty + 18.0, 2.0, 14721098.0)
        px_disc(tx + 41.0, ty + 18.0, 2.0, 5947498.0)
        t8(tx + tw / 2.0 - 4.0, ty + 42.0, accent(), entry_glyph(name))
        if str_starts_with(name, "app:") { t8(tx + 8.0, ty + 4.0, C_GOOD, "running") }
        bind title = entry_title(name)
        if len(title) > 17.0 { bind title = str_slice(title, 0.0, 15.0) + ".." }
        t8(tx + floor((tw - len(title) * 8.0) / 2.0), ty + th - 16.0, sel(hot, C_TEXT, C_DIM), title)
        bind k = k + 1.0
    }
    bind hint = "Tab: next   Shift+Tab: back   let go of Alt to switch"
    t8(x + floor((pw - len(hint) * 8.0) / 2.0), y + ph - 20.0, C_DIM, hint)
    return 0.0
}

# Append what was typed since the last poll to the stored string `key`
# (characters from `ok_chars`, or any printable when it is ""), backspace deletes.
bind PRINTABLE = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn typed_into(key, ok_chars) {
    bind pend = text_poll()
    bind buf = st_get(key, "")
    if key_pressed("backspace") && str_len(buf) > 0.0 { bind buf = str_slice(buf, 0.0, str_len(buf) - 1.0) }
    bind i = 0.0
    while i < str_len(pend) {
        bind ch = str_slice(pend, i, 1.0)
        # (strings compare as numbers in compiled Ling, so membership tests only)
        bind code = str_find(sel(ok_chars == "", PRINTABLE, ok_chars), ch) >= 0.0
        if code { bind buf = buf + ch }
        bind i = i + 1.0
    }
    st_set(key, buf)
    return 0.0
}

# Typed text into a form: `keys` are its fields in Tab order and `focus` the
# st key naming the focused field. The stream is handled in order: a Tab moves
# the focus on, Enter sets "<focus>_enter", and a field focused since the last
# key ("<focus>_fresh") is replaced by what is typed into it.
fn form_index(keys, f) {
    bind k = 0.0
    while k < len(keys) {
        if list_get(keys, k) == f { return k }
        bind k = k + 1.0
    }
    return 0.0 - 1.0
}

fn form_type(keys, focus, ok_chars) {
    bind pend = text_poll()
    bind i = 0.0
    while i < str_len(pend) {
        bind ch = str_slice(pend, i, 1.0)
        bind f = st_get(focus, "")
        if ch == "\t" {
            bind k = form_index(keys, f) + 1.0
            st_set(focus, list_get(keys, sel(k >= len(keys), 0.0, k)))
            st_set(focus + "_fresh", 1.0)
        } else if ch == "\n" {
            st_set(focus + "_enter", 1.0)
        } else if f != "" && str_find(sel(ok_chars == "", PRINTABLE, ok_chars), ch) >= 0.0 {
            bind cur = sel(st_get(focus + "_fresh", 0.0) > 0.5, "", st_get(f, ""))
            st_set(f, cur + ch)
            st_set(focus + "_fresh", 0.0)
        }
        bind i = i + 1.0
    }
    bind f = st_get(focus, "")
    if key_pressed("backspace") && f != "" {
        bind v = st_get(f, "")
        if str_len(v) > 0.0 { st_set(f, str_slice(v, 0.0, str_len(v) - 1.0)) }
        st_set(focus + "_fresh", 0.0)
    }
    return 0.0
}

fn stars(n) {
    bind s = ""
    bind k = 0.0
    while k < n {
        bind s = s + "*"
        bind k = k + 1.0
    }
    return s
}

fn caret() {
    return sel(floor(os_uptime() * 2.0) - floor(os_uptime()) * 2.0 < 0.5, "_", " ")
}

# A text box; `secret` shows stars. Returns whether the pointer is over it.
fn text_box(x, y, bw, key, focused, secret, mx, my) {
    px_rrect(x, y, bw, 26.0, 6.0, C_DOCK)
    px_rrect_outline(x, y, bw, 26.0, 6.0, sel(focused, accent(), C_BORDER))
    bind v = st_get(key, "")
    if secret { bind v = stars(str_len(v)) }
    bind maxc = floor((bw - 16.0) / 8.0)
    if len(v) > maxc { bind v = str_slice(v, len(v) - maxc, maxc) }
    t8(x + 8.0, y + 9.0, C_TEXT, v + sel(focused, caret(), ""))
    return inside(mx, my, x, y, bw, 26.0)
}

# ── Sign in ──────────────────────────────────────────────────────────────────
# With LingOS storage on the card the desktop starts locked: the first boot
# creates the account (Argon2id-hashed in the kernel), later boots sign in.
# Settings > System locks it again.
bind LOGIN_W = 460.0
bind LOGIN_H = 320.0

fn lock_screen() {
    bind users = os_users()
    st_set("login_users", users)
    # No account yet: a blank name to type. Otherwise the signed-in (or first) user, password next.
    if len(users) < 0.5 {
        st_set("login_user", "")
        st_set("login_focus", "login_user")
    } else {
        st_set("login_user", sel(list_has(users, os_user()), os_user(), list_get(users, 0.0)))
        st_set("login_focus", "login_pass")
    }
    st_set("login_focus_fresh", 0.0)
    st_set("login_focus_enter", 0.0)
    st_set("login_pass", "")
    st_set("login_pass2", "")
    st_set("login_msg", "")
    st_set("locked", 1.0)
    st_set("menu", 0.0)
    st_set("switch", 0.0)
    return 0.0
}

fn login_submit() {
    bind users = st_get("login_users", [])
    bind user = st_get("login_user", "")
    bind pass = st_get("login_pass", "")
    if len(users) < 0.5 {
        if user == "" {
            st_set("login_msg", "pick a user name (letters, digits, - or _)")
            return 0.0
        }
        if str_len(pass) < 4.0 {
            st_set("login_msg", "the password needs at least 4 characters")
            return 0.0
        }
        if pass != st_get("login_pass2", "") {
            st_set("login_msg", "the two passwords differ")
            return 0.0
        }
        if os_user_create(user, pass) {
            st_set("locked", 0.0)
            st_set("login_pass", "")
            st_set("login_pass2", "")
        } else {
            st_set("login_msg", "could not create the account (name taken, or storage not writable)")
        }
        return 0.0
    }
    if os_login(user, pass) {
        st_set("locked", 0.0)
        st_set("login_pass", "")
    } else {
        st_set("login_msg", "wrong password")
        st_set("login_pass", "")
    }
    return 0.0
}

fn login_frame(w, h, mx, my, click) {
    wallpaper(w, h)
    bind users = st_get("login_users", [])
    bind creating = len(users) < 0.5
    bind x = floor((w - LOGIN_W) / 2.0)
    bind y = floor((h - LOGIN_H) / 2.0) - 20.0
    px_rrect(x + 4.0, y + 6.0, LOGIN_W, LOGIN_H, 8.0, 0.0, 0.4)
    px_rrect(x, y, LOGIN_W, LOGIN_H, 8.0, C_BORDER)
    px_rrect(x + 1.0, y + 1.0, LOGIN_W - 2.0, LOGIN_H - 2.0, 7.0, C_PANEL)
    px_rect(x + 1.0, y + 1.0, LOGIN_W - 2.0, 3.0, accent())
    px_text8(x + 24.0, y + 22.0, accent(), "LingOS", 2.0)
    t8(x + 24.0, y + 48.0, C_DIM, sel(creating, "Welcome -- create your account", "Sign in"))
    bind focus = st_get("login_focus", "login_user")
    bind fy = y + 80.0
    t8(x + 24.0, fy + 9.0, C_TEXT, "User")
    bind hot0 = text_box(x + 120.0, fy, LOGIN_W - 144.0, "login_user", focus == "login_user", false, mx, my)
    t8(x + 24.0, fy + 45.0, C_TEXT, "Password")
    bind hot1 = text_box(x + 120.0, fy + 36.0, LOGIN_W - 144.0, "login_pass", focus == "login_pass", true, mx, my)
    bind hot2 = false
    if creating {
        t8(x + 24.0, fy + 81.0, C_TEXT, "Again")
        bind hot2 = text_box(x + 120.0, fy + 72.0, LOGIN_W - 144.0, "login_pass2", focus == "login_pass2", true, mx, my)
    } else if len(users) > 1.5 {
        t8(x + 24.0, fy + 78.0, C_DIM, "Up / Down: other users")
    }
    bind by = y + LOGIN_H - 64.0
    bind bhot = wifi_pill(x + LOGIN_W - 24.0 - 120.0, by, 120.0, sel(creating, "Create", "Sign in"), mx, my, true)
    t8(x + 24.0, by + 9.0, sel(st_get("login_msg", "") == "", C_DIM, C_BAD), sel(st_get("login_msg", "") == "", "Enter: continue   Tab: next field", st_get("login_msg", "")))
    t8(x + 24.0, y + LOGIN_H - 24.0, C_DIM, "passwords are stored Argon2id-hashed on the SD card")
    if click {
        if hot0 && creating {
            st_set("login_focus", "login_user")
            st_set("login_focus_fresh", 1.0)
        }
        if hot1 {
            st_set("login_focus", "login_pass")
            st_set("login_focus_fresh", 1.0)
        }
        if hot2 {
            st_set("login_focus", "login_pass2")
            st_set("login_focus_fresh", 1.0)
        }
        if bhot { login_submit() }
    }
    bind keys = sel(creating, ["login_user", "login_pass", "login_pass2"], ["login_pass"])
    # The name is letters, digits, - and _; passwords any printable character.
    form_type(keys, "login_focus", sel(st_get("login_focus", "") == "login_user", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", ""))
    if !creating && len(users) > 1.5 && (key_pressed("down") || key_pressed("up")) {
        bind cur = 0.0
        bind k = 0.0
        while k < len(users) {
            if list_get(users, k) == st_get("login_user", "") { bind cur = k }
            bind k = k + 1.0
        }
        bind cur = cur + sel(key_pressed("down"), 1.0, len(users) - 1.0)
        st_set("login_user", list_get(users, cur - floor(cur / len(users)) * len(users)))
    }
    if st_get("login_focus_enter", 0.0) > 0.5 {
        st_set("login_focus_enter", 0.0)
        login_submit()
    }
    return 0.0
}

# ── Settings ─────────────────────────────────────────────────────────────────
bind SET_TABS = ["Appearance", "Dock", "Sound", "Network", "System"]

fn settings_path() {
    return fs_join(fs_join(fs_join(fs_home(), "Programs"), "LingOS"), "desktop.conf")
}

fn settings_load() {
    bind s = read_file(settings_path())
    bind lines = str_split(s, "\n")
    bind i = 0.0
    while i < len(lines) {
        bind kv = str_split(list_get(lines, i), "=")
        if len(kv) == 2.0 {
            bind k = list_get(kv, 0.0)
            bind v = list_get(kv, 1.0)
            if k == "accent" { st_set("accent", min(6.0, max(0.0, to_number(v)))) }
            if k == "dock_auto" { st_set("dock_auto", to_number(v)) }
            if k == "pause_audio" { st_set("pause_audio", to_number(v)) }
            if k == "net_mode" { st_set("net_mode", v) }
            if k == "net_ip" { st_set("net_ip", v) }
            if k == "net_mask" { st_set("net_mask", v) }
            if k == "net_gw" { st_set("net_gw", v) }
            if k == "net_dns" { st_set("net_dns", v) }
        }
        bind i = i + 1.0
    }
    settings_apply()
    return 0.0
}

# Put the loaded (or just changed) settings into effect in the kernel.
fn settings_apply() {
    os_option("pause_audio", st_get("pause_audio", 1.0) > 0.5)
    if st_get("net_mode", "dhcp") == "static" {
        st_set("net_msg", os_net_set("static", st_get("net_ip", ""), st_get("net_mask", ""), st_get("net_gw", ""), st_get("net_dns", "")))
    }
    return 0.0
}

# The live network state into the fields that are still empty.
fn net_prefill() {
    bind parts = str_split(os_net_get(), "\t")
    if len(parts) < 5.0 { return 0.0 }
    if st_get("net_ip", "") == "" { st_set("net_ip", list_get(parts, 1.0)) }
    if st_get("net_mask", "") == "" { st_set("net_mask", list_get(parts, 2.0)) }
    if st_get("net_gw", "") == "" { st_set("net_gw", list_get(parts, 3.0)) }
    if st_get("net_dns", "") == "" { st_set("net_dns", list_get(parts, 4.0)) }
    return 0.0
}

fn settings_save() {
    fs_mkdir(fs_join(fs_home(), "Programs"))
    fs_mkdir(fs_join(fs_join(fs_home(), "Programs"), "LingOS"))
    write_file(settings_path(), "accent=" + num_str(st_get("accent", 4.0)) + "\ndock_auto=" + num_str(st_get("dock_auto", 1.0)) + "\npause_audio=" + num_str(st_get("pause_audio", 1.0)) + "\nnet_mode=" + st_get("net_mode", "dhcp") + "\nnet_ip=" + st_get("net_ip", "") + "\nnet_mask=" + st_get("net_mask", "") + "\nnet_gw=" + st_get("net_gw", "") + "\nnet_dns=" + st_get("net_dns", "") + "\n")
    return 0.0
}

fn settings_open(w, h) {
    st_set("set_win", 1.0)
    st_set("set_field", "")
    net_prefill()
    st_set("set_x", floor((w - SET_W) / 2.0) + 20.0)
    st_set("set_y", floor((h - SET_H) / 2.0 - 30.0))
    win_raise("settings")
    return 0.0
}

fn settings_swatch_x(x, i) {
    return x + 40.0 + i * 70.0
}

fn settings_tab_x(x, i) {
    bind tx = x + 16.0
    bind k = 0.0
    while k < i {
        bind tx = tx + len(list_get(SET_TABS, k)) * 8.0 + 26.0
        bind k = k + 1.0
    }
    return tx
}

fn settings_window(mx, my) {
    bind x = st_get("set_x", 0.0)
    bind y = st_get("set_y", 0.0)
    window_frame(x, y, SET_W, SET_H, "Settings", st_get("focus", "") == "settings")
    bind tab = st_get("set_tab", 0.0)
    bind ty = y + TB + 10.0
    bind k = 0.0
    while k < len(SET_TABS) {
        bind nm = list_get(SET_TABS, k)
        bind tx = settings_tab_x(x, k)
        bind tw = len(nm) * 8.0 + 18.0
        if k == tab {
            px_rrect(tx, ty, tw, 24.0, 6.0, C_TITLE)
            px_rect(tx + 6.0, ty + 23.0, tw - 12.0, 2.0, accent())
        } else if inside(mx, my, tx, ty, tw, 24.0) {
            px_rrect(tx, ty, tw, 24.0, 6.0, C_TITLE_IDLE)
        }
        t8(tx + 9.0, ty + 8.0, sel(k == tab, C_STRONG, C_DIM), nm)
        bind k = k + 1.0
    }
    px_rect(x + 12.0, ty + 32.0, SET_W - 24.0, 1.0, C_BORDER)
    bind cx = x + 20.0
    bind cy = ty + 48.0
    if tab == 0.0 { settings_tab_appearance(x, cx, cy, mx, my) }
    if tab == 1.0 { settings_tab_dock(cx, cy, mx, my) }
    if tab == 2.0 { settings_tab_sound(cx, cy, mx, my) }
    if tab == 3.0 { settings_tab_network(x, cx, cy, mx, my) }
    if tab == 4.0 { settings_tab_system(cx, cy, mx, my) }
    return 0.0
}

fn settings_tab_appearance(x, cx, cy, mx, my) {
    t8(cx, cy, C_TEXT, "Accent colour")
    bind cur = st_get("accent", 4.0)
    bind i = 0.0
    while i < 7.0 {
        bind sx = settings_swatch_x(x, i)
        bind sy = cy + 40.0
        bind hot = inside(mx, my, sx - 16.0, sy - 16.0, 32.0, 32.0)
        if i == cur { px_ring(sx, sy, 16.0, C_STRONG) }
        if hot && i != cur { px_ring(sx, sy, 16.0, C_DIM) }
        px_disc(sx, sy, 11.0, list_get(ACCENTS, i))
        bind nm = list_get(ACCENT_NAMES, i)
        t8(sx - len(nm) * 4.0, sy + 24.0, sel(i == cur, C_STRONG, C_DIM), nm)
        bind i = i + 1.0
    }
    t8(cx, cy + 100.0, C_TEXT, "Wallpaper")
    t8(cx + 120.0, cy + 100.0, C_DIM, "Ling Country (the desktop keeps it)")
    t8(cx, cy + 118.0, C_TEXT, "Windows")
    t8(cx + 120.0, cy + 118.0, C_DIM, "LingStationX / LingDev chrome")
    t8(cx, cy + 136.0, C_TEXT, "Font")
    t8(cx + 120.0, cy + 136.0, C_DIM, "the 8x8 pixel UI font")
    return 0.0
}

fn toggle(x, y, on, label, mx, my) {
    px_rrect(x, y, 44.0, 22.0, 11.0, sel(on, accent(), C_BORDER))
    px_disc(x + sel(on, 33.0, 11.0), y + 11.0, 8.0, C_STRONG)
    t8(x + 56.0, y + 7.0, C_TEXT, label)
    return inside(mx, my, x, y, 44.0 + 12.0 + len(label) * 8.0, 22.0)
}

fn settings_tab_dock(cx, cy, mx, my) {
    bind auto = st_get("dock_auto", 1.0) > 0.5
    toggle(cx, cy, auto, sel(auto, "Hide the dock until the pointer touches the bottom edge", "Dock always shown"), mx, my)
    t8(cx, cy + 36.0, C_DIM, "Left / Right / Tab bring it out; windows move up out of its way")
    t8(cx, cy + 70.0, C_TEXT, "Alt+Tab")
    t8(cx + 120.0, cy + 70.0, C_DIM, "switches between windows and running apps")
    t8(cx, cy + 88.0, C_TEXT, "In an app")
    t8(cx + 120.0, cy + 88.0, C_DIM, "Alt+Tab comes back here with the app kept running;")
    t8(cx + 120.0, cy + 104.0, C_DIM, "Ctrl+Q closes it")
    return 0.0
}

fn settings_tab_sound(cx, cy, mx, my) {
    bind pa = st_get("pause_audio", 1.0) > 0.5
    toggle(cx, cy, pa, "Pause LingStationX's music when it is suspended or closed", mx, my)
    t8(cx, cy + 36.0, C_DIM, sel(pa, "Alt+Tab out of LingStationX silences the transport; Play resumes it", "the music keeps playing under the desktop"))
    t8(cx, cy + 70.0, C_TEXT, "Output")
    t8(cx + 120.0, cy + 70.0, C_DIM, "HDMI, 48 kHz stereo (apps mix their own levels)")
    tray_button(cx, cy + 100.0, 110.0, "Test tone", mx, my)
    return 0.0
}

fn settings_tab_network(x, cx, cy, mx, my) {
    bind static = st_get("net_mode", "dhcp") == "static"
    t8(cx, cy, C_TEXT, "Address")
    bind p1 = wifi_pill(cx + 120.0, cy - 7.0, 150.0, "Automatic (DHCP)", mx, my, !static)
    bind p2 = wifi_pill(cx + 280.0, cy - 7.0, 90.0, "Static", mx, my, static)
    bind labels = ["IP address", "Netmask", "Gateway", "DNS"]
    bind keys = ["net_ip", "net_mask", "net_gw", "net_dns"]
    bind i = 0.0
    while i < 4.0 {
        bind fy = cy + 36.0 + i * 34.0
        t8(cx, fy + 9.0, sel(static, C_TEXT, C_DIM), list_get(labels, i))
        text_box(cx + 120.0, fy, 200.0, list_get(keys, i), static && st_get("set_field", "") == list_get(keys, i), false, mx, my)
        bind i = i + 1.0
    }
    wifi_pill(cx + 340.0, cy + 36.0, 100.0, "Apply", mx, my, true)
    bind ip = os_info("ip")
    t8(cx, cy + 176.0, C_DIM, "now: " + sel(ip == "", "no address", ip) + sel(static, "  (static)", "  (DHCP unless a static address is set)"))
    bind msg = st_get("net_msg", "")
    if msg != "" { t8(cx, cy + 194.0, C_TEXT, str_slice(msg, 0.0, 64.0)) }
    return 0.0
}

fn settings_tab_system(cx, cy, mx, my) {
    bind ready = os_storage_ready()
    t8(cx, cy, C_TEXT, "Signed in")
    t8(cx + 120.0, cy, C_DIM, sel(os_user() == "", "nobody (no storage)", os_user()))
    t8(cx, cy + 18.0, C_TEXT, "Storage")
    t8(cx + 120.0, cy + 18.0, sel(ready, C_DIM, C_WARN), sel(ready, "LingOS storage on the SD card", "none yet: settings, accounts and projects will not survive a reboot"))
    bind by = cy + 48.0
    tray_button(cx, by, 150.0, "Lock screen", mx, my)
    tray_button(cx + 160.0, by, 150.0, "Setup wizard", mx, my)
    tray_button(cx + 320.0, by, 110.0, "Console", mx, my)
    if !ready { tray_button(cx, by + 34.0, 230.0, "Set up storage (sd format)", mx, my) }
    tray_button(cx + sel(ready, 0.0, 240.0), by + 34.0, 110.0, "About", mx, my)
    t8(cx, by + 76.0, C_DIM, "Set up storage uses the free space after the boot partition (the console asks).")
    t8(cx, by + 100.0, C_DIM, "Alt+Tab switches windows    Super: Applications    w: Wi-Fi")
    return 0.0
}

fn settings_click(mx, my, w, h) {
    bind x = st_get("set_x", 0.0)
    bind y = st_get("set_y", 0.0)
    bind ty = y + TB + 10.0
    bind k = 0.0
    while k < len(SET_TABS) {
        bind tx = settings_tab_x(x, k)
        if inside(mx, my, tx, ty, len(list_get(SET_TABS, k)) * 8.0 + 18.0, 24.0) {
            st_set("set_tab", k)
            st_set("set_field", "")
        }
        bind k = k + 1.0
    }
    bind tab = st_get("set_tab", 0.0)
    bind cx = x + 20.0
    bind cy = ty + 48.0
    if tab == 0.0 {
        bind i = 0.0
        while i < 7.0 {
            if inside(mx, my, settings_swatch_x(x, i) - 16.0, cy + 24.0, 32.0, 32.0) {
                st_set("accent", i)
                settings_save()
            }
            bind i = i + 1.0
        }
    }
    if tab == 1.0 && inside(mx, my, cx, cy, 500.0, 22.0) {
        st_set("dock_auto", sel(st_get("dock_auto", 1.0) > 0.5, 0.0, 1.0))
        settings_save()
    }
    if tab == 2.0 {
        if inside(mx, my, cx, cy, 520.0, 22.0) {
            st_set("pause_audio", sel(st_get("pause_audio", 1.0) > 0.5, 0.0, 1.0))
            settings_apply()
            settings_save()
        }
        if inside(mx, my, cx, cy + 100.0, 110.0, 24.0) { os_console("hdmiaudio") }
    }
    if tab == 3.0 {
        if inside(mx, my, cx + 120.0, cy - 7.0, 150.0, 26.0) {
            st_set("net_mode", "dhcp")
            st_set("set_field", "")
            st_set("net_msg", os_net_set("dhcp", "", "", "", ""))
            settings_save()
        }
        if inside(mx, my, cx + 280.0, cy - 7.0, 90.0, 26.0) {
            st_set("net_mode", "static")
            st_set("set_field", "net_ip")
            st_set("set_field_fresh", 1.0)
        }
        bind keys = ["net_ip", "net_mask", "net_gw", "net_dns"]
        bind i = 0.0
        while i < 4.0 {
            if st_get("net_mode", "dhcp") == "static" && inside(mx, my, cx + 120.0, cy + 36.0 + i * 34.0, 200.0, 26.0) {
                st_set("set_field", list_get(keys, i))
                st_set("set_field_fresh", 1.0)
            }
            bind i = i + 1.0
        }
        if inside(mx, my, cx + 340.0, cy + 36.0, 100.0, 26.0) { settings_net_apply() }
    }
    if tab == 4.0 {
        bind by = cy + 48.0
        bind ready = os_storage_ready()
        if inside(mx, my, cx, by, 150.0, 24.0) { lock_screen() }
        if inside(mx, my, cx + 160.0, by, 150.0, 24.0) { os_setup() }
        if inside(mx, my, cx + 320.0, by, 110.0, 24.0) { os_console("") }
        if !ready && inside(mx, my, cx, by + 34.0, 230.0, 24.0) { os_console("sd format") }
        if inside(mx, my, cx + sel(ready, 0.0, 240.0), by + 34.0, 110.0, 24.0) {
            st_set("about", 1.0)
            st_set("about_x", floor((w - ABOUT_W) / 2.0) - 40.0)
            st_set("about_y", floor((h - ABOUT_H) / 2.0))
            win_raise("about")
        }
    }
    return 0.0
}

fn settings_net_apply() {
    if st_get("net_mode", "dhcp") == "static" {
        st_set("net_msg", os_net_set("static", st_get("net_ip", ""), st_get("net_mask", ""), st_get("net_gw", ""), st_get("net_dns", "")))
    } else {
        st_set("net_msg", os_net_set("dhcp", "", "", "", ""))
    }
    settings_save()
    return 0.0
}

# Keys while the Settings window has the focus: typing into the network fields.
fn settings_keys() {
    if st_get("set_tab", 0.0) == 3.0 && st_get("set_field", "") != "" {
        form_type(["net_ip", "net_mask", "net_gw", "net_dns"], "set_field", "0123456789.")
        if st_get("set_field_enter", 0.0) > 0.5 {
            st_set("set_field_enter", 0.0)
            settings_net_apply()
        }
    }
    return 0.0
}

fn win_draw(name, mx, my) {
    if name == "settings" { settings_window(mx, my) }
    if name == "about" { about_window() }
    if name == "files" { files_window(mx, my) }
    if name == "packages" { pk_window(mx, my) }
    if name == "wifi" { wifi_window(mx, my) }
    if name == "viewer" { viewer_window() }
    return 0.0
}

fn t8(x, y, c, s) {
    px_text8(x, y, c, s)
}

fn two(n) {
    if n < 10.0 { return "0" + n }
    return "" + n
}

fn clock_str() {
    bind s = floor(os_uptime())
    bind hh = floor(s / 3600.0)
    bind mm = floor((s - hh * 3600.0) / 60.0)
    return two(hh) + ":" + two(mm) + ":" + two(s - hh * 3600.0 - mm * 60.0)
}

fn uptime_words() {
    bind s = floor(os_uptime())
    bind m = floor(s / 60.0)
    return m + "m " + (s - m * 60.0) + "s"
}

# ── wallpaper + top bar ──────────────────────────────────────────────────────

fn wallpaper(w, h) {
    if os_wallpaper() { return 0.0 }
    # No embedded image: the theme's wallpaper gradient (0x2B2140 -> 0x120E1A).
    bind i = 0.0
    while i < 32.0 {
        bind t = i / 31.0
        bind r = 43.0 + (18.0 - 43.0) * t
        bind g = 33.0 + (14.0 - 33.0) * t
        bind b = 64.0 + (26.0 - 64.0) * t
        px_rect(0.0, floor(h * i / 32.0), w, floor(h / 32.0) + 1.0, floor(r) * 65536.0 + floor(g) * 256.0 + floor(b))
        bind i = i + 1.0
    }
    return 0.0
}

# The tray, right to left: clock, sound, Wi-Fi, input lights.
fn clock_x(w) {
    return w - len(clock_str()) * 8.0 - 14.0
}

fn tray_sound_x(w) {
    return clock_x(w) - 38.0
}

fn tray_sound_rect(w) {
    return [tray_sound_x(w) - 180.0, TOP_H + 6.0, 240.0, 112.0]
}

fn tray_sound_icon(w, mx, my) {
    bind x = tray_sound_x(w)
    bind hot = inside(mx, my, x - 6.0, 0.0, 32.0, TOP_H)
    if st_get("tray_sound", 0.0) > 0.5 || hot { px_rrect(x - 6.0, 4.0, 32.0, 22.0, 5.0, C_TITLE) }
    bind c = C_TEXT
    px_rect(x, 12.0, 3.0, 7.0, c)
    px_rect(x + 3.0, 11.0, 2.0, 9.0, c)
    px_rect(x + 5.0, 10.0, 2.0, 11.0, c)
    px_rect(x + 7.0, 9.0, 2.0, 13.0, c)
    px_clip(x + 10.0, 6.0, 12.0, 19.0)
    px_ring(x + 8.0, 15.5, 5.0, c)
    px_ring(x + 8.0, 15.5, 9.0, c)
    px_unclip()
    return 0.0
}

fn tray_sound_popup(w, mx, my) {
    bind r = tray_sound_rect(w)
    bind x = list_get(r, 0.0)
    bind y = list_get(r, 1.0)
    bind pw = list_get(r, 2.0)
    bind ph = list_get(r, 3.0)
    px_rrect(x + 4.0, y + 5.0, pw, ph, 8.0, 0.0, 0.31)
    px_rrect(x, y, pw, ph, 8.0, C_BORDER)
    px_rrect(x + 1.0, y + 1.0, pw - 2.0, ph - 2.0, 7.0, C_PANEL)
    t8(x + 14.0, y + 12.0, C_STRONG, "Sound")
    t8(x + 14.0, y + 32.0, C_DIM, "Output: HDMI  48 kHz stereo")
    t8(x + 14.0, y + 48.0, C_DIM, "apps mix their own levels")
    tray_button(x + 14.0, y + 72.0, 100.0, "Test tone", mx, my)
    tray_button(x + 124.0, y + 72.0, 100.0, "Settings", mx, my)
    return 0.0
}

fn tray_sound_click(mx, my, w, h) {
    bind r = tray_sound_rect(w)
    bind x = list_get(r, 0.0)
    bind y = list_get(r, 1.0)
    if inside(mx, my, x + 14.0, y + 72.0, 100.0, 24.0) {
        st_set("tray_sound", 0.0)
        os_console("hdmiaudio")
    } else if inside(mx, my, x + 124.0, y + 72.0, 100.0, 24.0) {
        st_set("tray_sound", 0.0)
        settings_open(w, h)
    }
    return 0.0
}

fn top_bar(w, mx, my) {
    px_rect(0.0, 0.0, w, TOP_H, C_PANEL)
    px_rect(0.0, TOP_H, w, 1.0, C_BORDER)
    if inside(mx, my, 0.0, 0.0, 84.0, TOP_H) || st_get("menu", 0.0) > 0.5 {
        px_rrect(4.0, 4.0, 76.0, 22.0, 5.0, C_TITLE)
    }
    t8(12.0, 11.0, accent(), "= LingOS")
    t8(96.0, 11.0, C_DIM, "English (US)")
    bind clock = clock_str()
    bind cx = clock_x(w)
    t8(cx, 11.0, C_TEXT, clock)
    tray_sound_icon(w, mx, my)
    tray_wifi_icon(w)
    # input lights
    bind mouse_ok = st_get("mouse_info", "") != "none"
    bind kbd_ok = st_get("kbd_info", "") != "serial only"
    bind tx = tray_wifi_x(w) - 108.0
    px_disc(tx, 15.0, 3.0, sel(mouse_ok, 5947498.0, 14704730.0))
    t8(tx + 8.0, 11.0, C_DIM, "mouse")
    px_disc(tx + 60.0, 15.0, 3.0, sel(kbd_ok, 5947498.0, 14704730.0))
    t8(tx + 68.0, 11.0, C_DIM, "kbd")
}

# ── dock ─────────────────────────────────────────────────────────────────────

fn dock_size(h) {
    return max(32.0, floor(h / 14.0))
}

fn dock_x(i, w, h) {
    bind sz = dock_size(h)
    bind gap = floor(sz / 4.0)
    bind n = len(APP_GLYPH)
    bind total = n * sz + (n - 1.0) * gap
    return floor((w - total) / 2.0) + i * (sz + gap)
}

# How much of the bottom the dock takes when it is out (tiles + glass + gap).
fn dock_room(h) {
    return dock_size(h) + 16.0 + floor(dock_size(h) / 2.0) + 10.0
}

# 0 = tucked away below the screen edge, 1 = out; animated in the main loop.
fn dock_y(h) {
    bind slide = floor((1.0 - st_get("dock_vis", 0.0)) * (dock_room(h) + 40.0))
    return h - dock_size(h) - floor(dock_size(h) / 2.0) + slide
}

# Windows stay above the dock while it is out: pushed up, never under it.
fn win_key(name) {
    if name == "packages" { return "pk" }
    if name == "viewer" { return "view" }
    if name == "settings" { return "set" }
    return name
}

fn keep_windows_clear(h) {
    bind lim = dock_y(h) - 12.0
    bind i = 0.0
    while i < len(WIN_NAMES) {
        bind n = list_get(WIN_NAMES, i)
        if win_open(n) {
            bind r = win_rect(n)
            bind wy = list_get(r, 1.0)
            bind wh = list_get(r, 3.0)
            if wy + wh > lim { st_set(win_key(n) + "_y", max(TOP_H + 1.0, lim - wh)) }
        }
        bind i = i + 1.0
    }
    return 0.0
}

fn dock_at(mx, my, w, h) {
    if st_get("dock_vis", 0.0) < 0.9 { return 0.0 - 1.0 }
    bind sz = dock_size(h)
    bind i = 0.0
    while i < len(APP_GLYPH) {
        if inside(mx, my, dock_x(i, w, h), dock_y(h), sz, sz) { return i }
        bind i = i + 1.0
    }
    return 0.0 - 1.0
}

fn dock(w, h, mx, my) {
    if st_get("dock_vis", 0.0) < 0.02 {
        # a hairline handle where the dock will slide out
        px_rect(floor(w / 2.0) - 40.0, h - 3.0, 80.0, 2.0, C_BORDER)
        return 0.0
    }
    bind sz = dock_size(h)
    bind n = len(APP_GLYPH)
    bind x0 = dock_x(0.0, w, h)
    bind xn = dock_x(n - 1.0, w, h)
    bind dy = dock_y(h)
    px_rrect(x0 - 12.0, dy - 8.0, xn + sz + 12.0 - (x0 - 12.0), sz + 16.0, 14.0, C_DOCK, 0.59)
    bind hover = dock_at(mx, my, w, h)
    bind ksel = st_get("dock_sel", 0.0 - 1.0)
    bind i = 0.0
    while i < n {
        bind dx = dock_x(i, w, h)
        bind hot = hover == i || (ksel == i && st_get("menu", 0.0) < 0.5)
        if hot { px_rrect(dx - 3.0, dy - 3.0, sz + 6.0, sz + 6.0, 12.0, accent()) }
        px_rrect(dx, dy, sz, sz, 10.0, C_PANEL)
        bind g = list_get(APP_GLYPH, i)
        bind gs = sel(sz >= 48.0, 3.0, 2.0)
        px_text8(dx + (sz - len(g) * 8.0 * gs) / 2.0, dy + (sz - 8.0 * gs) / 2.0, C_TEXT, g, gs)
        bind kind = list_get(APP_KIND, i)
        if (kind == "about" && st_get("about", 0.0) > 0.5) || list_has(running_entries(), kind) {
            px_disc(dx + sz / 2.0, dy + sz + 7.0, 3.0, sel(kind == "about", accent(), C_GOOD))
        }
        bind i = i + 1.0
    }
    bind tip_i = sel(hover >= 0.0, hover, sel(st_get("menu", 0.0) < 0.5, ksel, 0.0 - 1.0))
    if tip_i >= 0.0 {
        bind tip = list_get(APP_LABEL, tip_i)
        bind tw = len(tip) * 8.0 + 16.0
        bind tx = dock_x(tip_i, w, h) + sz / 2.0 - tw / 2.0
        px_rrect(tx, dy - 36.0, tw, 22.0, 6.0, C_PANEL)
        px_rrect_outline(tx, dy - 36.0, tw, 22.0, 6.0, C_BORDER)
        t8(tx + 8.0, dy - 29.0, C_TEXT, tip)
    }
}

fn status_line(h) {
    # The x86 desktop's bottom-left network line.
    bind ip = os_info("ip")
    bind msg = sel(ip == "", "net: none (plug in Ethernet, console: dhcp)", "net: " + ip)
    if wifi_joined() { bind msg = "wifi " + wifi_ssid() + sel(ip == "", " (no address yet)", ": " + ip) }
    px_rect(6.0, h - 22.0, len(msg) * 8.0 + 8.0, 16.0, C_DOCK)
    t8(10.0, h - 18.0, C_DIM, msg)
}

# ── Applications menu ────────────────────────────────────────────────────────

# The menu's rows: the built-ins, then every installed runnable package.
fn menu_rows() {
    bind pk = st_get("pkgs", [])
    if len(pk) < 0.5 { return MENU_ROWS }
    bind rows = list_push(MENU_ROWS, "#Installed")
    bind i = 0.0
    while i < len(pk) {
        bind rows = list_push(rows, num_str(len(APP_KIND) + i))
        bind i = i + 1.0
    }
    return rows
}

fn app_label(i) {
    if i < len(APP_LABEL) { return list_get(APP_LABEL, i) }
    return list_get(st_get("pkgs", []), i - len(APP_LABEL))
}

fn menu_h() {
    return len(menu_rows()) * MENU_ROW_H + 30.0
}

fn menu_row_at(mx, my) {
    if !inside(mx, my, 6.0, 31.0, MENU_W, menu_h()) { return 0.0 - 1.0 }
    bind rows = menu_rows()
    bind r = floor((my - 53.0) / MENU_ROW_H)
    if r < 0.0 || r >= len(rows) { return 0.0 - 1.0 }
    bind v = list_get(rows, r)
    if str_starts_with(v, "#") { return 0.0 - 1.0 }
    return to_number(v)
}

fn apps_menu(mx, my) {
    bind rx = 6.0
    bind ry = 31.0
    bind rh = menu_h()
    px_rrect(rx + 4.0, ry + 5.0, MENU_W, rh, 10.0, 0.0, 0.31)
    px_rrect(rx, ry, MENU_W, rh, 10.0, C_BORDER)
    px_rrect(rx + 1.0, ry + 1.0, MENU_W - 2.0, rh - 2.0, 9.0, C_PANEL)
    t8(rx + 12.0, ry + 8.0, accent(), "Applications")
    bind hover = menu_row_at(mx, my)
    if hover >= 0.0 { st_set("menu_sel", hover) }
    bind msel = st_get("menu_sel", 0.0)
    bind rows = menu_rows()
    bind r = 0.0
    while r < len(rows) {
        bind yy = ry + 22.0 + r * MENU_ROW_H
        bind v = list_get(rows, r)
        if str_starts_with(v, "#") {
            t8(rx + 10.0, yy + 7.0, C_DIM, str_replace(v, "#", ""))
        } else {
            bind ai = to_number(v)
            if ai == msel {
                px_rrect(rx + 4.0, yy + 2.0, MENU_W - 8.0, MENU_ROW_H - 3.0, 5.0, accent())
                t8(rx + 24.0, yy + 7.0, C_PANEL, app_label(ai))
            } else {
                t8(rx + 24.0, yy + 7.0, C_TEXT, app_label(ai))
            }
        }
        bind r = r + 1.0
    }
}

# ── About window (x86 window chrome) ─────────────────────────────────────────

fn window_frame(x, y, ww, wh, title, focused) {
    px_rrect(x + 4.0, y + 6.0, ww, wh, 7.0, 0.0, 0.35)
    px_rrect(x, y, ww, wh, 7.0, sel(focused, accent(), C_BORDER))
    px_rrect(x + 1.0, y + 1.0, ww - 2.0, wh - 2.0, 6.0, C_PANEL)
    bind tbc = sel(focused, C_TITLE, C_TITLE_IDLE)
    px_rrect(x + 1.0, y + 1.0, ww - 2.0, TB, 6.0, tbc)
    px_rect(x + 1.0, y + TB - 6.0, ww - 2.0, 6.0, tbc)
    px_rect(x + 1.0, y + TB, ww - 2.0, 1.0, sel(focused, accent(), C_BORDER))
    t8(x + 12.0, y + 11.0, sel(focused, C_STRONG, C_DIM), title)
    bind cy = y + TB / 2.0
    px_disc(x + ww - 2.0 * TB - TB / 2.0, cy, 5.0, 5947498.0)
    px_disc(x + ww - TB - TB / 2.0, cy, 5.0, 14721098.0)
    px_disc(x + ww - TB / 2.0, cy, 5.0, 14704730.0)
}

fn about_window() {
    bind x = st_get("about_x", 0.0)
    bind y = st_get("about_y", 0.0)
    window_frame(x, y, ABOUT_W, ABOUT_H, "About LingOS", st_get("focus", "") == "about")
    bind cx = x + 16.0
    bind cy = y + TB + 14.0
    t8(cx, cy, accent(), "LingOS")
    t8(cx, cy + 18.0, C_TEXT, "a from-scratch OS written in Ling")
    t8(cx, cy + 44.0, C_DIM, "uptime: " + uptime_words())
    t8(cx, cy + 62.0, C_DIM, "theme:")
    t8(cx + 64.0, cy + 62.0, C_TEXT, "LingStation look, " + list_get(ACCENT_NAMES, st_get("accent", 4.0)) + " accent")
    bind rows = ["board", "memory", "display", "mouse", "keyboard", "network"]
    bind i = 0.0
    while i < len(rows) {
        bind k = list_get(rows, i)
        t8(cx, cy + 90.0 + i * 18.0, C_DIM, k + ":")
        t8(cx + 96.0, cy + 90.0 + i * 18.0, C_TEXT, os_info(k))
        bind i = i + 1.0
    }
    t8(cx, y + ABOUT_H - 22.0, C_DIM, "drag titlebar; dock launches; arrows+enter")
}

# ── Files ────────────────────────────────────────────────────────────────────
# The signed-in user's home (home/<user>, the standard folders first in their
# fixed order), entries with the same icons as the x86 Files window, folders
# open in place, pictures (BMP/PNG/SVG) and text (.txt/.md/.ling...) open in a
# viewer window. On the Pi the home is built into the image (read-only) until
# LingOS can read the SD card.

fn home_dir() {
    return "home/" + os_user()
}

fn ext_of(name) {
    bind parts = str_split(str_lower(name), ".")
    if len(parts) < 2.0 { return "" }
    return list_get(parts, len(parts) - 1.0)
}

fn file_kind(name) {
    bind e = ext_of(name)
    if e == "bmp" || e == "png" || e == "svg" { return "picture" }
    if e == "wav" || e == "mp3" || e == "ogg" || e == "flac" || e == "mid" { return "audio" }
    if e == "mp4" || e == "mkv" || e == "webm" || e == "avi" || e == "mov" || e == "gif" { return "video" }
    if e == "obj" || e == "stl" || e == "glb" || e == "gltf" || e == "ply" { return "model" }
    return "text"
}

# Current folder as a flat [name, is_dir]* list, home folders first.
fn files_items() {
    bind dir = st_get("fdir", home_dir())
    bind raw = fs_list(dir)
    bind out = []
    bind n = len(raw) / 3.0
    if dir == home_dir() {
        bind hf = os_home_folders()
        bind k = 0.0
        while k < len(hf) {
            bind i = 0.0
            while i < n {
                if list_get(raw, i * 3.0) == list_get(hf, k) && list_get(raw, i * 3.0 + 1.0) > 0.5 {
                    bind out = list_push(out, list_get(hf, k))
                    bind out = list_push(out, 1.0)
                }
                bind i = i + 1.0
            }
            bind k = k + 1.0
        }
    }
    bind i = 0.0
    while i < n {
        bind nm = list_get(raw, i * 3.0)
        bind isd = list_get(raw, i * 3.0 + 1.0)
        bind skip = false
        if dir == home_dir() && isd > 0.5 {
            bind hf2 = os_home_folders()
            bind k2 = 0.0
            while k2 < len(hf2) {
                if list_get(hf2, k2) == nm { bind skip = true }
                bind k2 = k2 + 1.0
            }
        }
        if !skip {
            bind out = list_push(out, nm)
            bind out = list_push(out, isd)
        }
        bind i = i + 1.0
    }
    return out
}

fn files_open_win(w, h) {
    st_set("files", 1.0)
    st_set("fdir", home_dir())
    st_set("fsel", 0.0)
    st_set("fscroll", 0.0)
    st_set("fmsg", "")
    st_set("files_x", floor((w - FILES_W) / 2.0) - 60.0)
    st_set("files_y", floor((h - FILES_H) / 2.0) - 40.0)
    win_raise("files")
}

fn files_rows() {
    return floor((FILES_H - TB - 74.0) / ROW_H)
}

fn files_activate(i) {
    bind items = files_items()
    if i < 0.0 || i * 2.0 >= len(items) { return 0.0 }
    bind nm = list_get(items, i * 2.0)
    bind dir = st_get("fdir", home_dir())
    bind full = files_join(dir, nm)
    if list_get(items, i * 2.0 + 1.0) > 0.5 {
        st_set("fdir", full)
        st_set("fsel", 0.0)
        st_set("fscroll", 0.0)
        st_set("fmsg", "")
        return 0.0
    }
    if str_ends_with(nm, ".ling") {
        # Scripts run in the console (`ling run <file>`), like the x86 Terminal;
        # graphics programs open their own window, Esc / Ctrl+Q returns.
        os_console("ling run " + full)
        return 0.0
    }
    bind k = file_kind(nm)
    if k == "audio" {
        st_set("fmsg", "sound needs an audio driver on the Pi -- not yet")
        return 0.0
    }
    if k == "video" {
        st_set("fmsg", "video playback isn't available yet (no video codec)")
        return 0.0
    }
    st_set("viewer", full)
    st_set("viewer_kind", sel(k == "picture", "picture", "text"))
    st_set("view_x", st_get("files_x", 100.0) + 80.0)
    st_set("view_y", st_get("files_y", 80.0) + 40.0)
    win_raise("viewer")
    return 0.0
}

fn files_join(dir, name) {
    if dir == "" { return name }
    return dir + "/" + name
}

# The selected entry's full path ("" with nothing selected).
fn files_sel_path() {
    bind items = files_items()
    bind i = st_get("fsel", 0.0)
    if i < 0.0 || i * 2.0 >= len(items) { return "" }
    return files_join(st_get("fdir", home_dir()), list_get(items, i * 2.0))
}

fn files_up() {
    bind dir = st_get("fdir", home_dir())
    if dir == "" { return 0.0 }
    bind parts = str_split(dir, "/")
    if len(parts) <= 1.0 {
        # above the top folder: the root (home/, media/ for USB drives, ...)
        st_set("fdir", "")
        st_set("fsel", 0.0)
        st_set("fscroll", 0.0)
        st_set("fmsg", "")
        return 0.0
    }
    bind up = ""
    bind i = 0.0
    while i < len(parts) - 1.0 {
        bind up = sel(up == "", list_get(parts, i), up + "/" + list_get(parts, i))
        bind i = i + 1.0
    }
    st_set("fdir", up)
    st_set("fsel", 0.0)
    st_set("fscroll", 0.0)
    st_set("fmsg", "")
    return 0.0
}

fn files_window(mx, my) {
    bind x = st_get("files_x", 0.0)
    bind y = st_get("files_y", 0.0)
    window_frame(x, y, FILES_W, FILES_H, "Files", st_get("focus", "") == "files")
    bind cx = x + 16.0
    bind cy = y + TB + 12.0
    bind dir = st_get("fdir", home_dir())
    t8(cx, cy, accent(), sel(dir == "", "/", dir))
    t8(x + FILES_W - 72.0, cy, C_DIM, "[ up ]")
    bind items = files_items()
    bind n = len(items) / 2.0
    if n < 0.5 { t8(cx, cy + 26.0, C_DIM, "(empty)") }
    bind rows = files_rows()
    bind sc = st_get("fscroll", 0.0)
    bind fsel = st_get("fsel", 0.0)
    bind r = 0.0
    while r < rows && sc + r < n {
        bind i = sc + r
        bind ry = cy + 22.0 + r * ROW_H
        if i == fsel {
            px_rrect(cx - 4.0, ry - 4.0, FILES_W - 24.0, ROW_H - 4.0, 5.0, accent(), 0.35)
            px_rrect_outline(cx - 4.0, ry - 4.0, FILES_W - 24.0, ROW_H - 4.0, 5.0, accent())
        } else if inside(mx, my, cx - 4.0, ry - 4.0, FILES_W - 24.0, ROW_H - 4.0) {
            px_rrect(cx - 4.0, ry - 4.0, FILES_W - 24.0, ROW_H - 4.0, 5.0, C_TITLE)
        }
        os_file_icon(cx + 2.0, ry - 2.0, list_get(items, i * 2.0), list_get(items, i * 2.0 + 1.0) > 0.5)
        t8(cx + 28.0, ry + 2.0, C_TEXT, list_get(items, i * 2.0))
        bind r = r + 1.0
    }
    if st_get("fmsg", "") != "" { t8(cx, y + FILES_H - 40.0, 14721098.0, st_get("fmsg", "")) }
    t8(cx, y + FILES_H - 22.0, C_DIM, "enter: open  backspace: up  h: home  c/x: copy/cut  v: paste  Del: delete")
}

fn files_row_at(mx, my) {
    bind x = st_get("files_x", 0.0)
    bind y = st_get("files_y", 0.0)
    bind cx = x + 16.0
    bind cy = y + TB + 12.0
    bind n = len(files_items()) / 2.0
    bind r = 0.0
    while r < files_rows() {
        bind i = st_get("fscroll", 0.0) + r
        if i < n && inside(mx, my, cx - 4.0, cy + 18.0 + r * ROW_H, FILES_W - 24.0, ROW_H - 4.0) { return i }
        bind r = r + 1.0
    }
    return 0.0 - 1.0
}

fn files_keep_visible() {
    bind sc = st_get("fscroll", 0.0)
    bind fsel = st_get("fsel", 0.0)
    if fsel < sc { st_set("fscroll", fsel) }
    if fsel >= sc + files_rows() { st_set("fscroll", fsel - files_rows() + 1.0) }
}

# ── Packages window (lingfu over fu.ling-lang.org) ───────────────────────────
# Rows come from lingfu_catalog(): name, meta, description, installed, app,
# mentions LingOS, fits this machine. The default tab shows LingOS apps for
# this machine (a package says so in its description); Tab shows everything.

fn pk_open(w, h) {
    st_set("pkgs_win", 1.0)
    st_set("pk_x", floor((w - PK_W) / 2.0) + 40.0)
    st_set("pk_y", max(TOP_H + 8.0, floor((h - PK_H) / 2.0) - 20.0))
    win_raise("packages")
    st_set("pk_sel", 0.0)
    st_set("pk_scroll", 0.0)
    st_set("pk_msg", "fetching the catalog from fu.ling-lang.org...")
    st_set("pk_load", 1.0)
}

fn pk_refresh() {
    bind items = lingfu_catalog()
    st_set("pk_items", items)
    bind n = len(items) / PK_F
    if n < 0.5 {
        st_set("pk_msg", "no catalog: is the network up? (console: net, dhcp)")
    } else {
        st_set("pk_msg", num_str(n) + " packages on fu.ling-lang.org")
    }
    st_set("pkgs", os_packages())
}

fn pk_visible() {
    bind items = st_get("pk_items", [])
    bind n = len(items) / PK_F
    bind all = st_get("pk_tab", 0.0) > 0.5
    bind out = []
    bind i = 0.0
    while i < n {
        if all || (list_get(items, i * PK_F + 5.0) > 0.5 && list_get(items, i * PK_F + 6.0) > 0.5) {
            bind out = list_push(out, i)
        }
        bind i = i + 1.0
    }
    return out
}

fn pk_rows() {
    return floor((PK_H - TB - 92.0) / PK_ROW)
}

fn pk_window(mx, my) {
    bind x = st_get("pk_x", 0.0)
    bind y = st_get("pk_y", 0.0)
    window_frame(x, y, PK_W, PK_H, "Packages -- lingfu on " + os_platform(), st_get("focus", "") == "packages")
    bind cx = x + 16.0
    bind cy = y + TB + 12.0
    bind tab = st_get("pk_tab", 0.0)
    t8(cx, cy, sel(tab < 0.5, accent(), C_DIM), "[ LingOS apps ]")
    t8(cx + 136.0, cy, sel(tab > 0.5, accent(), C_DIM), "[ all packages ]")
    t8(x + PK_W - 92.0, cy, C_DIM, "[ resync ]")
    bind items = st_get("pk_items", [])
    bind vis = pk_visible()
    bind n = len(vis)
    if n < 0.5 {
        t8(cx, cy + 26.0, C_DIM, sel(len(items) < 0.5, "(no catalog yet)", "(no package calls itself a LingOS app for this machine -- Tab shows all)"))
    }
    bind rows = pk_rows()
    bind sc = st_get("pk_scroll", 0.0)
    bind psel = st_get("pk_sel", 0.0)
    bind r = 0.0
    while r < rows && sc + r < n {
        bind vi = sc + r
        bind i = list_get(vis, vi)
        bind ry = cy + 24.0 + r * PK_ROW
        if vi == psel {
            px_rrect(cx - 4.0, ry - 4.0, PK_W - 24.0, PK_ROW - 4.0, 5.0, accent(), 0.35)
            px_rrect_outline(cx - 4.0, ry - 4.0, PK_W - 24.0, PK_ROW - 4.0, 5.0, accent())
        } else if inside(mx, my, cx - 4.0, ry - 4.0, PK_W - 24.0, PK_ROW - 4.0) {
            px_rrect(cx - 4.0, ry - 4.0, PK_W - 24.0, PK_ROW - 4.0, 5.0, C_TITLE)
        }
        bind nm = list_get(items, i * PK_F)
        bind meta = list_get(items, i * PK_F + 1.0)
        bind inst = list_get(items, i * PK_F + 3.0) > 0.5
        bind isapp = list_get(items, i * PK_F + 4.0) > 0.5
        t8(cx + 2.0, ry, C_TEXT, nm)
        t8(cx + 2.0 + (str_len(nm) + 1.0) * 8.0, ry, C_DIM, meta)
        bind badge = sel(inst, sel(isapp, "installed - app (enter runs)", "installed"), sel(list_get(items, i * PK_F + 5.0) > 0.5, "LingOS", ""))
        t8(x + PK_W - 16.0 - str_len(badge) * 8.0, ry, sel(inst, 5947498.0, accent()), badge)
        bind desc = list_get(items, i * PK_F + 2.0)
        bind maxc = floor((PK_W - 40.0) / 8.0)
        t8(cx + 2.0, ry + 11.0, C_DIM, sel(str_len(desc) > maxc, str_slice(desc, 0.0, maxc - 3.0) + "...", desc))
        bind r = r + 1.0
    }
    t8(cx, y + PK_H - 42.0, 14721098.0, st_get("pk_msg", ""))
    t8(cx, y + PK_H - 22.0, C_DIM, "enter: install / run   tab: apps|all   s: resync   esc: close")
}

fn pk_row_at(mx, my) {
    bind x = st_get("pk_x", 0.0)
    bind y = st_get("pk_y", 0.0)
    bind cx = x + 16.0
    bind cy = y + TB + 12.0
    bind n = len(pk_visible())
    bind r = 0.0
    while r < pk_rows() {
        bind i = st_get("pk_scroll", 0.0) + r
        if i < n && inside(mx, my, cx - 4.0, cy + 20.0 + r * PK_ROW, PK_W - 24.0, PK_ROW - 4.0) { return i }
        bind r = r + 1.0
    }
    return 0.0 - 1.0
}

fn pk_keep_visible() {
    bind sc = st_get("pk_scroll", 0.0)
    bind psel = st_get("pk_sel", 0.0)
    if psel < sc { st_set("pk_scroll", psel) }
    if psel >= sc + pk_rows() { st_set("pk_scroll", psel - pk_rows() + 1.0) }
}

# Enter on a row: run an installed app, else install the package (done after
# this frame is presented, so the window shows "installing" meanwhile).
fn pk_activate() {
    bind vis = pk_visible()
    bind psel = st_get("pk_sel", 0.0)
    if psel >= len(vis) { return 0.0 }
    bind items = st_get("pk_items", [])
    bind i = list_get(vis, psel)
    bind nm = list_get(items, i * PK_F)
    if list_get(items, i * PK_F + 3.0) > 0.5 && list_get(items, i * PK_F + 4.0) > 0.5 {
        os_app_run("ling:pkg-" + nm)
        return 0.0
    }
    st_set("pk_msg", "installing " + nm + " from fu.ling-lang.org...")
    st_set("pk_install", nm)
    return 0.0
}

fn viewer_window() {
    bind x = st_get("view_x", 0.0)
    bind y = st_get("view_y", 0.0)
    bind path = st_get("viewer", "")
    bind parts = str_split(path, "/")
    window_frame(x, y, VIEW_W, VIEW_H, list_get(parts, len(parts) - 1.0), st_get("focus", "") == "viewer")
    bind cx = x + 14.0
    bind cy = y + TB + 10.0
    if st_get("viewer_kind", "") == "picture" {
        px_rect(cx, cy, VIEW_W - 28.0, VIEW_H - TB - 24.0, 1183258.0)
        if !px_image(path, cx + 4.0, cy + 4.0, VIEW_W - 36.0, VIEW_H - TB - 32.0) {
            t8(cx + 8.0, cy + 8.0, C_DIM, "couldn't decode this picture")
        }
    } else {
        bind lines = str_split(read_file(path), "\n")
        bind maxl = floor((VIEW_H - TB - 24.0) / 14.0)
        bind i = 0.0
        while i < len(lines) && i < maxl {
            t8(cx, cy + i * 14.0, C_TEXT, list_get(lines, i))
            bind i = i + 1.0
        }
    }
}

# ── Wi-Fi ────────────────────────────────────────────────────────────────────
# Pick a network: wifi_scan() gives "ssid<TAB>dBm<TAB>security<TAB>channel" rows
# (strongest first; a single "!reason" row when the radio cannot scan), Enter on
# a secured network asks for the passphrase, wifi_connect joins it (the radio
# firmware's own WPA2 supplicant), remembers it for the next boot and leases an
# address. The scan and the join run after the frame is drawn (they block).

fn wifi_open(w, h) {
    st_set("wifi_win", 1.0)
    win_raise("wifi")
    st_set("wifi_x", floor((w - WIFI_W) / 2.0))
    st_set("wifi_y", floor((h - WIFI_H) / 2.0 - 30.0))
    st_set("wifi_mode", "list")
    st_set("wifi_sel", 0.0)
    if wifi_available() {
        st_set("wifi_msg", "scanning...")
        st_set("wifi_scan", 1.0)
    } else {
        st_set("wifi_msg", wifi_status())
        st_set("wifi_list", [])
    }
    return 0.0
}

fn wifi_field(row, k) {
    bind parts = str_split(row, "\t")
    if k < len(parts) { return list_get(parts, k) }
    return ""
}

fn wifi_rows() {
    bind l = st_get("wifi_list", [])
    if len(l) > 0.5 && str_starts_with(list_get(l, 0.0), "!") { return [] }
    return l
}

# Signal strength as four bars, coloured by how good it is (white on a selected row).
fn wifi_bars(x, y, dbm, on_sel) {
    bind lv = wifi_level(dbm)
    bind col = sel(lv >= 3.0, C_GOOD, sel(lv >= 2.0, C_WARN, C_BAD))
    if on_sel { bind col = C_TEXT }
    bind i = 0.0
    while i < 4.0 {
        px_rrect(x + i * 6.0, y + 14.0 - (i + 1.0) * 3.5, 4.0, (i + 1.0) * 3.5, 1.0, sel(i < lv, col, sel(on_sel, C_TITLE, C_BORDER)))
        bind i = i + 1.0
    }
    return 0.0
}

# A small padlock (secured networks).
fn wifi_lock(x, y, col) {
    px_ring(x + 4.0, y + 3.0, 3.0, 1.0, col)
    px_rrect(x, y + 4.0, 9.0, 7.0, 2.0, col)
    return 0.0
}

fn wifi_band(ch) {
    if ch > 14.0 { return "5 GHz" }
    return "2.4 GHz"
}

fn wifi_max_rows() {
    return floor((WIFI_H - TB - 12.0 - 96.0 - 62.0) / WIFI_ROW)
}

fn wifi_first_row() {
    bind rows = wifi_rows()
    bind maxr = wifi_max_rows()
    return max(0.0, min(st_get("wifi_sel", 0.0) - maxr + 1.0, len(rows) - maxr))
}

# Where the list starts (below the header card).
fn wifi_list_y() {
    return st_get("wifi_y", 0.0) + TB + 12.0 + 96.0
}

# A pill button; returns whether the pointer is over it.
fn wifi_pill(x, y, bw, label, mx, my, primary) {
    bind hot = inside(mx, my, x, y, bw, 26.0)
    bind bg = sel(primary, accent(), C_TITLE)
    if hot { bind bg = sel(primary, 6065648.0, C_BORDER) }
    px_rrect(x, y, bw, 26.0, 13.0, bg)
    t8(x + floor((bw - len(label) * 8.0) / 2.0), y + 9.0, sel(primary, C_PANEL, C_TEXT), label)
    return hot
}

# Button rectangles [x, y, w] by name, for drawing and for clicks.
fn wifi_btn(name) {
    bind x = st_get("wifi_x", 0.0)
    bind y = st_get("wifi_y", 0.0)
    bind by = y + WIFI_H - 46.0
    if name == "connect" { return [x + 16.0, by, 108.0] }
    if name == "rescan" { return [x + 134.0, by, 96.0] }
    if name == "forget" { return [x + 240.0, by, 96.0] }
    if name == "header" { return [x + WIFI_W - 16.0 - 108.0, y + TB + 12.0 + 19.0, 108.0] }
    if name == "pass_ok" { return [x + WIFI_W - 28.0 - 108.0, y + WIFI_H - 86.0 + 32.0, 108.0] }
    return [0.0, 0.0, 0.0]
}

fn wifi_window(mx, my) {
    bind x = st_get("wifi_x", 0.0)
    bind y = st_get("wifi_y", 0.0)
    bind focused = st_get("focus", "") == "wifi"
    window_frame(x, y, WIFI_W, WIFI_H, "Wi-Fi networks", focused)
    bind joined = wifi_available() && wifi_joined()
    bind msg = st_get("wifi_msg", "")

    # Header card: the connection you have (or not), and a Rescan / Disconnect button.
    bind hy = y + TB + 12.0
    px_rrect(x + 12.0, hy, WIFI_W - 24.0, 64.0, 8.0, C_DOCK)
    px_rect(x + 12.0, hy + 8.0, 3.0, 48.0, sel(joined, C_GOOD, C_BORDER))
    bind lv = sel(joined, wifi_level(wifi_signal()), 0.0)
    bind i = 0.0
    while i < 4.0 {
        px_rrect(x + 30.0 + i * 9.0, hy + 44.0 - (i + 1.0) * 7.0, 6.0, (i + 1.0) * 7.0, 2.0, sel(i < lv, C_GOOD, C_BORDER))
        bind i = i + 1.0
    }
    if !wifi_available() {
        t8(x + 76.0, hy + 16.0, C_TEXT, "No Wi-Fi radio on this board")
        t8(x + 76.0, hy + 36.0, C_DIM, "Raspberry Pi 5 only")
    } else if joined {
        t8(x + 76.0, hy + 16.0, C_TEXT, "Connected to " + wifi_ssid())
        bind ip = os_info("ip")
        t8(x + 76.0, hy + 36.0, C_DIM, num_str(wifi_signal()) + " dBm   " + sel(ip == "", "getting an address...", ip))
    } else {
        t8(x + 76.0, hy + 16.0, C_TEXT, "Not connected")
        t8(x + 76.0, hy + 36.0, C_DIM, sel(msg == "", "pick a network below", str_slice(msg, 0.0, 44.0)))
    }
    bind hb = wifi_btn("header")
    if wifi_available() { wifi_pill(list_get(hb, 0.0), list_get(hb, 1.0), list_get(hb, 2.0), sel(joined, "Disconnect", "Rescan"), mx, my, false) }

    # The list
    bind rows = wifi_rows()
    bind l = st_get("wifi_list", [])
    t8(x + 16.0, hy + 78.0, C_DIM, sel(st_get("wifi_scan", 0.0) > 0.5, "SCANNING...", "AVAILABLE NETWORKS" + sel(len(rows) > 0.5, "  " + num_str(len(rows)), "")))
    bind ly = wifi_list_y()
    if len(rows) < 0.5 {
        bind why = sel(st_get("wifi_scan", 0.0) > 0.5, "looking for networks...", "none found yet -- Rescan")
        if len(l) > 0.5 { bind why = str_replace(list_get(l, 0.0), "!", "") }
        px_rrect(x + 12.0, ly, WIFI_W - 24.0, 32.0, 6.0, C_DOCK)
        t8(x + 24.0, ly + 12.0, C_DIM, why)
    }
    bind sel_i = st_get("wifi_sel", 0.0)
    bind maxr = wifi_max_rows()
    bind first = wifi_first_row()
    bind i = first
    while i < len(rows) && i < first + maxr {
        bind row = list_get(rows, i)
        bind ry = ly + (i - first) * WIFI_ROW
        bind on = i == sel_i
        bind hot = inside(mx, my, x + 12.0, ry, WIFI_W - 24.0, 32.0)
        px_rrect(x + 12.0, ry, WIFI_W - 24.0, 32.0, 6.0, sel(on, accent(), sel(hot, C_TITLE, C_DOCK)))
        bind fg = sel(on, C_PANEL, C_TEXT)
        bind dim = sel(on, C_PANEL, C_DIM)
        wifi_bars(x + 24.0, ry + 8.0, to_number(wifi_field(row, 1.0)), on)
        bind ssid = wifi_field(row, 0.0)
        bind name = ssid
        if len(name) > 28.0 { bind name = str_slice(name, 0.0, 26.0) + ".." }
        t8(x + 58.0, ry + 12.0, fg, name)
        bind secu = wifi_field(row, 2.0)
        bind ch = to_number(wifi_field(row, 3.0))
        bind pw = len(secu) * 8.0 + 14.0
        bind pxr = x + WIFI_W - 24.0 - pw
        px_rrect(pxr, ry + 7.0, pw, 18.0, 9.0, sel(on, 6065648.0, C_TITLE))
        t8(pxr + 7.0, ry + 12.0, sel(on, C_TEXT, C_DIM), secu)
        if secu != "open" { wifi_lock(pxr - 16.0, ry + 10.0, dim) }
        bind chs = "ch " + num_str(ch) + "  " + wifi_band(ch)
        t8(pxr - 30.0 - len(chs) * 8.0, ry + 12.0, dim, chs)
        if joined && ssid == wifi_ssid() {
            px_disc(x + 58.0 + len(name) * 8.0 + 10.0, ry + 16.0, 3.0, sel(on, C_TEXT, C_GOOD))
            t8(x + 58.0 + len(name) * 8.0 + 18.0, ry + 12.0, sel(on, C_TEXT, C_GOOD), "connected")
        }
        bind i = i + 1.0
    }
    # scroll hint
    if len(rows) > maxr {
        bind track = maxr * WIFI_ROW - 4.0
        bind knob = max(20.0, track * maxr / len(rows))
        bind ky = ly + (track - knob) * first / max(1.0, len(rows) - maxr)
        px_rrect(x + WIFI_W - 9.0, ly, 3.0, track, 1.5, C_BORDER)
        px_rrect(x + WIFI_W - 9.0, ky, 3.0, knob, 1.5, C_DIM)
    }

    # Bottom: the passphrase prompt, or the buttons
    if st_get("wifi_mode", "") == "pass" {
        bind by = y + WIFI_H - 86.0
        px_rrect(x + 12.0, by, WIFI_W - 24.0, 72.0, 8.0, C_DOCK)
        t8(x + 24.0, by + 10.0, C_TEXT, "Password for " + st_get("wifi_ssid", ""))
        bind fw = WIFI_W - 48.0 - 124.0
        px_rrect(x + 24.0, by + 30.0, fw, 30.0, 6.0, C_PANEL)
        px_rrect_outline(x + 24.0, by + 30.0, fw, 30.0, 6.0, accent())
        bind dots = ""
        bind k = 0.0
        while k < str_len(st_get("wifi_pass", "")) {
            bind dots = dots + "*"
            bind k = k + 1.0
        }
        if len(dots) > 48.0 { bind dots = str_slice(dots, len(dots) - 48.0, 48.0) }
        bind caret = sel(floor(os_uptime() * 2.0) - floor(os_uptime()) * 2.0 < 0.5, "_", " ")
        t8(x + 34.0, by + 41.0, C_TEXT, dots + caret)
        bind pb = wifi_btn("pass_ok")
        wifi_pill(list_get(pb, 0.0), list_get(pb, 1.0), list_get(pb, 2.0), "Connect", mx, my, true)
        t8(x + 16.0, y + WIFI_H - 10.0 - 8.0, C_DIM, "Enter: connect   Esc: back")
    } else {
        bind cb = wifi_btn("connect")
        bind rb = wifi_btn("rescan")
        bind fb = wifi_btn("forget")
        if wifi_available() {
            wifi_pill(list_get(cb, 0.0), list_get(cb, 1.0), list_get(cb, 2.0), "Connect", mx, my, true)
            wifi_pill(list_get(rb, 0.0), list_get(rb, 1.0), list_get(rb, 2.0), "Rescan", mx, my, false)
            wifi_pill(list_get(fb, 0.0), list_get(fb, 1.0), list_get(fb, 2.0), "Forget", mx, my, false)
        }
        bind hint = "r: rescan   f: forget"
        t8(x + WIFI_W - 16.0 - len(hint) * 8.0, y + WIFI_H - 46.0 + 9.0, C_DIM, hint)
    }
}

fn wifi_row_at(mx, my) {
    bind x = st_get("wifi_x", 0.0)
    bind ly = wifi_list_y()
    bind maxr = wifi_max_rows()
    if !inside(mx, my, x + 12.0, ly, WIFI_W - 24.0, maxr * WIFI_ROW) { return 0.0 - 1.0 }
    bind rows = wifi_rows()
    bind r = floor((my - ly) / WIFI_ROW) + wifi_first_row()
    if r < 0.0 || r >= len(rows) { return 0.0 - 1.0 }
    if my - ly - (r - wifi_first_row()) * WIFI_ROW >= 32.0 { return 0.0 - 1.0 }
    return r
}

fn wifi_hit(mx, my, name) {
    bind b = wifi_btn(name)
    return inside(mx, my, list_get(b, 0.0), list_get(b, 1.0), list_get(b, 2.0), 26.0)
}

# A click inside the window body: buttons first, then the list.
fn wifi_click(mx, my) {
    if !wifi_available() { return 0.0 }
    if st_get("wifi_mode", "") == "pass" {
        if wifi_hit(mx, my, "pass_ok") {
            st_set("wifi_mode", "list")
            st_set("wifi_msg", "joining " + st_get("wifi_ssid", "") + "...")
            st_set("wifi_join", 1.0)
        }
        return 0.0
    }
    if wifi_hit(mx, my, "header") {
        if wifi_joined() {
            wifi_disconnect()
            st_set("wifi_msg", "disconnected")
        } else {
            st_set("wifi_msg", "scanning...")
            st_set("wifi_scan", 1.0)
        }
        return 0.0
    }
    if wifi_hit(mx, my, "connect") {
        wifi_activate()
        return 0.0
    }
    if wifi_hit(mx, my, "rescan") {
        st_set("wifi_msg", "scanning...")
        st_set("wifi_scan", 1.0)
        return 0.0
    }
    if wifi_hit(mx, my, "forget") {
        wifi_forget()
        st_set("wifi_msg", "forgot the saved network")
        return 0.0
    }
    bind wi = wifi_row_at(mx, my)
    if wi >= 0.0 {
        bind now = os_uptime()
        if wi == st_get("wifi_sel", 0.0) && now - st_get("wclick_t", 0.0) < 0.45 {
            wifi_activate()
            st_set("wclick_t", 0.0)
        } else {
            st_set("wifi_sel", wi)
            st_set("wclick_t", now)
        }
    }
    return 0.0
}

# Enter on a network: open ones join at once, secured ones ask for the passphrase.
fn wifi_activate() {
    bind rows = wifi_rows()
    bind i = st_get("wifi_sel", 0.0)
    if i < 0.0 || i >= len(rows) { return 0.0 }
    bind row = list_get(rows, i)
    st_set("wifi_ssid", wifi_field(row, 0.0))
    st_set("wifi_pass", "")
    if wifi_field(row, 2.0) == "open" {
        st_set("wifi_msg", "joining " + st_get("wifi_ssid", "") + "...")
        st_set("wifi_join", 1.0)
    } else {
        st_set("wifi_mode", "pass")
        text_poll()
    }
    return 0.0
}

# Typed passphrase characters (the kernel hands out what was typed since the last poll).
fn wifi_type() {
    bind pend = text_poll()
    bind buf = st_get("wifi_pass", "")
    if key_pressed("backspace") && str_len(buf) > 0.0 { bind buf = str_slice(buf, 0.0, str_len(buf) - 1.0) }
    bind ok_chars = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    bind i = 0.0
    while i < str_len(pend) {
        bind ch = str_slice(pend, i, 1.0)
        if str_find(ok_chars, ch) >= 0.0 { bind buf = buf + ch }
        bind i = i + 1.0
    }
    st_set("wifi_pass", buf)
    return 0.0
}

# ── Wi-Fi tray ──────────────────────────────────────────────────────────────
# A signal icon in the top bar (`w` with nothing focused, or a click, opens
# it): the joined network with its signal and address, Disconnect / Forget /
# Settings, and the networks the last scan saw -- click one to join (secured
# ones ask for the passphrase in the Wi-Fi window).
bind TRAY_W = 310.0

fn tray_wifi_x(w) {
    return tray_sound_x(w) - 36.0
}

fn wifi_level(dbm) {
    if dbm >= 0.0 - 55.0 { return 4.0 }
    if dbm >= 0.0 - 65.0 { return 3.0 }
    if dbm >= 0.0 - 75.0 { return 2.0 }
    return 1.0
}

fn bars(x, y, level, on_col, off_col) {
    bind i = 0.0
    while i < 4.0 {
        px_rect(x + i * 5.0, y + 12.0 - (i + 1.0) * 3.0, 3.0, (i + 1.0) * 3.0, sel(i < level, on_col, off_col))
        bind i = i + 1.0
    }
    return 0.0
}

fn tray_wifi_icon(w) {
    bind x = tray_wifi_x(w)
    if st_get("tray_wifi", 0.0) > 0.5 { px_rrect(x - 6.0, 4.0, 32.0, 22.0, 5.0, C_TITLE) }
    if !wifi_available() {
        bars(x, 9.0, 0.0, accent(), C_BORDER)
        return 0.0
    }
    if wifi_joined() {
        bars(x, 9.0, wifi_level(wifi_signal()), accent(), C_BORDER)
    } else {
        bars(x, 9.0, 0.0, accent(), C_BORDER)
        px_disc(x + 18.0, 19.0, 3.0, 14704730.0)
    }
    return 0.0
}

fn tray_h() {
    return 118.0 + max(1.0, len(wifi_rows())) * 22.0 + 20.0
}

fn tray_rect(w) {
    bind x = min(tray_wifi_x(w) - 160.0, w - TRAY_W - 8.0)
    return [x, TOP_H + 6.0, TRAY_W, tray_h()]
}

fn tray_button(x, y, bw, label, mx, my) {
    bind hot = inside(mx, my, x, y, bw, 24.0)
    px_rrect(x, y, bw, 24.0, 6.0, sel(hot, accent(), C_TITLE))
    t8(x + floor((bw - len(label) * 8.0) / 2.0), y + 8.0, sel(hot, C_PANEL, C_TEXT), label)
    return 0.0
}

fn tray_wifi_popup(w, mx, my) {
    bind r = tray_rect(w)
    bind x = list_get(r, 0.0)
    bind y = list_get(r, 1.0)
    bind h = list_get(r, 3.0)
    px_rrect(x + 4.0, y + 5.0, TRAY_W, h, 10.0, 0.0, 0.31)
    px_rrect(x, y, TRAY_W, h, 10.0, C_BORDER)
    px_rrect(x + 1.0, y + 1.0, TRAY_W - 2.0, h - 2.0, 9.0, C_PANEL)
    bind cx = x + 14.0
    bind cy = y + 12.0
    if !wifi_available() {
        t8(cx, cy, C_TEXT, "Wi-Fi")
        t8(cx, cy + 22.0, C_DIM, "no Wi-Fi radio on this board")
        t8(cx, cy + 40.0, C_DIM, "(Raspberry Pi 5 only)")
        return 0.0
    }
    if wifi_joined() {
        bars(cx, cy + 2.0, wifi_level(wifi_signal()), accent(), C_BORDER)
        t8(cx + 28.0, cy, C_TEXT, wifi_ssid())
        t8(cx + 28.0, cy + 16.0, C_DIM, "connected  " + num_str(wifi_signal()) + " dBm  " + os_info("ip"))
    } else {
        bars(cx, cy + 2.0, 0.0, accent(), C_BORDER)
        t8(cx + 28.0, cy, C_TEXT, "Not connected")
        t8(cx + 28.0, cy + 16.0, C_DIM, str_slice(st_get("wifi_msg", "pick a network below"), 0.0, 32.0))
    }
    bind by = cy + 40.0
    tray_button(cx, by, 100.0, sel(wifi_joined(), "Disconnect", "Scan"), mx, my)
    tray_button(cx + 110.0, by, 100.0, "Forget", mx, my)
    tray_button(cx + 220.0, by, 70.0, "Settings", mx, my)
    px_rect(x + 10.0, by + 34.0, TRAY_W - 20.0, 1.0, C_BORDER)
    t8(cx, by + 42.0, C_DIM, sel(st_get("wifi_scan", 0.0) > 0.5, "scanning...", "Available networks"))
    bind rows = wifi_rows()
    bind ly = by + 60.0
    bind i = 0.0
    bind row = ""
    while i < len(rows) {
        bind row = list_get(rows, i)
        if inside(mx, my, x + 8.0, ly - 3.0, TRAY_W - 16.0, 22.0) { px_rrect(x + 8.0, ly - 3.0, TRAY_W - 16.0, 22.0, 5.0, C_TITLE) }
        bars(cx, ly + 2.0, wifi_level(to_number(wifi_field(row, 1.0))), accent(), C_BORDER)
        t8(cx + 28.0, ly + 2.0, sel(wifi_field(row, 0.0) == wifi_ssid(), accent(), C_TEXT), wifi_field(row, 0.0))
        t8(x + TRAY_W - 56.0, ly + 2.0, C_DIM, wifi_field(row, 2.0))
        bind ly = ly + 22.0
        bind i = i + 1.0
    }
    if len(rows) < 0.5 && st_get("wifi_scan", 0.0) < 0.5 { t8(cx, ly + 2.0, C_DIM, "none found - Scan again") }
    return 0.0
}

fn tray_wifi_click(mx, my, w, h) {
    bind r = tray_rect(w)
    bind x = list_get(r, 0.0)
    bind y = list_get(r, 1.0)
    bind cx = x + 14.0
    bind by = y + 12.0 + 40.0
    if !wifi_available() { return 0.0 }
    if inside(mx, my, cx, by, 100.0, 24.0) {
        if wifi_joined() {
            wifi_disconnect()
            st_set("wifi_msg", "disconnected")
        } else {
            st_set("wifi_msg", "scanning...")
            st_set("wifi_scan", 1.0)
        }
        return 0.0
    }
    if inside(mx, my, cx + 110.0, by, 100.0, 24.0) {
        wifi_forget()
        st_set("wifi_msg", "forgot the saved network")
        return 0.0
    }
    if inside(mx, my, cx + 220.0, by, 70.0, 24.0) {
        st_set("tray_wifi", 0.0)
        wifi_open(w, h)
        return 0.0
    }
    bind rows = wifi_rows()
    bind ly = by + 60.0
    bind i = 0.0
    while i < len(rows) {
        if inside(mx, my, x + 8.0, ly - 3.0, TRAY_W - 16.0, 22.0) {
            st_set("tray_wifi", 0.0)
            if wifi_field(list_get(rows, i), 2.0) != "open" {
                wifi_open(w, h)
                st_set("wifi_scan", 0.0)
            }
            st_set("wifi_sel", i)
            wifi_activate()
            return 0.0
        }
        bind ly = ly + 22.0
        bind i = i + 1.0
    }
    return 0.0
}

fn tray_wifi_toggle() {
    bind open = st_get("tray_wifi", 0.0) > 0.5
    st_set("tray_wifi", sel(open, 0.0, 1.0))
    st_set("menu", 0.0)
    if !open && wifi_available() && len(wifi_rows()) < 0.5 && st_get("wifi_scan", 0.0) < 0.5 {
        st_set("wifi_msg", "scanning...")
        st_set("wifi_scan", 1.0)
    }
    return 0.0
}

# ── actions ──────────────────────────────────────────────────────────────────

fn splash(w, h, msg) {
    wallpaper(w, h)
    bind tw = len(msg) * 16.0
    px_rrect((w - tw) / 2.0 - 24.0, h / 2.0 - 26.0, tw + 48.0, 52.0, 10.0, C_PANEL)
    px_text8((w - tw) / 2.0, h / 2.0 - 8.0, C_TEXT, msg, 2.0)
    present()
}

fn run_app(i, w, h) {
    st_set("menu", 0.0)
    if i >= len(APP_KIND) {
        # an installed lingfu package: `ling run pkg-<name>` in its own window
        bind nm = list_get(st_get("pkgs", []), i - len(APP_KIND))
        os_app_run("ling:pkg-" + nm)
        return 0.0
    }
    bind kind = list_get(APP_KIND, i)
    if kind == "packages" {
        pk_open(w, h)
        return 0.0
    }
    if kind == "files" {
        files_open_win(w, h)
        return 0.0
    }
    if kind == "about" {
        st_set("about", 1.0)
        st_set("about_x", floor((w - ABOUT_W) / 2.0))
        st_set("about_y", floor((h - ABOUT_H) / 2.0 - 40.0))
        return 0.0
    }
    if kind == "wifi" {
        wifi_open(w, h)
        return 0.0
    }
    if kind == "console" {
        os_console("")
        return 0.0
    }
    if str_starts_with(kind, "console:") {
        os_console(str_replace(kind, "console:", ""))
        return 0.0
    }
    if kind == "settings" {
        settings_open(w, h)
        return 0.0
    }
    # a built-in app is only there when its kernel target bundled it (rpi-lingstation / rpi-lingdev)
    bind app = str_replace(kind, "app:", "")
    if list_has(os_apps_running(), app) {
        os_app_resume(app)
        return 0.0
    }
    bind have = os_apps()
    bind found = false
    bind k = 0.0
    while k < len(have) {
        if list_get(have, k) == app { bind found = true }
        bind k = k + 1.0
    }
    if !found {
        splash(w, h, list_get(APP_LABEL, i) + " is not in this image (build kernel/rpi-studio)")
        return 0.0
    }
    splash(w, h, "Starting " + list_get(APP_LABEL, i) + "...")
    os_app_run(app)
    return 0.0
}

# Up/Down move through the menu as drawn (headers skipped), wrapping.
fn menu_step(d) {
    bind rows = menu_rows()
    bind n = len(rows)
    bind cur = st_get("menu_sel", 0.0)
    bind pos = 0.0 - 1.0
    bind r = 0.0
    while r < n {
        bind v = list_get(rows, r)
        if !str_starts_with(v, "#") && to_number(v) == cur { bind pos = r }
        bind r = r + 1.0
    }
    bind p = pos
    bind k = 0.0
    while k < n {
        bind p = p + d
        if p < 0.0 { bind p = n - 1.0 }
        if p >= n { bind p = 0.0 }
        bind v = list_get(rows, p)
        if !str_starts_with(v, "#") {
            st_set("menu_sel", to_number(v))
            return 0.0
        }
        bind k = k + 1.0
    }
    return 0.0
}

# ── main loop ────────────────────────────────────────────────────────────────

bind start = do {
    os_boot()
    open_window(1280.0, 720.0, "LingOS", 1)
    px_flat()
    st_set("mouse_info", os_info("mouse"))
    st_set("kbd_info", os_info("keyboard"))
    settings_load()
    st_set("dock_key_t", os_uptime() + 2.0)
    if os_storage_ready() { lock_screen() }
    bind prev_down = false
    while window_is_open() {
        bind w = get_width()
        bind h = get_height()
        # Tray lights follow hot-plug: re-read the input devices once a second.
        if floor(os_uptime()) != st_get("info_t", 0.0 - 1.0) {
            st_set("info_t", floor(os_uptime()))
            st_set("mouse_info", os_info("mouse"))
            st_set("kbd_info", os_info("keyboard"))
            st_set("pkgs", os_packages())
        }
        bind mx = mouse_x()
        bind my = mouse_y()
        bind down = mouse_down()
        bind click = down && !prev_down
        bind prev_down = down
        if st_get("locked", 0.0) > 0.5 {
            login_frame(w, h, mx, my, click)
            present()
        } else {
            bind menu_open = st_get("menu", 0.0) > 0.5
            bind about_open = st_get("about", 0.0) > 0.5

            # The dock slides out when the pointer touches the bottom edge (or the
            # keyboard walks it), stays while the pointer is over it, slides back after.
            bind dv = st_get("dock_vis", 0.0)
            bind want = st_get("dock_auto", 1.0) < 0.5 || my >= h - 3.0 || (dv > 0.5 && my >= dock_y(h) - 14.0) || os_uptime() - st_get("dock_key_t", 0.0 - 9.0) < 2.5
            if st_get("dragging", 0.0) > 0.5 { bind want = dv > 0.5 }
            st_set("dock_vis", sel(want, min(1.0, dv + 0.2), max(0.0, dv - 0.1)))

            # Alt+Tab cycles the open windows, most recent first; let go of Alt
            # to land on the highlighted one (Shift+Tab goes back).
            bind z = switch_entries()
            if key_down("alt") && key_pressed("tab") && len(z) > 1.5 {
                if st_get("switch", 0.0) < 0.5 {
                    st_set("switch", 1.0)
                    st_set("switch_i", 1.0)
                } else {
                    bind n = len(z)
                    bind pick = st_get("switch_i", 0.0) + sel(key_down("shift"), n - 1.0, 1.0)
                    st_set("switch_i", pick - floor(pick / n) * n)
                }
                st_set("menu", 0.0)
            } else if st_get("switch", 0.0) > 0.5 && !key_down("alt") {
                st_set("switch", 0.0)
                bind pick = st_get("switch_i", 0.0)
                if pick >= 0.0 && pick < len(z) { switch_to(list_get(z, len(z) - 1.0 - pick)) }
            }

            # keyboard
            if key_pressed("super") {
                st_set("menu", sel(menu_open, 0.0, 1.0))
            } else if key_pressed("escape") {
                if st_get("switch", 0.0) > 0.5 {
                    st_set("switch", 0.0)
                } else if menu_open {
                    st_set("menu", 0.0)
                } else if st_get("tray_wifi", 0.0) > 0.5 {
                    st_set("tray_wifi", 0.0)
                } else if st_get("wifi_win", 0.0) > 0.5 && st_get("focus", "") == "wifi" {
                    if st_get("wifi_mode", "") == "pass" { st_set("wifi_mode", "list") } else { st_set("wifi_win", 0.0) }
                } else if st_get("viewer", "") != "" {
                    st_set("viewer", "")
                    win_raise("files")
                } else if st_get("pkgs_win", 0.0) > 0.5 && st_get("focus", "") == "packages" {
                    st_set("pkgs_win", 0.0)
                } else if st_get("files", 0.0) > 0.5 && st_get("focus", "") == "files" {
                    st_set("files", 0.0)
                } else if st_get("set_win", 0.0) > 0.5 && st_get("focus", "") == "settings" {
                    st_set("set_win", 0.0)
                } else if about_open && st_get("focus", "") == "about" {
                    st_set("about", 0.0)
                } else {
                    st_set("menu", 1.0)
                }
            }
            bind menu_open = st_get("menu", 0.0) > 0.5
            if st_get("switch", 0.0) > 0.5 {
                st_set("switch", 1.0)
            } else if menu_open {
                if key_pressed("down") { menu_step(1.0) }
                if key_pressed("up") { menu_step(0.0 - 1.0) }
                if key_pressed("enter") { run_app(st_get("menu_sel", 0.0), w, h) }
            } else if st_get("wifi_win", 0.0) > 0.5 && st_get("focus", "") == "wifi" {
                if st_get("wifi_mode", "") == "pass" {
                    wifi_type()
                    if key_pressed("enter") {
                        st_set("wifi_mode", "list")
                        st_set("wifi_msg", "joining " + st_get("wifi_ssid", "") + "...")
                        st_set("wifi_join", 1.0)
                    }
                } else {
                    bind nw = len(wifi_rows())
                    if key_pressed("down") { st_set("wifi_sel", min(st_get("wifi_sel", 0.0) + 1.0, max(nw - 1.0, 0.0))) }
                    if key_pressed("up") { st_set("wifi_sel", max(st_get("wifi_sel", 0.0) - 1.0, 0.0)) }
                    if key_pressed("enter") { wifi_activate() }
                    if key_pressed("r") {
                        st_set("wifi_msg", "scanning...")
                        st_set("wifi_scan", 1.0)
                    }
                    if key_pressed("f") {
                        wifi_forget()
                        st_set("wifi_msg", "forgot the saved network")
                    }
                }
            } else if st_get("set_win", 0.0) > 0.5 && st_get("focus", "") == "settings" {
                settings_keys()
            } else if st_get("pkgs_win", 0.0) > 0.5 && st_get("focus", "") == "packages" {
                bind nv = len(pk_visible())
                if key_pressed("down") { st_set("pk_sel", min(st_get("pk_sel", 0.0) + 1.0, max(nv - 1.0, 0.0))) }
                if key_pressed("up") { st_set("pk_sel", max(st_get("pk_sel", 0.0) - 1.0, 0.0)) }
                if key_pressed("enter") { pk_activate() }
                if key_pressed("tab") {
                    st_set("pk_tab", sel(st_get("pk_tab", 0.0) > 0.5, 0.0, 1.0))
                    st_set("pk_sel", 0.0)
                    st_set("pk_scroll", 0.0)
                }
                if key_pressed("s") {
                    st_set("pk_msg", "resyncing the catalog...")
                    st_set("pk_load", 1.0)
                }
                pk_keep_visible()
            } else if st_get("files", 0.0) > 0.5 && st_get("focus", "") == "files" {
                bind nf = len(files_items()) / 2.0
                if key_pressed("down") { st_set("fsel", min(st_get("fsel", 0.0) + 1.0, max(nf - 1.0, 0.0))) }
                if key_pressed("up") { st_set("fsel", max(st_get("fsel", 0.0) - 1.0, 0.0)) }
                if key_pressed("enter") { files_activate(st_get("fsel", 0.0)) }
                if key_pressed("backspace") { files_up() }
                if key_pressed("h") {
                    st_set("fdir", home_dir())
                    st_set("fsel", 0.0)
                }
                if key_pressed("c") || key_pressed("x") {
                    bind p = files_sel_path()
                    if p != "" {
                        bind cut = key_pressed("x")
                        st_set("clip", p)
                        st_set("clip_cut", sel(cut, 1.0, 0.0))
                        st_set("fmsg", sel(cut, "cut: ", "copied: ") + p + "   (v pastes into the open folder)")
                    }
                }
                if key_pressed("v") && st_get("clip", "") != "" {
                    bind src = st_get("clip", "")
                    bind dst = files_join(st_get("fdir", home_dir()), fs_basename(src))
                    bind cut = st_get("clip_cut", 0.0) > 0.5
                    bind ok = 0.0
                    if cut { bind ok = fs_move(src, dst) } else { bind ok = fs_copy(src, dst) }
                    if ok > 0.5 {
                        st_set("fmsg", sel(cut, "moved to ", "copied to ") + dst)
                        if cut { st_set("clip", "") }
                    } else {
                        st_set("fmsg", "could not write " + dst + " (is this folder on a USB drive or the SD card?)")
                    }
                }
                if key_pressed("delete") {
                    bind p = files_sel_path()
                    if p != "" {
                        if fs_delete(p) > 0.5 {
                            st_set("fmsg", "deleted " + p)
                            st_set("fsel", max(st_get("fsel", 0.0) - 1.0, 0.0))
                        } else {
                            st_set("fmsg", "could not delete " + p + " (folders must be empty; only removable media can be deleted from)")
                        }
                    }
                }
                files_keep_visible()
            } else {
                bind ds = st_get("dock_sel", 0.0 - 1.0)
                if key_pressed("right") || key_pressed("left") || key_pressed("tab") { st_set("dock_key_t", os_uptime()) }
                if key_pressed("right") || key_pressed("tab") { st_set("dock_sel", sel(ds + 1.0 >= len(APP_GLYPH), 0.0, ds + 1.0)) }
                if key_pressed("left") { st_set("dock_sel", sel(ds - 1.0 < 0.0, len(APP_GLYPH) - 1.0, ds - 1.0)) }
                if key_pressed("enter") && st_get("dock_sel", 0.0 - 1.0) >= 0.0 { run_app(st_get("dock_sel", 0.0), w, h) }
                if key_pressed("w") { tray_wifi_toggle() }
            }

            # mouse
            if st_get("dragging", 0.0) > 0.5 {
                if down {
                    bind dwin = st_get("drag_win", "about")
                    st_set(dwin + "_x", mx - st_get("drag_dx", 0.0))
                    st_set(dwin + "_y", max(TOP_H + 1.0, my - st_get("drag_dy", 0.0)))
                } else {
                    st_set("dragging", 0.0)
                }
            } else if click {
                bind ax = st_get("about_x", 0.0)
                bind ay = st_get("about_y", 0.0)
                bind vx = st_get("view_x", 0.0)
                bind vy = st_get("view_y", 0.0)
                bind fx = st_get("files_x", 0.0)
                bind fy = st_get("files_y", 0.0)
                bind viewing = st_get("viewer", "") != ""
                bind files_open = st_get("files", 0.0) > 0.5
                bind pk_open_now = st_get("pkgs_win", 0.0) > 0.5
                bind px = st_get("pk_x", 0.0)
                bind py = st_get("pk_y", 0.0)
                bind wifi_now = st_get("wifi_win", 0.0) > 0.5
                bind wx = st_get("wifi_x", 0.0)
                bind wy = st_get("wifi_y", 0.0)
                bind twx = tray_wifi_x(w)
                bind tr = tray_rect(w)
                bind tray_open = st_get("tray_wifi", 0.0) > 0.5
                bind hw = win_at(mx, my)
                bind sr = tray_sound_rect(w)
                bind sound_open = st_get("tray_sound", 0.0) > 0.5
                if tray_open && inside(mx, my, list_get(tr, 0.0), list_get(tr, 1.0), TRAY_W, list_get(tr, 3.0)) {
                    tray_wifi_click(mx, my, w, h)
                } else if sound_open && inside(mx, my, list_get(sr, 0.0), list_get(sr, 1.0), list_get(sr, 2.0), list_get(sr, 3.0)) {
                    tray_sound_click(mx, my, w, h)
                } else if inside(mx, my, twx - 6.0, 0.0, 32.0, TOP_H) {
                    st_set("tray_sound", 0.0)
                    tray_wifi_toggle()
                } else if inside(mx, my, tray_sound_x(w) - 6.0, 0.0, 32.0, TOP_H) {
                    st_set("tray_wifi", 0.0)
                    st_set("tray_sound", sel(sound_open, 0.0, 1.0))
                } else if tray_open {
                    st_set("tray_wifi", 0.0)
                } else if sound_open {
                    st_set("tray_sound", 0.0)
                } else if menu_open && inside(mx, my, 6.0, 31.0, MENU_W, menu_h()) {
                    if menu_row_at(mx, my) >= 0.0 { run_app(menu_row_at(mx, my), w, h) }
                } else if hw == "viewer" && inside(mx, my, vx + VIEW_W - 2.0 * TB, vy, 2.0 * TB, TB) {
                    st_set("viewer", "")
                    win_raise("files")
                } else if hw == "viewer" && inside(mx, my, vx, vy, VIEW_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "view")
                    st_set("drag_dx", mx - vx)
                    st_set("drag_dy", my - vy)
                    win_raise("viewer")
                } else if hw == "viewer" && inside(mx, my, vx, vy, VIEW_W, VIEW_H) {
                    win_raise("viewer")
                } else if hw == "wifi" && inside(mx, my, wx + WIFI_W - 2.0 * TB, wy, 2.0 * TB, TB) {
                    st_set("wifi_win", 0.0)
                } else if hw == "wifi" && inside(mx, my, wx, wy, WIFI_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "wifi")
                    st_set("drag_dx", mx - wx)
                    st_set("drag_dy", my - wy)
                    win_raise("wifi")
                } else if hw == "wifi" && inside(mx, my, wx, wy, WIFI_W, WIFI_H) {
                    win_raise("wifi")
                    st_set("menu", 0.0)
                    wifi_click(mx, my)
                } else if hw == "packages" && inside(mx, my, px + PK_W - 2.0 * TB, py, 2.0 * TB, TB) {
                    st_set("pkgs_win", 0.0)
                } else if hw == "packages" && inside(mx, my, px, py, PK_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "pk")
                    st_set("drag_dx", mx - px)
                    st_set("drag_dy", my - py)
                    win_raise("packages")
                } else if hw == "packages" && inside(mx, my, px, py, PK_W, PK_H) {
                    win_raise("packages")
                    st_set("menu", 0.0)
                    bind tcy = py + TB + 12.0
                    if inside(mx, my, px + 16.0, tcy - 4.0, 128.0, 16.0) {
                        st_set("pk_tab", 0.0)
                        st_set("pk_sel", 0.0)
                        st_set("pk_scroll", 0.0)
                    } else if inside(mx, my, px + 152.0, tcy - 4.0, 136.0, 16.0) {
                        st_set("pk_tab", 1.0)
                        st_set("pk_sel", 0.0)
                        st_set("pk_scroll", 0.0)
                    } else if inside(mx, my, px + PK_W - 96.0, tcy - 4.0, 88.0, 16.0) {
                        st_set("pk_msg", "resyncing the catalog...")
                        st_set("pk_load", 1.0)
                    }
                    bind pi = pk_row_at(mx, my)
                    if pi >= 0.0 {
                        bind now = os_uptime()
                        if pi == st_get("pk_sel", 0.0) && now - st_get("pkclick_t", 0.0) < 0.45 {
                            pk_activate()
                            st_set("pkclick_t", 0.0)
                        } else {
                            st_set("pk_sel", pi)
                            st_set("pkclick_t", now)
                        }
                    }
                } else if hw == "files" && inside(mx, my, fx + FILES_W - 2.0 * TB, fy, 2.0 * TB, TB) {
                    st_set("files", 0.0)
                } else if hw == "files" && inside(mx, my, fx, fy, FILES_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "files")
                    st_set("drag_dx", mx - fx)
                    st_set("drag_dy", my - fy)
                    win_raise("files")
                } else if hw == "files" && inside(mx, my, fx, fy, FILES_W, FILES_H) {
                    win_raise("files")
                    st_set("menu", 0.0)
                    if inside(mx, my, fx + FILES_W - 80.0, fy + TB + 6.0, 70.0, 18.0) { files_up() }
                    bind fi = files_row_at(mx, my)
                    if fi >= 0.0 {
                        bind now = os_uptime()
                        if fi == st_get("fsel", 0.0) && now - st_get("fclick_t", 0.0) < 0.45 {
                            files_activate(fi)
                            st_set("fclick_t", 0.0)
                        } else {
                            st_set("fsel", fi)
                            st_set("fclick_t", now)
                        }
                    }
                } else if inside(mx, my, 0.0, 0.0, 84.0, TOP_H) {
                    st_set("menu", sel(menu_open, 0.0, 1.0))
                } else if menu_open && menu_row_at(mx, my) >= 0.0 {
                    run_app(menu_row_at(mx, my), w, h)
                } else if menu_open && inside(mx, my, 6.0, 31.0, MENU_W, menu_h()) {
                    st_set("menu", 1.0)
                } else if dock_at(mx, my, w, h) >= 0.0 {
                    run_app(dock_at(mx, my, w, h), w, h)
                } else if hw == "settings" && inside(mx, my, st_get("set_x", 0.0) + SET_W - 2.0 * TB, st_get("set_y", 0.0), 2.0 * TB, TB) {
                    st_set("set_win", 0.0)
                } else if hw == "settings" && inside(mx, my, st_get("set_x", 0.0), st_get("set_y", 0.0), SET_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "set")
                    st_set("drag_dx", mx - st_get("set_x", 0.0))
                    st_set("drag_dy", my - st_get("set_y", 0.0))
                    win_raise("settings")
                } else if hw == "settings" {
                    win_raise("settings")
                    st_set("menu", 0.0)
                    settings_click(mx, my, w, h)
                } else if hw == "about" && inside(mx, my, ax + ABOUT_W - 2.0 * TB, ay, 2.0 * TB, TB) {
                    st_set("about", 0.0)
                } else if hw == "about" && inside(mx, my, ax, ay, ABOUT_W - 3.0 * TB, TB) {
                    st_set("dragging", 1.0)
                    st_set("drag_win", "about")
                    st_set("drag_dx", mx - ax)
                    st_set("drag_dy", my - ay)
                    win_raise("about")
                    st_set("menu", 0.0)
                } else if hw == "about" && inside(mx, my, ax, ay, ABOUT_W, ABOUT_H) {
                    win_raise("about")
                    st_set("menu", 0.0)
                } else {
                    st_set("menu", 0.0)
                }
            }

            keep_windows_clear(h)

            # draw, back to front (same order as the x86 desktop loop)
            wallpaper(w, h)
            top_bar(w, mx, my)
            bind z = zorder()
            st_set("zorder", z)
            if len(z) > 0.5 && st_get("focus", "") != list_get(z, len(z) - 1.0) { st_set("focus", list_get(z, len(z) - 1.0)) }
            bind k = 0.0
            while k < len(z) {
                win_draw(list_get(z, k), mx, my)
                bind k = k + 1.0
            }
            dock(w, h, mx, my)
            if st_get("menu", 0.0) > 0.5 { apps_menu(mx, my) }
            if st_get("tray_wifi", 0.0) > 0.5 { tray_wifi_popup(w, mx, my) }
            if st_get("tray_sound", 0.0) > 0.5 { tray_sound_popup(w, mx, my) }
            if st_get("switch", 0.0) > 0.5 { switcher(w, h) }
            status_line(h)
            present()
            # Network work after the frame is on screen (it blocks for seconds).
            if st_get("pk_load", 0.0) > 0.5 {
                st_set("pk_load", 0.0)
                pk_refresh()
            }
            if st_get("pk_install", "") != "" {
                bind nm = st_get("pk_install", "")
                st_set("pk_install", "")
                st_set("pk_msg", lingfu_install(nm))
                pk_refresh()
            }
            if st_get("wifi_scan", 0.0) > 0.5 {
                st_set("wifi_scan", 0.0)
                st_set("wifi_list", wifi_scan())
                st_set("wifi_sel", 0.0)
                bind got = wifi_rows()
                st_set("wifi_msg", sel(len(got) > 0.5, num_str(len(got)) + " networks, strongest first", ""))
            }
            if st_get("wifi_join", 0.0) > 0.5 {
                st_set("wifi_join", 0.0)
                bind r = wifi_connect(st_get("wifi_ssid", ""), st_get("wifi_pass", ""))
                st_set("wifi_pass", "")
                st_set("wifi_msg", str_replace(r, "!", ""))
            }
        }
    }
}
