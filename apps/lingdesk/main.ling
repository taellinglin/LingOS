# LingOS desktop for the Raspberry Pi, in the look of the x86-64 LingOS
# desktop (kernel/x86_64-wm + drivers::wm): the Ling Country wallpaper, a top
# bar ("= LingOS" brand / Applications menu, locale, clock), a centred glass
# dock with letter tiles, windows with the Dusk theme's titlebar and traffic
# lights, the 8x8 pixel UI font and the ringed-dot cursor.
#
# It runs on the kernel's app runtime (the px_*/mouse_*/key_* builtins
# LingStationX uses, plus px_text8/os_wallpaper/os_cursor), so the apps it
# launches are full-screen compiled .ling programs linked into the same image
# (`bundle_app` in the kernel's Ling.toml); Ctrl+Q in an app comes back here.
# Keyboard: Super or Esc opens Applications, arrows + Enter pick; with the
# menu closed, Left/Right walk the dock and Enter launches.

# Dusk theme (drivers::theme), slot order as in the x86 kernel.
bind C_PANEL = 2366259.0       # 0x241B33
bind C_BORDER = 3813197.0      # 0x3A2F4D
bind C_TEXT = 16777215.0       # 0xFFFFFF
bind C_DIM = 10194864.0        # 0x9B8FB0
bind C_TITLE = 3549773.0       # 0x362A4D
bind C_TITLE_IDLE = 2366259.0  # 0x241B33
bind C_DOCK = 1183258.0        # 0x120E1A
bind C_ACCENT = 4886496.0      # 0x4A8FE0

bind TOP_H = 30.0
bind TB = 28.0                 # TITLEBAR_H

# Apps: dock letter, label, action ("app:<name>" = built-in app).
bind APP_GLYPH = ["L", ">", "W", "S", "i"]
bind APP_LABEL = ["LingStationX (LingOS Edition)", "Console", "Wi-Fi (radio probe)", "Settings", "About LingOS"]
bind APP_KIND = ["app:lingstation", "console", "console:wifi", "settings", "about"]

# Applications menu rows: "#header" or an app index.
bind MENU_ROWS = ["#Sound & Video", "0", "#Accessories", "1", "#System", "2", "3", "4"]
bind MENU_W = 260.0
bind MENU_ROW_H = 22.0

bind ABOUT_W = 520.0
bind ABOUT_H = 300.0

fn sel(cond, a, b) {
    if cond { return a }
    return b
}

fn inside(mx, my, x, y, w, h) {
    return mx >= x && mx < x + w && my >= y && my < y + h
}

fn t8(x, y, c, s) {
    px_text8(x, y, c, s)
}

fn two(n) {
    if n < 10.0 { return "0" + n }
    return "" + n
}

fn clock_str() {
    bind s = floor(os_uptime())
    bind hh = floor(s / 3600.0)
    bind mm = floor((s - hh * 3600.0) / 60.0)
    return two(hh) + ":" + two(mm) + ":" + two(s - hh * 3600.0 - mm * 60.0)
}

fn uptime_words() {
    bind s = floor(os_uptime())
    bind m = floor(s / 60.0)
    return m + "m " + (s - m * 60.0) + "s"
}

# ── wallpaper + top bar ──────────────────────────────────────────────────────

fn wallpaper(w, h) {
    if os_wallpaper() { return 0.0 }
    # No embedded image: the theme's wallpaper gradient (0x2B2140 -> 0x120E1A).
    bind i = 0.0
    while i < 32.0 {
        bind t = i / 31.0
        bind r = 43.0 + (18.0 - 43.0) * t
        bind g = 33.0 + (14.0 - 33.0) * t
        bind b = 64.0 + (26.0 - 64.0) * t
        px_rect(0.0, floor(h * i / 32.0), w, floor(h / 32.0) + 1.0, floor(r) * 65536.0 + floor(g) * 256.0 + floor(b))
        bind i = i + 1.0
    }
    return 0.0
}

fn top_bar(w, mx, my) {
    px_rect(0.0, 0.0, w, TOP_H, C_PANEL)
    px_rect(0.0, TOP_H, w, 1.0, C_BORDER)
    if inside(mx, my, 0.0, 0.0, 84.0, TOP_H) || st_get("menu", 0.0) > 0.5 {
        px_rrect(4.0, 4.0, 76.0, 22.0, 5.0, C_TITLE)
    }
    t8(12.0, 11.0, C_ACCENT, "= LingOS")
    t8(96.0, 11.0, C_DIM, "English (US)")
    bind clock = clock_str()
    bind cx = w - len(clock) * 8.0 - 14.0
    t8(cx, 11.0, C_TEXT, clock)
    # tray: input devices
    bind mouse_ok = st_get("mouse_info", "") != "none"
    bind kbd_ok = st_get("kbd_info", "") != "serial only"
    bind tx = cx - 150.0
    px_disc(tx, 15.0, 4.0, sel(mouse_ok, 5947498.0, 14704730.0))
    t8(tx + 9.0, 11.0, C_DIM, "mouse")
    px_disc(tx + 70.0, 15.0, 4.0, sel(kbd_ok, 5947498.0, 14704730.0))
    t8(tx + 79.0, 11.0, C_DIM, "kbd")
}

# ── dock ─────────────────────────────────────────────────────────────────────

fn dock_size(h) {
    return max(32.0, floor(h / 14.0))
}

fn dock_x(i, w, h) {
    bind sz = dock_size(h)
    bind gap = floor(sz / 4.0)
    bind n = len(APP_GLYPH)
    bind total = n * sz + (n - 1.0) * gap
    return floor((w - total) / 2.0) + i * (sz + gap)
}

fn dock_y(h) {
    return h - dock_size(h) - floor(dock_size(h) / 2.0)
}

fn dock_at(mx, my, w, h) {
    bind sz = dock_size(h)
    bind i = 0.0
    while i < len(APP_GLYPH) {
        if inside(mx, my, dock_x(i, w, h), dock_y(h), sz, sz) { return i }
        bind i = i + 1.0
    }
    return 0.0 - 1.0
}

fn dock(w, h, mx, my) {
    bind sz = dock_size(h)
    bind n = len(APP_GLYPH)
    bind x0 = dock_x(0.0, w, h)
    bind xn = dock_x(n - 1.0, w, h)
    bind dy = dock_y(h)
    px_rrect(x0 - 12.0, dy - 8.0, xn + sz + 12.0 - (x0 - 12.0), sz + 16.0, 14.0, C_DOCK, 0.59)
    bind hover = dock_at(mx, my, w, h)
    bind ksel = st_get("dock_sel", 0.0 - 1.0)
    bind i = 0.0
    while i < n {
        bind dx = dock_x(i, w, h)
        bind hot = hover == i || (ksel == i && st_get("menu", 0.0) < 0.5)
        if hot { px_rrect(dx - 3.0, dy - 3.0, sz + 6.0, sz + 6.0, 12.0, C_ACCENT) }
        px_rrect(dx, dy, sz, sz, 10.0, C_PANEL)
        bind g = list_get(APP_GLYPH, i)
        bind gs = sel(sz >= 48.0, 3.0, 2.0)
        px_text8(dx + (sz - len(g) * 8.0 * gs) / 2.0, dy + (sz - 8.0 * gs) / 2.0, C_TEXT, g, gs)
        if list_get(APP_KIND, i) == "about" && st_get("about", 0.0) > 0.5 {
            px_disc(dx + sz / 2.0, dy + sz + 7.0, 3.0, C_ACCENT)
        }
        bind i = i + 1.0
    }
    bind tip_i = sel(hover >= 0.0, hover, sel(st_get("menu", 0.0) < 0.5, ksel, 0.0 - 1.0))
    if tip_i >= 0.0 {
        bind tip = list_get(APP_LABEL, tip_i)
        bind tw = len(tip) * 8.0 + 16.0
        bind tx = dock_x(tip_i, w, h) + sz / 2.0 - tw / 2.0
        px_rrect(tx, dy - 36.0, tw, 22.0, 6.0, C_PANEL)
        px_rrect_outline(tx, dy - 36.0, tw, 22.0, 6.0, C_BORDER)
        t8(tx + 8.0, dy - 29.0, C_TEXT, tip)
    }
}

fn status_line(h) {
    # The x86 desktop's bottom-left network line.
    bind msg = "net: none (Wi-Fi: stage 1 probe)"
    px_rect(6.0, h - 22.0, len(msg) * 8.0 + 8.0, 16.0, C_DOCK)
    t8(10.0, h - 18.0, C_DIM, msg)
}

# ── Applications menu ────────────────────────────────────────────────────────

fn menu_h() {
    return len(MENU_ROWS) * MENU_ROW_H + 30.0
}

fn menu_row_at(mx, my) {
    if !inside(mx, my, 6.0, 31.0, MENU_W, menu_h()) { return 0.0 - 1.0 }
    bind r = floor((my - 53.0) / MENU_ROW_H)
    if r < 0.0 || r >= len(MENU_ROWS) { return 0.0 - 1.0 }
    bind v = list_get(MENU_ROWS, r)
    if str_starts_with(v, "#") { return 0.0 - 1.0 }
    return to_number(v)
}

fn apps_menu(mx, my) {
    bind rx = 6.0
    bind ry = 31.0
    bind rh = menu_h()
    px_rrect(rx + 4.0, ry + 5.0, MENU_W, rh, 10.0, 0.0, 0.31)
    px_rrect(rx, ry, MENU_W, rh, 10.0, C_BORDER)
    px_rrect(rx + 1.0, ry + 1.0, MENU_W - 2.0, rh - 2.0, 9.0, C_PANEL)
    t8(rx + 12.0, ry + 8.0, C_ACCENT, "Applications")
    bind hover = menu_row_at(mx, my)
    if hover >= 0.0 { st_set("menu_sel", hover) }
    bind msel = st_get("menu_sel", 0.0)
    bind r = 0.0
    while r < len(MENU_ROWS) {
        bind yy = ry + 22.0 + r * MENU_ROW_H
        bind v = list_get(MENU_ROWS, r)
        if str_starts_with(v, "#") {
            t8(rx + 10.0, yy + 7.0, C_DIM, str_replace(v, "#", ""))
        } else {
            bind ai = to_number(v)
            if ai == msel {
                px_rrect(rx + 4.0, yy + 2.0, MENU_W - 8.0, MENU_ROW_H - 3.0, 5.0, C_ACCENT)
                t8(rx + 24.0, yy + 7.0, C_PANEL, list_get(APP_LABEL, ai))
            } else {
                t8(rx + 24.0, yy + 7.0, C_TEXT, list_get(APP_LABEL, ai))
            }
        }
        bind r = r + 1.0
    }
}

# ── About window (x86 window chrome) ─────────────────────────────────────────

fn window_frame(x, y, ww, wh, title, focused) {
    px_rrect(x + 6.0, y + 8.0, ww, wh, 10.0, 0.0, 0.27)
    px_rrect(x, y, ww, wh, 10.0, sel(focused, C_ACCENT, C_BORDER))
    px_rrect(x + 1.0, y + 1.0, ww - 2.0, wh - 2.0, 9.0, C_PANEL)
    bind tbc = sel(focused, C_TITLE, C_TITLE_IDLE)
    px_rrect(x + 1.0, y + 1.0, ww - 2.0, TB, 9.0, tbc)
    px_rect(x + 1.0, y + TB - 8.0, ww - 2.0, 8.0, tbc)
    t8(x + 12.0, y + 11.0, sel(focused, C_TEXT, C_DIM), title)
    bind cy = y + TB / 2.0
    px_disc(x + ww - 2.0 * TB - TB / 2.0, cy, 6.0, 5947498.0)
    px_disc(x + ww - TB - TB / 2.0, cy, 6.0, 14721098.0)
    px_disc(x + ww - TB / 2.0, cy, 6.0, 14704730.0)
}

fn about_window() {
    bind x = st_get("about_x", 0.0)
    bind y = st_get("about_y", 0.0)
    window_frame(x, y, ABOUT_W, ABOUT_H, "About LingOS", true)
    bind cx = x + 16.0
    bind cy = y + TB + 14.0
    t8(cx, cy, C_ACCENT, "LingOS")
    t8(cx, cy + 18.0, C_TEXT, "a from-scratch OS written in Ling")
    t8(cx, cy + 44.0, C_DIM, "uptime: " + uptime_words())
    t8(cx, cy + 62.0, C_DIM, "theme:")
    t8(cx + 64.0, cy + 62.0, C_TEXT, "Dusk")
    bind rows = ["board", "memory", "display", "mouse", "keyboard", "network"]
    bind i = 0.0
    while i < len(rows) {
        bind k = list_get(rows, i)
        t8(cx, cy + 90.0 + i * 18.0, C_DIM, k + ":")
        t8(cx + 96.0, cy + 90.0 + i * 18.0, C_TEXT, os_info(k))
        bind i = i + 1.0
    }
    t8(cx, y + ABOUT_H - 22.0, C_DIM, "drag titlebar; dock launches; arrows+enter")
}

# ── actions ──────────────────────────────────────────────────────────────────

fn splash(w, h, msg) {
    wallpaper(w, h)
    bind tw = len(msg) * 16.0
    px_rrect((w - tw) / 2.0 - 24.0, h / 2.0 - 26.0, tw + 48.0, 52.0, 10.0, C_PANEL)
    px_text8((w - tw) / 2.0, h / 2.0 - 8.0, C_TEXT, msg, 2.0)
    present()
}

fn run_app(i, w, h) {
    st_set("menu", 0.0)
    bind kind = list_get(APP_KIND, i)
    if kind == "about" {
        st_set("about", 1.0)
        st_set("about_x", floor((w - ABOUT_W) / 2.0))
        st_set("about_y", floor((h - ABOUT_H) / 2.0 - 40.0))
        return 0.0
    }
    if kind == "console" {
        os_console("")
        return 0.0
    }
    if kind == "console:wifi" {
        os_console("wifi")
        return 0.0
    }
    if kind == "settings" {
        os_setup()
        return 0.0
    }
    splash(w, h, "Starting " + list_get(APP_LABEL, i) + "...")
    os_app_run(str_replace(kind, "app:", ""))
    return 0.0
}

fn menu_step(d) {
    bind n = len(APP_LABEL)
    bind s = st_get("menu_sel", 0.0) + d
    if s < 0.0 { bind s = n - 1.0 }
    if s >= n { bind s = 0.0 }
    st_set("menu_sel", s)
}

# ── main loop ────────────────────────────────────────────────────────────────

bind start = do {
    os_boot()
    open_window(1280.0, 720.0, "LingOS", 1)
    px_flat()
    os_cursor("dot")
    st_set("mouse_info", os_info("mouse"))
    st_set("kbd_info", os_info("keyboard"))
    bind prev_down = false
    while window_is_open() {
        bind w = get_width()
        bind h = get_height()
        bind mx = mouse_x()
        bind my = mouse_y()
        bind down = mouse_down()
        bind click = down && !prev_down
        bind prev_down = down
        bind menu_open = st_get("menu", 0.0) > 0.5
        bind about_open = st_get("about", 0.0) > 0.5

        # keyboard
        if key_pressed("super") {
            st_set("menu", sel(menu_open, 0.0, 1.0))
        } else if key_pressed("escape") {
            if menu_open {
                st_set("menu", 0.0)
            } else if about_open {
                st_set("about", 0.0)
            } else {
                st_set("menu", 1.0)
            }
        }
        bind menu_open = st_get("menu", 0.0) > 0.5
        if menu_open {
            if key_pressed("down") { menu_step(1.0) }
            if key_pressed("up") { menu_step(0.0 - 1.0) }
            if key_pressed("enter") { run_app(st_get("menu_sel", 0.0), w, h) }
        } else {
            bind ds = st_get("dock_sel", 0.0 - 1.0)
            if key_pressed("right") || key_pressed("tab") { st_set("dock_sel", sel(ds + 1.0 >= len(APP_GLYPH), 0.0, ds + 1.0)) }
            if key_pressed("left") { st_set("dock_sel", sel(ds - 1.0 < 0.0, len(APP_GLYPH) - 1.0, ds - 1.0)) }
            if key_pressed("enter") && st_get("dock_sel", 0.0 - 1.0) >= 0.0 { run_app(st_get("dock_sel", 0.0), w, h) }
        }

        # mouse
        if st_get("dragging", 0.0) > 0.5 {
            if down {
                st_set("about_x", mx - st_get("drag_dx", 0.0))
                st_set("about_y", max(TOP_H + 1.0, my - st_get("drag_dy", 0.0)))
            } else {
                st_set("dragging", 0.0)
            }
        } else if click {
            bind ax = st_get("about_x", 0.0)
            bind ay = st_get("about_y", 0.0)
            if inside(mx, my, 0.0, 0.0, 84.0, TOP_H) {
                st_set("menu", sel(menu_open, 0.0, 1.0))
            } else if menu_open && menu_row_at(mx, my) >= 0.0 {
                run_app(menu_row_at(mx, my), w, h)
            } else if menu_open && inside(mx, my, 6.0, 31.0, MENU_W, menu_h()) {
                st_set("menu", 1.0)
            } else if dock_at(mx, my, w, h) >= 0.0 {
                run_app(dock_at(mx, my, w, h), w, h)
            } else if about_open && inside(mx, my, ax + ABOUT_W - 2.0 * TB, ay, 2.0 * TB, TB) {
                st_set("about", 0.0)
            } else if about_open && inside(mx, my, ax, ay, ABOUT_W - 3.0 * TB, TB) {
                st_set("dragging", 1.0)
                st_set("drag_dx", mx - ax)
                st_set("drag_dy", my - ay)
                st_set("menu", 0.0)
            } else {
                st_set("menu", 0.0)
            }
        }

        # draw, back to front (same order as the x86 desktop loop)
        wallpaper(w, h)
        top_bar(w, mx, my)
        if st_get("about", 0.0) > 0.5 { about_window() }
        dock(w, h, mx, my)
        if st_get("menu", 0.0) > 0.5 { apps_menu(mx, my) }
        status_line(h)
        present()
    }
}
