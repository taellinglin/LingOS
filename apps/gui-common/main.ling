// Shared graphics-mode UI pieces -- `use`-shared between kernel/x86_64-wm
// (the Live desktop) and kernel/x86_64-installer-gui (the GUI installer),
// so the look and interaction (header + stepper bar + card panel, arrow-
// key/Enter navigation with a ring-highlighted row) is pixel-for-pixel the
// same experience in both rather than two copies that could drift apart.
//
// Every position/size below is a *virtual* coordinate in a fixed 960x600
// design canvas, routed through `ling_kernel_ui_x`/`_ui_y`/`_ui_len`
// (`drivers::ui_scale`'s module doc) before it ever reaches a real
// `ling_kernel_fb_*` call -- authored once, correct whether the real
// negotiated Multiboot2 framebuffer mode is 800x600 or 1920x1080. Real,
// disclosed gap this doesn't close: text stays a fixed pixel size
// regardless of scale (see ui_scale's own doc for why); and there is no
// rounded-rect or circle primitive, so "cards" and "dots" below are drawn
// as plain rectangles/squares -- an honest simplification of the reference
// mockup's rounded panels and circular stepper dots, not an attempt to
// fake curves this driver can't draw.
//
// 8-step wizard order (Keyboard/Language/Locale/Root/User/Network/
// Packages/Finish) and per-step color come from `step_color`/`step_label`
// below -- both callers (GUI installer, Live desktop) share this table so
// the stepper bar always means the same thing.
// Every surface color now comes from the kernel's theme table
// (`drivers::theme` -- slot indices are a fixed contract documented there),
// so the installer, greeter, and desktop all follow the active theme
// instead of each hardcoding its own copy of the palette. Theme 0 ("Dusk")
// is byte-identical to the palette these functions used to hardcode.
fn color_bg() {
    return ling_kernel_theme_color(0)
}
fn color_panel() {
    return ling_kernel_theme_color(1)
}
fn color_panel_border() {
    return ling_kernel_theme_color(2)
}
fn color_text() {
    return ling_kernel_theme_color(3)
}
fn color_dim() {
    return ling_kernel_theme_color(4)
}
fn color_error() {
    return ling_kernel_theme_color(5)
}
fn color_dot_dim() {
    return ling_kernel_theme_color(14)
}

// Real if/else chains on a literal step index (0..7), not an arithmetic
// blend -- see `draw_locale_row`'s doc below for why that distinction
// matters here (an earlier arithmetic-blended version of a comparison
// result rendered every row identically blank; only real if/else is
// proven reliable for picking a color).
fn step_color(idx) {
    if idx == 0 {
        return 14704730 // 0xE0605A red -- Keyboard
    } else if idx == 1 {
        return 14718282 // 0xE0954A orange -- Language
    } else if idx == 2 {
        return 13161034 // 0xC8D24A yellow-green -- Locale
    } else if idx == 3 {
        return 4907200 // 0x4AE0C0 teal -- Root
    } else if idx == 4 {
        return 4886496 // 0x4A8FE0 blue -- User
    } else if idx == 5 {
        return 9063136 // 0x8A4AE0 indigo -- Network
    } else if idx == 6 {
        return 12602080 // 0xC04AE0 purple -- Packages
    } else {
        return 14699162 // 0xE04A9A pink -- Finish
    }
}

fn step_label(idx) {
    if idx == 0 {
        return "Keyboard"
    } else if idx == 1 {
        return "Language"
    } else if idx == 2 {
        return "Locale"
    } else if idx == 3 {
        return "Root"
    } else if idx == 4 {
        return "User"
    } else if idx == 5 {
        return "Network"
    } else if idx == 6 {
        return "Packages"
    } else {
        return "Finish"
    }
}

// One stepper slot: a small square dot (colored if reached, dim if not)
// plus its label underneath. `idx` is always a literal at each of the 8
// unrolled call sites below, so the arithmetic on it (slot position) is
// safe -- only the *comparison result* (`idx <= current`) is restricted to
// real if/else, same rule as `draw_locale_row`.
fn draw_stepper_dot(idx, current) {
    bind slot_x = 20 + idx * 115
    // Real circles now (`fb_back_fill_circle`, added alongside the rounded-
    // rect primitive) -- the "dots drawn as squares" disclosure in this
    // file's module doc is finally obsolete. Center = old square's center.
    bind cx = ling_kernel_ui_x(slot_x + 7)
    bind cy = ling_kernel_ui_y(67)
    bind r = ling_kernel_ui_len(7)
    bind label_x = ling_kernel_ui_x(slot_x - 4)
    bind label_y = ling_kernel_ui_y(80)
    if idx <= current {
        ling_kernel_fb_back_fill_circle(cx, cy, r, step_color(idx))
        ling_kernel_fb_draw_str(label_x, label_y, step_label(idx), step_color(idx), color_bg())
    } else {
        ling_kernel_fb_back_fill_circle(cx, cy, r, color_dot_dim())
        ling_kernel_fb_draw_str(label_x, label_y, step_label(idx), color_dim(), color_bg())
    }
}

fn draw_stepper(current) {
    draw_stepper_dot(0, current)
    draw_stepper_dot(1, current)
    draw_stepper_dot(2, current)
    draw_stepper_dot(3, current)
    draw_stepper_dot(4, current)
    draw_stepper_dot(5, current)
    draw_stepper_dot(6, current)
    draw_stepper_dot(7, current)
}

// Draws the header (title + current step name in its own color), the
// stepper bar, and a bordered card panel that the rest of the screen's
// content is drawn into -- every installer/desktop screen starts by
// calling this, so chrome is pixel-identical across screens instead of
// each one reimplementing it slightly differently. `step` is 0..7 (see
// `step_label`); `title` is a short description of what this particular
// screen within that step is asking for.
fn draw_screen_frame(title, step) {
    ling_kernel_fb_back_clear(color_bg())

    ling_kernel_fb_back_fill_rect(ling_kernel_ui_x(0), ling_kernel_ui_y(0), ling_kernel_ui_len(960), ling_kernel_ui_len(48), color_panel())
    ling_kernel_fb_back_fill_rect(ling_kernel_ui_x(0), ling_kernel_ui_y(47), ling_kernel_ui_len(960), ling_kernel_ui_len(1), color_panel_border())
    ling_kernel_fb_draw_str(ling_kernel_ui_x(20), ling_kernel_ui_y(16), title, color_text(), color_panel())
    ling_kernel_fb_draw_str(ling_kernel_ui_x(800), ling_kernel_ui_y(16), step_label(step), step_color(step), color_panel())

    draw_stepper(step)

    // Card panel: a real bordered rounded card now (soft drop shadow, then
    // border-color rounded rect, then a 2px-inset panel-fill rounded rect)
    // -- the rect-only approximation this file used to disclose is gone.
    ling_kernel_fb_back_blend_rrect(ling_kernel_ui_x(24), ling_kernel_ui_y(106), ling_kernel_ui_len(920), ling_kernel_ui_len(460), ling_kernel_ui_len(12), ling_kernel_theme_color(11), 70)
    ling_kernel_fb_back_fill_rrect(ling_kernel_ui_x(20), ling_kernel_ui_y(100), ling_kernel_ui_len(920), ling_kernel_ui_len(460), ling_kernel_ui_len(12), color_panel_border())
    ling_kernel_fb_back_fill_rrect(ling_kernel_ui_x(22), ling_kernel_ui_y(102), ling_kernel_ui_len(916), ling_kernel_ui_len(456), ling_kernel_ui_len(11), color_panel())
}

// Real if/else on `i == cursor`, not an arithmetic blend on the comparison
// result -- unlike `left_down` elsewhere (which comes from `buttons % 2`,
// a genuine modulo, always exactly 0 or 1), whether `==`'s result is safe
// to use directly in arithmetic was never actually confirmed, and an
// earlier blended-color version of this function rendered every row
// identically blank (confirmed via an actual screendump) rather than
// highlighting the cursor row -- real if/else is the proven-reliable
// construct here. Selected rows get a colored ring (border rect + inset
// fill), not a solid block, matching the reference mockup's bordered-
// selection style rather than an inverted-fill one.
fn draw_locale_row(i, y, cursor) {
    bind native = ling_kernel_locale_native_name(i)
    bind daemon = ling_kernel_locale_uses_daemon(i)
    bind flag_id = ling_kernel_locale_flag_id(i)
    bind px = ling_kernel_ui_x(36)
    bind py = ling_kernel_ui_y(y - 3)
    bind pw = ling_kernel_ui_len(860)
    bind ph = ling_kernel_ui_len(24)
    bind flag_x = ling_kernel_ui_x(44)
    bind flag_y = ling_kernel_ui_y(y)
    bind flag_w = ling_kernel_ui_len(26)
    bind flag_h = ling_kernel_ui_len(17)
    bind text_x = ling_kernel_ui_x(82)
    bind text_y = ling_kernel_ui_y(y + 1)
    if i == cursor {
        // Rounded selection ring (rrect border + inset rrect fill) -- same
        // ring idiom as before, no longer square-cornered.
        ling_kernel_fb_back_fill_rrect(px, py, pw, ph, 6, color_accent_for(cursor))
        ling_kernel_fb_back_fill_rrect(px + 2, py + 2, pw - 4, ph - 4, 5, color_panel())
        ling_kernel_fb_draw_flag(flag_id, flag_x, flag_y, flag_w, flag_h)
        ling_kernel_fb_draw_utf8_str(text_x, text_y, native, color_text(), color_panel(), daemon)
    } else {
        ling_kernel_fb_back_fill_rect(px, py, pw, ph, color_panel())
        ling_kernel_fb_draw_flag(flag_id, flag_x, flag_y, flag_w, flag_h)
        ling_kernel_fb_draw_utf8_str(text_x, text_y, native, color_dim(), color_panel(), daemon)
    }
}

// The selection ring's color tracks the *current step's* accent (Language
// vs Locale get different colors while browsing the same 9-entry table),
// not a single fixed accent -- ties the picker visually to the stepper dot
// it belongs to. `cursor` isn't the step index, so this can't just be
// `step_color(cursor)`; callers pass the active step in explicitly.
fn color_accent_for(step) {
    return step_color(step)
}

// 9 locales in `drivers::locale`'s table -- explicitly unrolled rather
// than looped, since a `while`-loop counter is exactly the kind of frame-
// to-frame mutable state `.ling`'s AOT kernel path doesn't have (see
// `drivers::locale::select`'s doc for the same reasoning applied to the
// selection itself).
fn draw_locale_picker(title, step) {
    draw_screen_frame(title, step)
    bind cursor = ling_kernel_locale_cursor()
    draw_locale_row(0, 132, cursor)
    draw_locale_row(1, 158, cursor)
    draw_locale_row(2, 184, cursor)
    draw_locale_row(3, 210, cursor)
    draw_locale_row(4, 236, cursor)
    draw_locale_row(5, 262, cursor)
    draw_locale_row(6, 288, cursor)
    draw_locale_row(7, 314, cursor)
    draw_locale_row(8, 340, cursor)
    ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(380), "up/down to move, enter to select", color_dim(), color_panel())
    ling_kernel_fb_present()
}

fn locale_picker_handle_key(key) {
    if key == 17 {
        // UP_ARROW, see keyboard.rs -- reported as DC1 (0x11)
        ling_kernel_locale_cursor_up()
    } else if key == 18 {
        // DOWN_ARROW -- DC2 (0x12)
        ling_kernel_locale_cursor_down()
    } else if key == 10 {
        // Enter -- scancode 0x1C maps to '\n' (LF), not '\r' (confirmed
        // against keyboard.rs's SCANCODE_ASCII table).
        ling_kernel_locale_confirm_cursor()
    }
}

// Run the picker until a selection is made -- a real `while` loop over
// kernel-side state (`ling_kernel_locale_selected`), not an unrolled
// per-frame step, since callers that just want "block until picked" (the
// installer) shouldn't have to drive the loop themselves the way the WM's
// own always-running frame loop does. Always resets first: this table
// doubles as both "system language" and "locale/timezone" in the GUI
// installer's wizard (see its module doc for why one table serves both),
// so calling this a second time for the second step needs to forget the
// first pick, not just re-report it instantly. `step` is the wizard's
// 0..7 stepper index (see `step_label`), not a 1-based "page N of total".
fn run_locale_picker(title, step) {
    ling_kernel_locale_reset()
    bind locale_count = ling_kernel_locale_count()
    while ling_kernel_locale_selected() == locale_count {
        draw_locale_picker(title, step)
        bind key = ling_kernel_kbd_poll_char()
        locale_picker_handle_key(key)
    }
}

// Keyboard-layout picker -- same ring-highlight idiom as
// `draw_locale_row`, simpler since there's no flag/native-script glyph to
// draw, just an ASCII layout name (`drivers::kbdlayout`'s module doc: 5
// real ASCII-position remaps, US QWERTY default).
fn draw_kbdlayout_row(i, y, cursor) {
    bind name = ling_kernel_kbd_layout_name(i)
    bind px = ling_kernel_ui_x(36)
    bind py = ling_kernel_ui_y(y - 3)
    bind pw = ling_kernel_ui_len(400)
    bind ph = ling_kernel_ui_len(28)
    bind text_x = ling_kernel_ui_x(52)
    bind text_y = ling_kernel_ui_y(y + 2)
    if i == cursor {
        ling_kernel_fb_back_fill_rrect(px, py, pw, ph, 6, step_color(0))
        ling_kernel_fb_back_fill_rrect(px + 2, py + 2, pw - 4, ph - 4, 5, color_panel())
        ling_kernel_fb_draw_str(text_x, text_y, name, color_text(), color_panel())
    } else {
        ling_kernel_fb_back_fill_rect(px, py, pw, ph, color_panel())
        ling_kernel_fb_draw_str(text_x, text_y, name, color_dim(), color_panel())
    }
}

// 5 layouts in `drivers::kbdlayout`'s table -- unrolled for the same
// reason `draw_locale_picker` unrolls its 9 rows.
fn draw_kbdlayout_picker(title, step) {
    draw_screen_frame(title, step)
    bind cursor = ling_kernel_kbd_layout_cursor()
    draw_kbdlayout_row(0, 132, cursor)
    draw_kbdlayout_row(1, 168, cursor)
    draw_kbdlayout_row(2, 204, cursor)
    draw_kbdlayout_row(3, 240, cursor)
    draw_kbdlayout_row(4, 276, cursor)
    ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(320), "up/down to move, enter to select", color_dim(), color_panel())
    ling_kernel_fb_present()
}

fn kbdlayout_picker_handle_key(key) {
    if key == 17 {
        ling_kernel_kbd_layout_cursor_up()
    } else if key == 18 {
        ling_kernel_kbd_layout_cursor_down()
    } else if key == 10 {
        ling_kernel_kbd_layout_confirm_cursor()
    }
}

// Blocks until Enter confirms a layout -- mirrors `run_locale_picker`
// exactly, including applying immediately (`kbdlayout::confirm_cursor`
// sets the *active* layout, not just a remembered choice), so every
// keystroke after this screen -- including the rest of the installer --
// already uses whatever the user just picked.
fn run_kbdlayout_picker(title, step) {
    ling_kernel_kbd_layout_reset()
    bind layout_count = ling_kernel_kbd_layout_count()
    while ling_kernel_kbd_layout_selected() == layout_count {
        draw_kbdlayout_picker(title, step)
        bind key = ling_kernel_kbd_poll_char()
        kbdlayout_picker_handle_key(key)
    }
}
