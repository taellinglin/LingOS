# Build outputs (ISOs, kernel binaries, SD card images, screenshots) —
# regenerated by live/build-*.sh / build-*.ps1, not source.
/dist/

# Local copy of `ling.exe` built from ../ling and used for all OS builds —
# a build artifact (~14MB), not source; rebuild via `cargo build --release
# --bin ling` in ../ling and copy it here.
/bin/

# Generated per-kernel-target Cargo build projects (ling.exe writes a
# fresh one under each kernel/<target>/ on every build).
**/.ling-build/

# GRUB ISO staging directories built by live/build-iso-*.sh.
live/.isoroot*/

# lingfu seed keyfile -- this derives the encryption key for seed.wav's
# integrity manifest (see `lingfu seed --help`); it's the root of trust,
# not something to publish alongside the thing it's meant to protect.
.moon-salt

# Shamir recovery shares for the above -- any 2 of 3 reconstruct the key
# without .moon-salt. Move each file to a genuinely separate location
# (they're only useless to a thief while they're apart); this folder is
# just where `lingfu seed --recover-init` wrote them, not where they
# should end up living.
.moon-salt-recovery/

# Editor/OS cruft.
.DS_Store
Thumbs.db
*.swp
*~
