# Build outputs (ISOs, kernel binaries, SD card images, screenshots) —
# regenerated by live/build-*.sh / build-*.ps1, not source.
/dist/

# Generated per-kernel-target Cargo build projects (ling.exe writes a
# fresh one under each kernel/<target>/ on every build).
**/.ling-build/

# GRUB ISO staging directories built by live/build-iso-*.sh.
live/.isoroot*/

# Reference/demo audio (packages/tensormap) — 174MB/99MB, over or right at
# GitHub's 100MB hard file-size limit. Not LingOS source; keep locally.
packages/tensormap/x.wav
packages/tensormap/y.wav

# Editor/OS cruft.
.DS_Store
Thumbs.db
*.swp
*~
