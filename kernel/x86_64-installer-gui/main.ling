// LingOS — graphics-mode installer front-end (the GRUB "Install (GUI)"
// entry). The actual install work (mount, persist locale/hostname, package
// install, bootloader write) lives in apps/installer/main.ling, shared
// with the text-mode front-end (kernel/x86_64-installer) -- this file is
// UI only, rendered into the framebuffer instead of the VGA text console.
// The header/stepper/card-panel chrome and color palette come from
// apps/gui-common/main.ling's `draw_screen_frame`, so every screen here
// (and the Live desktop's own locale picker) shares one consistent look.
//
// 8-step flow (see gui-common's `step_label`): Keyboard -> Language ->
// Locale (timezone + hostname + mount) -> Root -> User -> Network ->
// Packages -> Finish. Language and locale/timezone are two independent
// picks over the *same* 9-entry table (see drivers::locale's module doc)
// -- this project doesn't have a separate "language" table distinct from
// "region", so "choose language, then choose locale/timezone" is honestly
// two passes over one list (gui-common's `run_locale_picker` resets
// between calls so the second pick isn't just an instant echo of the
// first), not two different data sources. Only the locale/timezone pick is
// actually persisted (`/locale`) and used for the picked-locale UI
// elsewhere (native-script titles, the Live desktop); the language pick is
// recorded to `/language` but doesn't yet drive full UI translation --
// this project's curated Unicode glyph coverage (see font_unicode's module
// doc) is a handful of phrases per script, not enough vocabulary to
// translate arbitrary installer prompts, so the screens below stay in
// English regardless of the language step's choice. Disclosed here rather
// than silently claimed as more than it is.
//
// Fully keyboard-driven, no mouse: the locale/keyboard-layout pickers are
// arrow-key/Enter (a highlighted row, not a raw digit press), and root/
// user passwords are typed twice and checked
// (`ling_kernel_gui_read_password_confirmed`, retrying on a mismatch)
// rather than trusted on one entry. Still no mouse-driven widgets
// (buttons, click-into text fields) -- everything here is full-screen, one
// step at a time, the same "render a screen, block on one read" idiom as
// the text installer, just rendered as pixels instead of VGA text. A real
// Next/Back multi-widget wizard is still future work. The reference
// mockup's rounded panels, circular stepper dots, disk-selection cards,
// live time/timezone-by-city preview, and WiFi network picker aren't
// replicated -- no rounded-rect primitive, no disk enumeration, no RTC
// write support, no per-city timezone database, and no WiFi driver exist
// in this kernel; this screen adopts the mockup's visual language (dark
// palette, stepper bar, bordered card, ring-selected rows) onto the 8
// steps this kernel can actually back, rather than faking screens with
// nothing real behind them.
use "../../apps/gui-common/main"
use "../../apps/installer/main"

fn draw_status(title, step, text) {
    draw_screen_frame(title, step)
    // ling_kernel_tr translates to the chosen language (echoes English if there's
    // no entry); utf8 draw so CJK/Thai render. Daemon reskin for Ling Country.
    ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(132), ling_kernel_tr(text), color_text(), color_panel(), ling_kernel_render_daemon())
    ling_kernel_fb_present()
}

fn draw_prompt_and_read(title, step, label) {
    draw_screen_frame(title, step)
    ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(132), ling_kernel_tr(label), color_text(), color_panel(), ling_kernel_render_daemon())
    ling_kernel_fb_present()
    return ling_kernel_gui_read_line(ling_kernel_ui_x(36), ling_kernel_ui_y(162), color_text(), color_panel())
}

// Prompts for a password, typed twice, retrying (drawn by the intrinsic
// itself -- see its doc) until the two entries match.
fn draw_prompt_and_read_password(title, step, label) {
    draw_screen_frame(title, step)
    ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(132), ling_kernel_tr(label), color_text(), color_panel(), ling_kernel_render_daemon())
    ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(158), ling_kernel_tr("Password:"), color_dim(), color_panel(), ling_kernel_render_daemon())
    ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(208), ling_kernel_tr("Confirm password:"), color_dim(), color_panel(), ling_kernel_render_daemon())
    ling_kernel_fb_present()
    return ling_kernel_gui_read_password_confirmed(
        ling_kernel_ui_x(36), ling_kernel_ui_y(178), ling_kernel_ui_y(228), ling_kernel_ui_y(258),
        color_text(), color_panel(), color_error()
    )
}

bind start = do {
    ling_kernel_init()
    ling_kernel_mouse_init()

    bind avail = ling_kernel_fb_available()
    if avail == 0 {
        ling_kernel_vga_write_str("no framebuffer -- the GUI installer needs graphics mode (use Install [text] instead)\n")
    } else {
        // Go 1920x1080 if the adapter supports it (DISPI live mode-set), so the
        // installer looks crisp on a large panel; a no-op on non-DISPI cards,
        // where GRUB's negotiated mode stays and ui_scale letterboxes to it.
        ling_kernel_fb_try_mode(1920, 1080)
        bind fb_w = ling_kernel_fb_width()
        bind fb_h = ling_kernel_fb_height()
        ling_kernel_mouse_set_bounds(fb_w, fb_h)

        run_kbdlayout_picker("Choose your keyboard layout", 0)

        run_locale_picker("Choose your system language", 1)
        bind lang_idx = ling_kernel_locale_selected()

        run_locale_picker("Choose your locale and timezone", 2)
        bind locale_idx = ling_kernel_locale_selected()

        // The two pickers each reset+set the shared locale selection, so it now
        // holds the timezone pick. Re-select the step-1 LANGUAGE so every later
        // step (Disk..Finish) renders via ling_kernel_tr in the chosen language.
        // (installer_save_locale below still persists the timezone via locale_idx.)
        ling_kernel_locale_select(lang_idx)

        // Disk step: name the real target device and require the word
        // ERASE typed in full before touching it -- an install that wipes
        // a disk should never be one accidental Enter away. Anything else
        // typed parks the installer (reboot to start over). The erase
        // itself is the honest quick-erase (boot sectors + filesystem
        // headers zeroed; see ling_kernel_disk_erase_quick's doc).
        // One screen: the target device, WHAT'S ALREADY ON IT (partition
        // table -- so a multiboot user sees any Windows/Linux at risk), the
        // erase warning, and the ERASE confirmation, all together.
        draw_screen_frame("Confirm erase", 3)
        ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(118), ling_kernel_tr("Detected disk (the only one this kernel drives today):"), color_text(), color_panel(), ling_kernel_render_daemon())
        ling_kernel_fb_back_fill_rrect(ling_kernel_ui_x(36), ling_kernel_ui_y(142), ling_kernel_ui_len(400), ling_kernel_ui_len(28), 6, step_color(3))
        ling_kernel_fb_back_fill_rrect(ling_kernel_ui_x(38), ling_kernel_ui_y(144), ling_kernel_ui_len(396), ling_kernel_ui_len(24), 5, color_panel())
        ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(150), ling_kernel_disk_name(), color_text(), color_panel())
        bind pc = ling_kernel_part_count()
        if pc == 0 {
            ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(190), "Disk is blank -- LingOS will use the whole disk.", color_dim(), color_panel())
        } else {
            ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(190), "This disk already contains (erasing removes ALL of it):", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(214), ling_kernel_part_label(0), color_text(), color_panel())
            if pc > 1 {
                ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(234), ling_kernel_part_label(1), color_text(), color_panel())
            }
            if pc > 2 {
                ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(254), ling_kernel_part_label(2), color_text(), color_panel())
            }
            if pc > 3 {
                ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(274), ling_kernel_part_label(3), color_text(), color_panel())
            }
            ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(302), "To keep another OS, install to a machine with free space; the boot", color_dim(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(320), "menu already offers any bootable partition it finds.", color_dim(), color_panel())
        }
        ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(350), ling_kernel_tr("Installing ERASES this disk: bootloader, filesystem, everything."), color_error(), color_panel(), ling_kernel_render_daemon())
        ling_kernel_fb_draw_utf8_str(ling_kernel_ui_x(36), ling_kernel_ui_y(384), ling_kernel_tr("Type ERASE (all caps) to wipe this disk and install:"), color_text(), color_panel(), ling_kernel_render_daemon())
        ling_kernel_fb_present()
        bind confirm = ling_kernel_gui_read_line(ling_kernel_ui_x(36), ling_kernel_ui_y(412), color_text(), color_panel())
        if confirm == "ERASE" {
            draw_status("Erasing disk", 3, "Erasing boot sectors and filesystem headers...")
            bind erase_ok = ling_kernel_disk_erase_quick()
            if erase_ok == 0 {
                draw_status("Erasing disk", 3, "Erase FAILED (disk write error). Reboot and try again.")
                while 1 == 1 {
                    ling_kernel_fb_present()
                }
            }
        } else {
            draw_status("Confirm erase", 3, "Not confirmed -- nothing was written. Reboot to start over.")
            while 1 == 1 {
                ling_kernel_fb_present()
            }
        }

        draw_status("Choose the installation disk", 3, "Mounting disk...")
        bind fs_ok = installer_mount()
        if fs_ok == 0 {
            draw_status("Setup", 3, "Disk mount FAILED -- cannot install. Reboot and try again.")
            while 1 == 1 {
                ling_kernel_fb_present()
            }
        }
        installer_save_locale(locale_idx)
        ling_kernel_fs_write("/language", ling_kernel_locale_id(lang_idx))

        bind hn = draw_prompt_and_read("Choose the installation disk", 3, "Hostname for this system:")
        installer_save_hostname(hn)

        bind root_pw = draw_prompt_and_read_password("Root account", 4, "Set a password for the root account:")
        installer_create_root(root_pw)

        bind user_name = draw_prompt_and_read("User account", 5, "Create a user account (username, blank to skip):")
        if len(user_name) != 0 {
            bind user_pw = draw_prompt_and_read_password("User account", 5, "Password for this account:")
            installer_create_user(user_name, user_pw)
        }

        draw_status("Network", 6, "Setting up network...")
        bind net_ok = installer_net_attempt()
        if net_ok == 1 {
            draw_status("Network", 6, "Adapter found, link up -- package registry + SSH available.")
        } else {
            draw_status("Network", 6, "No adapter found -- continuing offline.")
        }

        // SSH server: a real service now (drivers::services). Enabling it here
        // writes /services on the target -- the installed system starts sshd at
        // boot, and (since /services then exists) first boot won't re-ask.
        bind ssh_ans = draw_prompt_and_read("Network", 6, "Start the SSH server at boot? (yes/no):")
        if ssh_ans == "yes" {
            installer_set_ssh(1)
            draw_status("Network", 6, "SSH server enabled at boot.")
        } else {
            installer_set_ssh(0)
            draw_status("Network", 6, "SSH server left disabled (enable later in Settings).")
        }

        // Package sets: curated ling-* bundles pulled from the public registry
        // (fu.ling-lang.org) into the target filesystem. Needs a NIC; without
        // one we install the base system only.
        if net_ok == 1 {
            draw_screen_frame("Packages", 7)
            ling_kernel_fb_draw_str(ling_kernel_ui_x(36), ling_kernel_ui_y(112), "Choose a package set to install now:", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(140), "1  None     - base system only", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(160), "2  Minimal  - ling-core", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(180), "3  Game     - ling-core, ling-game, ling-graphics, ling-audio", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(200), "4  Crypto   - ling-core, ling-crypto", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(220), "5  AI       - ling-core, ling-ai", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(240), "6  Web      - ling-core, ling-http, ling-graphics", color_text(), color_panel())
            ling_kernel_fb_draw_str(ling_kernel_ui_x(52), ling_kernel_ui_y(260), "7  Custom   - type one package name", color_text(), color_panel())
            ling_kernel_fb_present()
            bind pset = draw_prompt_and_read("Packages", 7, "Package set (1-7):")
            if pset == "7" {
                bind cname = draw_prompt_and_read("Packages", 7, "Package name from the registry (blank to skip):")
                if len(cname) != 0 {
                    draw_status("Packages", 7, "Installing from the registry (this can take a moment)...")
                    installer_install_from_registry(cname)
                    draw_status("Packages", 7, "Package install attempted -- see console for detail.")
                }
            } else if pset == "2" {
                draw_status("Packages", 7, "Installing Minimal (ling-core) from the registry...")
                installer_install_from_registry("ling-core")
                draw_status("Packages", 7, "Package set installed.")
            } else if pset == "3" {
                draw_status("Packages", 7, "Installing Game set from the registry (this can take a minute)...")
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-game")
                installer_install_from_registry("ling-graphics")
                installer_install_from_registry("ling-audio")
                draw_status("Packages", 7, "Package set installed.")
            } else if pset == "4" {
                draw_status("Packages", 7, "Installing Crypto set from the registry...")
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-crypto")
                draw_status("Packages", 7, "Package set installed.")
            } else if pset == "5" {
                draw_status("Packages", 7, "Installing AI set from the registry...")
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-ai")
                draw_status("Packages", 7, "Package set installed.")
            } else if pset == "6" {
                draw_status("Packages", 7, "Installing Web set from the registry...")
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-http")
                installer_install_from_registry("ling-graphics")
                draw_status("Packages", 7, "Package set installed.")
            } else {
                draw_status("Packages", 7, "No packages selected -- installing the base system only.")
            }
        } else {
            draw_status("Packages", 7, "No network adapter: installing the base system only.")
        }

        draw_status("Finishing up", 8, "Installing bootloader...")
        bind boot_ok = installer_write_bootloader()
        if boot_ok == 0 {
            draw_status("Finishing up", 8, "No boot payload found -- this disk will NOT boot standalone.")
        } else {
            draw_status("Finishing up", 8, "Done. Remove the installation media and reboot.")
        }
        while 1 == 1 {
            ling_kernel_fb_present()
        }
    }
}
