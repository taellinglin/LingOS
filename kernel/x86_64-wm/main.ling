// LingOS "Live" desktop -- the GRUB "Live" entry boots straight into this
// (graphics-mode) target now, not the text shell (kernel/x86_64, still
// used for Rescue and the old CLI-only path). Real event loop, a rendered
// mouse cursor tracking the PS/2 mouse, and a "liquid" window you can drag
// by holding the left button anywhere over it -- it springs toward the
// cursor with damped-oscillator physics instead of snapping there
// instantly, with a velocity-driven squash/stretch on top, for a
// soap-film/jelly feel. Draws into framebuffer.rs's back buffer and blits
// once per frame (ling_kernel_fb_present) rather than drawing shapes
// straight into the live framebuffer -- that tore visibly on every frame
// once anything moved (confirmed by an actual screendump catching a
// mid-redraw frame).
//
// The spring simulation's state (position, velocity) lives kernel-side
// (`ling_kernel_wm_liquid_*`, see `drivers/wm_liquid.rs`'s module doc) --
// there's no mutable-reassignment construct in this language and the
// compiler does no tail-call optimization, so nothing on this side of the
// FFI boundary can safely hold state that persists frame to frame in a loop
// that runs forever. `ling_kernel_wm_liquid_step` advances the simulation
// one frame toward wherever this file says the window's *target* should
// be; everything else here (input, layout, what to actually draw) stays in
// `.ling`, same as always.
//
// Honest scope: this is still a minimal desktop -- one draggable window and
// a locale picker, not the file explorer/editor/media apps/dock a full
// desktop implies. Those don't exist yet (see the project backlog). What's
// real here: a default "live" account is actually created and logged in
// (not just displayed), lingfs is actually mounted, and a real e1000
// init attempt is made and its real status shown -- not faked. There's no
// Wi-Fi driver (out of scope -- see the networking plan) and the e1000
// driver's packet delivery itself is still an open bug (see drivers::
// net_e1000's module doc), so "connect to the internet" here means "try,
// and honestly report whether the NIC came up" -- not a working connection.
use "../../apps/gui-common/main"

bind start = do {
    ling_kernel_init()
    ling_kernel_mouse_init()

    bind avail = ling_kernel_fb_available()
    if avail == 0 {
        ling_kernel_vga_write_str("no framebuffer -- the Live desktop needs graphics mode\n")
    } else {
        bind fb_w = ling_kernel_fb_width()
        bind fb_h = ling_kernel_fb_height()
        ling_kernel_mouse_set_bounds(fb_w, fb_h)

        // A real, serial-visible "we got this far" marker -- vga_write_str
        // mirrors to serial regardless of display mode (console_write's
        // doc), so this is a genuine regression check for the exact class
        // of bug this session already hit once (a silent pre-loop hang
        // from a double PS/2 mouse handshake looked identical to "just
        // slow" until a screendump caught the black screen). boot-test.sh
        // checks for this line on the default (Live) GRUB entry.
        ling_kernel_vga_write_str("wm: entering interactive loop\n")

        run_locale_picker("Welcome to LingOS -- choose a language / locale", 1, 1)
        bind locale_idx = ling_kernel_locale_selected()

        // One-time setup, now that a locale is picked: mount, a default
        // account so this is a real logged-in session (not anonymous
        // root), and a real (not simulated) network bring-up attempt.
        ling_kernel_fs_mount()
        ling_kernel_user_create("live", "live", "Live", "User", "", "", "users")
        ling_kernel_user_login("live", "live")
        bind net_ok = ling_kernel_net_init()

        // Sized in virtual-canvas units (drivers::ui_scale's module doc),
        // like every installer screen -- proportionate to the real screen
        // instead of a fixed 320x200 that'd look tiny on a big monitor or
        // oversized on a small one. Position (rx/ry below) stays real-pixel
        // throughout: it follows the real mouse cursor, which is already in
        // real framebuffer pixel space, not a design-canvas one.
        bind ww = ling_kernel_ui_len(320)
        bind wh = ling_kernel_ui_len(200)
        bind titlebar_h = ling_kernel_ui_len(24)

        while 1 == 1 {
            ling_kernel_mouse_poll()
            bind mx = ling_kernel_mouse_x()
            bind my = ling_kernel_mouse_y()
            bind buttons = ling_kernel_mouse_buttons()
            bind left_down = buttons % 2

            // No conditional-expression construct in Ling, and a `bind`
            // inside an if/else doesn't escape it for use afterward -- so
            // "target is 100 normally, mx-40 while dragging" has to be one
            // arithmetic expression, not a branch. `left_down` is exactly
            // 0 or 1, so one term always zeroes out.
            bind target_x = 100 * (1 - left_down) + (mx - 40) * left_down
            bind target_y = 100 * (1 - left_down) + (my - 12) * left_down

            ling_kernel_wm_liquid_step(target_x, target_y)
            bind wx = ling_kernel_wm_liquid_x()
            bind wy = ling_kernel_wm_liquid_y()
            bind scale_w_pct = ling_kernel_wm_liquid_scale_w_pct()
            bind scale_h_pct = ling_kernel_wm_liquid_scale_h_pct()

            // Scale around the window's own center rather than its
            // top-left corner, so a stretch reads as the sheet swelling in
            // place instead of the window drifting as it deforms.
            bind ww2 = ww * scale_w_pct / 100
            bind wh2 = wh * scale_h_pct / 100
            bind rx = wx - (ww2 - ww) / 2
            bind ry = wy - (wh2 - wh) / 2

            bind title = ling_kernel_locale_native_name(locale_idx)
            bind title_daemon = ling_kernel_locale_uses_daemon(locale_idx)

            ling_kernel_fb_back_clear(2236962)
            ling_kernel_fb_back_fill_rect(rx, ry, ww2, wh2, 3618615)
            ling_kernel_fb_back_fill_rect(rx, ry, ww2, titlebar_h, 1710757)
            ling_kernel_fb_draw_utf8_str(rx + 6, ry + 4, title, 16777215, 1710757, title_daemon)
            ling_kernel_fb_back_fill_rect(mx, my, 8, 8, 16777215)

            // Real (not decorative) network status, bottom-left. `fb_h`
            // (not a ui_y() call) since this anchors to the real bottom
            // edge, not a virtual-canvas position.
            if net_ok == 1 {
                ling_kernel_fb_draw_str(ling_kernel_ui_x(20), fb_h - 24, "network: NIC up (internet not yet reachable)", 11184810, 2236962)
            } else {
                ling_kernel_fb_draw_str(ling_kernel_ui_x(20), fb_h - 24, "network: no NIC found", 11184810, 2236962)
            }
            ling_kernel_fb_present()
        }
    }
}
