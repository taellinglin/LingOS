// LingOS "Live" desktop -- now a real multi-window desktop environment:
// overlapping windows with z-order/focus/titlebar-drag/close/minimize
// (state + hit-testing kernel-side in `drivers::wm`, see its module doc
// for the honest scope note: kernel-side windows, not yet an X-style
// client/server protocol), a dock with launchers and running indicators,
// a top bar with a real RTC clock in the selected locale's UTC offset,
// theme-driven chrome (`drivers::theme` -- switchable live from the
// Settings window), a gradient wallpaper, and per-window "liquid" spring
// physics (the same damped-oscillator feel the old single window had,
// now per-window).
//
// Division of labour, unchanged in spirit from the old file: every
// *drawing decision* for the chrome (shadows, frames, titlebars, dock,
// cursor) is written here in `.ling`; the kernel supplies state getters,
// hit-tested input routing (`wm_step`/`wm_key`), and content interiors
// (`wm_draw_content` -- Settings rows and file listings need loops over
// runtime-sized data, which kernel-path `.ling` can't express; see
// `drivers::wm`'s module doc).
//
// The window slots below are unrolled 0..5 (MAX_WINDOWS) for the same
// documented reason gui-common unrolls its rows: no counter-carrying
// loop construct exists on this side of the FFI.
//
// Boot flows, both real: a GRUB/Live boot auto-creates and logs in the
// "live" account (a real account, really logged in) after the locale
// picker; an installed-disk boot (`ling_kernel_boot_is_disk`, the
// stage1/stage2 path with no Multiboot2 info) instead shows the login
// greeter below -- username/password against the real accounts created
// during installation, retrying until `ling_kernel_user_login` actually
// succeeds. No fake session either way.
use "../../apps/gui-common/main"

// One greeter attempt: draw the card (theme-driven, same rounded look as
// every other surface), read username + masked password at fixed field
// positions, try the real login. Returns the login result so the caller's
// retry loop can keep asking until it's 1.
fn greeter_attempt(fb_w, fb_h) {
    ling_kernel_wm_draw_wallpaper()
    bind cw = ling_kernel_ui_len(420)
    bind ch = ling_kernel_ui_len(240)
    bind cx = (fb_w - cw) / 2
    bind cy = (fb_h - ch) / 2 - ling_kernel_ui_len(30)
    ling_kernel_fb_back_blend_rrect(cx + 5, cy + 7, cw, ch, 12, ling_kernel_theme_color(11), 80)
    ling_kernel_fb_back_fill_rrect(cx, cy, cw, ch, 12, ling_kernel_theme_color(2))
    ling_kernel_fb_back_fill_rrect(cx + 1, cy + 1, cw - 2, ch - 2, 11, ling_kernel_theme_color(1))
    ling_kernel_fb_draw_str(cx + 24, cy + 20, "LingOS", ling_kernel_theme_color(10), ling_kernel_theme_color(1))
    ling_kernel_fb_draw_str(cx + 24, cy + 44, "log in to your installed system", ling_kernel_theme_color(4), ling_kernel_theme_color(1))
    ling_kernel_fb_draw_str(cx + 24, cy + 84, "user:", ling_kernel_theme_color(3), ling_kernel_theme_color(1))
    ling_kernel_fb_draw_str(cx + 24, cy + 124, "password:", ling_kernel_theme_color(3), ling_kernel_theme_color(1))
    ling_kernel_fb_present()
    bind username = ling_kernel_gui_read_line(cx + 110, cy + 84, ling_kernel_theme_color(3), ling_kernel_theme_color(1))
    bind password = ling_kernel_gui_read_line_masked(cx + 110, cy + 124, ling_kernel_theme_color(3), ling_kernel_theme_color(1))
    bind ok = ling_kernel_user_login(username, password)
    if ok == 0 {
        // Explicit, standard wording; drawn in the error color and held on
        // screen a moment (error jingle) so a wrong user/pass is obvious.
        ling_kernel_fb_draw_str(cx + 24, cy + 164, "Invalid username or password.", ling_kernel_theme_color(5), ling_kernel_theme_color(1))
        ling_kernel_fb_present()
        ling_kernel_audio_jingle(4)
    } else {
        ling_kernel_audio_jingle(5)
    }
    return ok
}

// One window at z slot `s` (back-to-front, painter's-algorithm order):
// the whole thing -- shadow, the soap-film-bending rounded body, titlebar,
// traffic lights, content, and the dissolve-on-close animation -- is now
// drawn kernel-side (`drivers::wm::draw_window`), because a bend is a
// per-scanline horizontal shear and a dissolve is per-cell fade, neither
// of which the fixed-rect `.ling` primitives can express. This file just
// asks for each slot in order.
fn draw_win_slot(s, count) {
    if s < count {
        ling_kernel_wm_draw_window(s)
    }
}

// One dock launcher: hover halo, rounded icon plate, glyph letter, and a
// running-indicator dot underneath when a window of that kind is open.
fn draw_dock_slot(i) {
    bind dx = ling_kernel_wm_dock_x(i)
    bind dy = ling_kernel_wm_dock_y()
    bind sz = ling_kernel_wm_dock_size()
    bind hover = ling_kernel_wm_dock_hover(i)
    bind running = ling_kernel_wm_dock_running(i)
    if hover == 1 {
        ling_kernel_fb_back_fill_rrect(dx - 3, dy - 3, sz + 6, sz + 6, 12, ling_kernel_theme_color(10))
    }
    ling_kernel_fb_back_fill_rrect(dx, dy, sz, sz, 10, ling_kernel_theme_color(1))
    ling_kernel_fb_draw_str(dx + sz / 2 - 4, dy + sz / 2 - 8, ling_kernel_wm_dock_letter(i), ling_kernel_theme_color(3), ling_kernel_theme_color(1))
    if running == 1 {
        ling_kernel_fb_back_fill_circle(dx + sz / 2, dy + sz + 7, 3, ling_kernel_theme_color(10))
    }
}

bind start = do {
    ling_kernel_init()
    ling_kernel_mouse_init()

    bind avail = ling_kernel_fb_available()
    if avail == 0 {
        ling_kernel_vga_write_str("no framebuffer -- the Live desktop needs graphics mode\n")
    } else {
        bind fb_w = ling_kernel_fb_width()
        bind fb_h = ling_kernel_fb_height()
        ling_kernel_mouse_set_bounds(fb_w, fb_h)

        // Serial-visible progress marker -- boot-test.sh greps for this
        // exact line on the default (Live) GRUB entry; see the old file's
        // comment for the real regression this guards against.
        ling_kernel_vga_write_str("wm: entering interactive loop\n")

        // Audio first so both flows get their jingles -- returns 0 with no
        // AC'97 device, and every audio call no-ops in that case.
        bind audio_ok = ling_kernel_audio_init()

        bind disk_boot = ling_kernel_boot_is_disk()
        // One-time setup: mount the filesystem (accounts/settings live in
        // it); for Live, pick a locale and create the auto-login account
        // once. For an installed disk, default the locale (install-time
        // persistence is still roadmap).
        ling_kernel_fs_mount()
        if disk_boot == 1 {
            ling_kernel_locale_reset()
            ling_kernel_locale_confirm_cursor()
        } else {
            run_locale_picker("Welcome to LingOS -- choose a language / locale", 1)
            ling_kernel_user_create("live", "live", "Live", "User", "", "", "users")
        }
        bind net_ok = ling_kernel_net_init()

        // Session loop: log in, run the desktop until "Log Out" is picked
        // from the Power menu, then come back here to re-authenticate. On
        // an installed disk that means the greeter again; on Live it just
        // re-logs the live account.
        while 1 == 1 {
            if disk_boot == 1 {
                while greeter_attempt(fb_w, fb_h) == 0 {
                    ling_kernel_vga_write_str("greeter: invalid credentials, retrying\n")
                }
                ling_kernel_vga_write_str("greeter: logged in\n")
            } else {
                ling_kernel_user_login("live", "live")
            }
            bind locale_idx = ling_kernel_locale_selected()
            if audio_ok == 1 {
                ling_kernel_audio_jingle(0)
            }
            ling_kernel_wm_clear_logout()
            ling_kernel_wm_open(0)

            while ling_kernel_wm_logout_requested() == 0 {
            ling_kernel_mouse_poll()
            bind mx = ling_kernel_mouse_x()
            bind my = ling_kernel_mouse_y()
            bind buttons = ling_kernel_mouse_buttons()

            // All click routing (dock, titlebars, buttons, drags) and the
            // spring advance happen kernel-side in one call; keys go to
            // whichever window is focused.
            ling_kernel_wm_step(mx, my, buttons)
            ling_kernel_audio_pump()
            bind k = ling_kernel_kbd_poll_char()
            if k > 0 {
                ling_kernel_wm_key(k)
            }

            // -- Draw the frame, back to front. ------------------------
            ling_kernel_wm_draw_wallpaper()

            // Top bar: brand left (also the Applications-menu button),
            // live RTC clock (locale-offset) right.
            ling_kernel_fb_back_fill_rect(0, 0, fb_w, 30, ling_kernel_theme_color(1))
            ling_kernel_fb_back_fill_rect(0, 30, fb_w, 1, ling_kernel_theme_color(2))
            ling_kernel_fb_draw_str(12, 8, "= LingOS", ling_kernel_theme_color(10), ling_kernel_theme_color(1))
            ling_kernel_fb_draw_utf8_str(90, 8, ling_kernel_locale_native_name(locale_idx), ling_kernel_theme_color(4), ling_kernel_theme_color(1), ling_kernel_locale_uses_daemon(locale_idx))
            ling_kernel_fb_draw_str(fb_w - 76, 8, ling_kernel_wm_clock_str(), ling_kernel_theme_color(3), ling_kernel_theme_color(1))

            // Windows, unrolled slots (see file doc for why no loop).
            bind count = ling_kernel_wm_count()
            draw_win_slot(0, count)
            draw_win_slot(1, count)
            draw_win_slot(2, count)
            draw_win_slot(3, count)
            draw_win_slot(4, count)
            draw_win_slot(5, count)

            // Dock: glass plate behind the eight launchers, then each slot.
            bind dsz = ling_kernel_wm_dock_size()
            bind d0 = ling_kernel_wm_dock_x(0)
            bind d7 = ling_kernel_wm_dock_x(7)
            ling_kernel_fb_back_blend_rrect(d0 - 12, ling_kernel_wm_dock_y() - 8, d7 + dsz + 12 - (d0 - 12), dsz + 16, 14, ling_kernel_theme_color(9), 150)
            draw_dock_slot(0)
            draw_dock_slot(1)
            draw_dock_slot(2)
            draw_dock_slot(3)
            draw_dock_slot(4)
            draw_dock_slot(5)
            draw_dock_slot(6)
            draw_dock_slot(7)

            // Applications menu overlays everything (drawn after dock).
            ling_kernel_wm_draw_menu()

            // Tray: volume + ethernet widgets (and the volume popover with
            // master + per-app rows when open) -- drawn after windows so
            // the popover overlays them, matching its input priority.
            ling_kernel_wm_draw_tray(net_ok)

            // Network status stays real and visible, tucked bottom-left.
            if net_ok == 1 {
                ling_kernel_fb_draw_str(10, fb_h - 18, "net: NIC up", ling_kernel_theme_color(4), ling_kernel_theme_color(13))
            } else {
                ling_kernel_fb_draw_str(10, fb_h - 18, "net: none", ling_kernel_theme_color(4), ling_kernel_theme_color(13))
            }

            // Cursor: white dot with a dark ring -- visible on any theme.
            ling_kernel_fb_back_fill_circle(mx, my, 5, 0)
            ling_kernel_fb_back_fill_circle(mx, my, 4, 16777215)

            ling_kernel_fb_present()
        }
        // Logged out -- the session loop's next login step re-authenticates
        // (user_login overwrites the current session), so just loop back.
    }
    }
}
