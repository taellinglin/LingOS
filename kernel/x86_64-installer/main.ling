// LingOS — text-mode installer front-end.
//
// The actual install work (mount, persist locale/hostname, package
// install, bootloader write) lives in apps/installer/main.ling, shared
// with the graphics-mode front-end (kernel/x86_64-installer-gui) -- this
// file is UI only: prompts, reads, and rendering, all through the VGA text
// console. Same 7-step flow as the GUI installer (system language, locale/
// timezone, hostname, network, root account, user account, packages), and
// the same keyboard-only interaction model -- arrow keys + Enter to pick a
// language/locale (a highlighted row via inverted colors, not a raw digit
// press), typed-twice-and-checked passwords for root/user accounts -- see
// that target's module doc for why "language" and "locale/timezone" are
// two passes over the same table rather than two different ones, and why
// full UI translation isn't implemented. After installing, hands off to
// lsh (apps/lsh/main.ling, `use`-shared -- same shell the Live entry
// boots), so the disk it just set up is immediately usable too.
use "../../apps/lsh/main"
use "../../apps/installer/main"

// VGA text mode can't render the CJK/Thai/Daemon scripts `drivers::
// font_unicode` bakes for the graphics-mode locale picker -- no linear
// framebuffer exists here at all (this target keeps the plain Multiboot2
// header, see the framebuffer/text-mode split in `ling_kernel::init`'s
// doc). So this picker is Latin-name-only, a real but visibly smaller
// version of the graphics picker, not the full thing.
fn print_locale_option(i, cursor) {
    bind name = ling_kernel_locale_latin_name(i)
    if i == cursor {
        // Inverted highlight (bright white on blue) for the row under the
        // cursor -- the closest VGA text-mode equivalent of the graphics
        // picker's highlighted row.
        ling_kernel_vga_set_color(15, 1)
    } else {
        ling_kernel_vga_set_color(7, 0)
    }
    ling_kernel_vga_write_str("  ")
    ling_kernel_print_lstr(ling_kernel_locale_id(i))
    ling_kernel_vga_write_str(") ")
    ling_kernel_print_lstr(name)
    ling_kernel_vga_write_str("                                        \n")
    ling_kernel_vga_set_color(7, 0)
}

fn draw_locale_screen(prompt) {
    ling_kernel_vga_clear()
    ling_kernel_vga_set_color(12, 0)
    ling_kernel_vga_write_str("================================================================\n")
    ling_kernel_vga_set_color(15, 0)
    ling_kernel_vga_write_str("  LingOS installer (text)\n")
    ling_kernel_vga_set_color(12, 0)
    ling_kernel_vga_write_str("================================================================\n")
    ling_kernel_vga_set_color(7, 0)
    ling_kernel_vga_write_str(prompt)
    ling_kernel_vga_write_str("\n")
    bind cursor = ling_kernel_locale_cursor()
    print_locale_option(0, cursor)
    print_locale_option(1, cursor)
    print_locale_option(2, cursor)
    print_locale_option(3, cursor)
    print_locale_option(4, cursor)
    print_locale_option(5, cursor)
    print_locale_option(6, cursor)
    print_locale_option(7, cursor)
    print_locale_option(8, cursor)
    ling_kernel_vga_set_color(8, 0)
    ling_kernel_vga_write_str("\nup/down to move, enter to select\n")
    ling_kernel_vga_set_color(7, 0)
}

fn handle_nav_key(key) {
    if key == 17 {
        ling_kernel_locale_cursor_up()
    } else if key == 18 {
        ling_kernel_locale_cursor_down()
    } else if key == 10 {
        ling_kernel_locale_confirm_cursor()
    }
}

// Shared by both the language and locale/timezone steps -- see this file's
// module doc for why they're two passes over the same table.
fn text_pick_locale(prompt) {
    ling_kernel_locale_reset()
    bind locale_count = ling_kernel_locale_count()
    while ling_kernel_locale_selected() == locale_count {
        draw_locale_screen(prompt)
        bind key = ling_kernel_kbd_poll_char()
        handle_nav_key(key)
    }
    return ling_kernel_locale_selected()
}

bind start = do {
    ling_kernel_init()
    ling_kernel_mouse_init()

    bind lang_idx = text_pick_locale("Step 1/7 -- Choose your system language:")
    bind locale_idx = text_pick_locale("Step 2/7 -- Choose your locale and timezone:")

    ling_kernel_vga_clear()
    ling_kernel_vga_set_color(12, 0)
    ling_kernel_vga_write_str("================================================================\n")
    ling_kernel_vga_set_color(15, 0)
    ling_kernel_vga_write_str("  LingOS installer (text)\n")
    ling_kernel_vga_set_color(12, 0)
    ling_kernel_vga_write_str("================================================================\n")
    ling_kernel_vga_set_color(10, 0)
    ling_kernel_vga_write_str("\nLocale: ")
    ling_kernel_print_lstr(ling_kernel_locale_latin_name(locale_idx))
    ling_kernel_vga_write_str("\n")
    ling_kernel_vga_set_color(7, 0)

    // Disk step, same contract as the GUI installer's: name the real
    // target, demand the word ERASE typed in full, quick-erase (boot
    // sectors + filesystem headers) before mounting/formatting. Anything
    // else typed drops to the rescue shell with the disk untouched.
    ling_kernel_vga_write_str("\nInstallation disk: ")
    ling_kernel_print_lstr(ling_kernel_disk_name())
    ling_kernel_vga_set_color(12, 0)
    ling_kernel_vga_write_str("\nInstalling ERASES this disk: bootloader, filesystem, everything.\n")
    ling_kernel_vga_set_color(7, 0)
    ling_kernel_vga_write_str("Type ERASE (all caps) to wipe this disk and install: ")
    bind confirm = ling_kernel_read_line()
    if confirm == "ERASE" {
        bind erase_ok = ling_kernel_disk_erase_quick()
        if erase_ok == 0 {
            ling_kernel_vga_set_color(4, 0)
            ling_kernel_vga_write_str("erase FAILED (disk write error) -- dropping to rescue shell\n")
            ling_kernel_vga_set_color(7, 0)
            run_shell()
        }
        ling_kernel_vga_write_str("disk erased (boot sectors + filesystem headers)\n")
    } else {
        ling_kernel_vga_write_str("not confirmed -- nothing written; dropping to rescue shell\n")
        run_shell()
    }

    bind fs_ok = installer_mount()
    if fs_ok == 1 {
        ling_kernel_vga_set_color(10, 0)
        ling_kernel_vga_write_str("disk volume mounted\n")
        ling_kernel_vga_set_color(7, 0)
        installer_save_locale(locale_idx)
        ling_kernel_fs_write("/language", ling_kernel_locale_id(lang_idx))
    } else {
        ling_kernel_vga_set_color(4, 0)
        ling_kernel_vga_write_str("disk volume mount FAILED -- cannot install\n")
        ling_kernel_vga_set_color(7, 0)
        run_shell()
    }

    if installer_is_first_run_done() == 0 {
        ling_kernel_vga_write_str("\nFirst-time setup -- this only runs once per disk.\n")

        ling_kernel_vga_write_str("\nStep 3/7 -- Hostname for this system: ")
        bind hn = ling_kernel_read_line()
        installer_save_hostname(hn)

        ling_kernel_vga_write_str("\nStep 4/7 -- Setting up network...\n")
        bind net_ok = installer_net_attempt()
        if net_ok == 1 {
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("network: adapter found, link up (internet reachability is a known open issue -- see the project backlog)\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            ling_kernel_vga_set_color(12, 0)
            ling_kernel_vga_write_str("network: no adapter found -- continuing offline\n")
            ling_kernel_vga_set_color(7, 0)
        }

        // SSH server: a real service now (drivers::services). Enabling it here
        // writes /services on the target -- the installed system starts sshd at
        // boot, and first boot won't re-ask (the file already exists).
        ling_kernel_vga_write_str("\nStart the SSH server at boot? (yes/no): ")
        bind ssh_ans = ling_kernel_read_line()
        if ssh_ans == "yes" {
            installer_set_ssh(1)
            ling_kernel_vga_set_color(10, 0)
            ling_kernel_vga_write_str("SSH server enabled at boot.\n")
            ling_kernel_vga_set_color(7, 0)
        } else {
            installer_set_ssh(0)
            ling_kernel_vga_write_str("SSH server left disabled (enable later in Settings).\n")
        }

        ling_kernel_vga_write_str("\nStep 5/7 -- Set a password for the root account\n")
        bind root_pw = ling_kernel_read_line_masked_confirmed()
        installer_create_root(root_pw)

        ling_kernel_vga_write_str("\nStep 6/7 -- Create a user account (username, blank to skip): ")
        bind user_name = ling_kernel_read_line()
        if len(user_name) != 0 {
            bind user_pw = ling_kernel_read_line_masked_confirmed()
            installer_create_user(user_name, user_pw)
        }

        // No real package catalog ships by default (no network registry
        // exists yet -- see packages/README.md's roadmap); this offers to
        // install one .lpkg blob already present in catalog/ on the
        // install media. One package per prompt, not a multi-select
        // checklist: this shell has no list/loop primitive to walk a
        // typed multi-name line with. Skipped entirely without a NIC, per
        // "without network we should just install the base system."
        // Package sets: curated ling-* bundles pulled from the public registry
        // (fu.ling-lang.org) into the target. Needs a NIC; the install progress
        // for each package prints below as it downloads + unpacks.
        if net_ok == 1 {
            ling_kernel_vga_write_str("\nStep 7/7 -- Package set to install from the registry (fu.ling-lang.org):\n")
            ling_kernel_vga_write_str("  1 None      base system only\n")
            ling_kernel_vga_write_str("  2 Minimal   ling-core\n")
            ling_kernel_vga_write_str("  3 Game      ling-core, ling-game, ling-graphics, ling-audio\n")
            ling_kernel_vga_write_str("  4 Crypto    ling-core, ling-crypto\n")
            ling_kernel_vga_write_str("  5 AI        ling-core, ling-ai\n")
            ling_kernel_vga_write_str("  6 Web       ling-core, ling-http, ling-graphics\n")
            ling_kernel_vga_write_str("  7 Custom    type one package name\n")
            ling_kernel_vga_write_str("Choose (1-7): ")
            bind pset = ling_kernel_read_line()
            if pset == "7" {
                ling_kernel_vga_write_str("Package name from the registry (blank to skip): ")
                bind cname = ling_kernel_read_line()
                if len(cname) != 0 {
                    installer_install_from_registry(cname)
                }
            } else if pset == "2" {
                installer_install_from_registry("ling-core")
            } else if pset == "3" {
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-game")
                installer_install_from_registry("ling-graphics")
                installer_install_from_registry("ling-audio")
            } else if pset == "4" {
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-crypto")
            } else if pset == "5" {
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-ai")
            } else if pset == "6" {
                installer_install_from_registry("ling-core")
                installer_install_from_registry("ling-http")
                installer_install_from_registry("ling-graphics")
            } else {
                ling_kernel_vga_write_str("No packages selected -- base system only.\n")
            }
        } else {
            ling_kernel_vga_write_str("\nStep 7/7 -- no network adapter: installing the base system only.\n")
        }

        ling_kernel_vga_set_color(10, 0)
        ling_kernel_vga_write_str("\nSetup saved to disk.\n")
        ling_kernel_vga_set_color(7, 0)
    } else {
        bind hn = installer_hostname()
        ling_kernel_vga_write_str("\nWelcome back, ")
        ling_kernel_print_lstr(hn)
        ling_kernel_vga_write_str(".\n")
    }

    bind boot_ok = installer_write_bootloader()
    if boot_ok == 0 {
        ling_kernel_vga_set_color(4, 0)
        ling_kernel_vga_write_str("\nNo boot payload module found -- this disk will NOT boot\n")
        ling_kernel_vga_write_str("standalone (use 'Live' or 'Install' from the CD to get back in).\n\n")
        ling_kernel_vga_set_color(7, 0)
    } else {
        ling_kernel_vga_set_color(10, 0)
        ling_kernel_vga_write_str("\nBootloader installed -- this disk can now boot standalone.\n")
        ling_kernel_vga_write_str("You can remove the Live CD and reboot.\n\n")
        ling_kernel_vga_set_color(7, 0)
    }
    ling_kernel_vga_write_str("type 'help' for commands\n\n")

    run_shell()
}
